    border-radius: var(--radius-lg);
    padding: 1.25rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .role-stat-card:hover {
    transform: translateY(-2px);
  }

  .role-stat-card.admin-stat {
    border-color: rgba(212, 175, 55, 0.4);
    background: rgba(212, 175, 55, 0.08);
  }

  .role-stat-card.poles-stat {
    border-color: rgba(0, 150, 255, 0.4);
    background: rgba(0, 150, 255, 0.08);
  }

  .role-stat-card.vip-stat {
    border-color: rgba(168, 85, 247, 0.4);
    background: rgba(168, 85, 247, 0.08);
  }

  .role-stat-card.clients-stat {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.08);
  }

  .role-stat-card .stat-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .role-stat-card .stat-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .role-stat-card .stat-count {
    font-size: 1.65rem;
    font-family: var(--font-serif);
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }

  .role-stat-card .stat-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--gold-300);
    margin-top: 0.2rem;
  }

  .role-stat-card .stat-sub {
    font-size: 0.72rem;
    color: var(--ivory-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Formulaire d'attribution */
  .role-assign-box {
    background: rgba(10, 24, 46, 0.8);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: var(--radius-xl);
    padding: 1.75rem 2rem;
    margin-bottom: 2.25rem;
  }

  .assign-box-header {
    margin-bottom: 1.25rem;
  }

  .assign-box-title {
    font-size: 1.15rem;
    color: var(--gold-300);
    margin: 0;
  }

  .assign-box-subtitle {
    font-size: 0.82rem;
    color: var(--ivory-muted);
    margin-top: 0.25rem;
  }

  .poles-checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .pole-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(14, 32, 60, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    padding: 0.45rem 0.75rem;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pole-checkbox-label:hover {
    border-color: var(--gold-400);
    background: rgba(22, 50, 90, 0.85);
  }

  .assign-actions-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .role-feedback-msg {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .role-feedback-msg.success {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    color: #4ade80;
  }

  .role-feedback-msg.error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  /* Roles Table */
  .roles-table-container {
    background: rgba(8, 20, 40, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    overflow: hidden;
  }

  .table-filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .filter-search-box {
    flex: 1;
    min-width: 240px;
  }

  .filter-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(14, 32, 60, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--ivory-muted);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    border-color: var(--gold-400);
    color: #ffffff;
  }

  .filter-pill.active {
    background: var(--gold-500);
    color: #060e1a;
    border-color: var(--gold-400);
    font-weight: 800;
  }

  .adm-users-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .adm-users-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    color: var(--gold-300);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
  }

  .adm-users-table td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    vertical-align: middle;
  }

  .user-row-cell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .user-row-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid rgba(212, 175, 55, 0.5);
  }

  .user-row-placeholder {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(212, 175, 55, 0.2);
    color: var(--gold-300);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
  }

  .user-row-texts {
    display: flex;
    flex-direction: column;
  }

  .user-row-email {
    font-size: 0.75rem;
    color: var(--ivory-muted);
  }

  .quick-role-select {
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-md);
    background: rgba(14, 32, 60, 0.9);
    border: 1px solid rgba(212, 175, 55, 0.4);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .quick-role-select:focus {
    outline: none;
    border-color: var(--gold-400);
  }

  .pole-pill-all {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: var(--gold-300);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .pole-pill {
    display: inline-block;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 150, 255, 0.15);
    border: 1px solid rgba(0, 150, 255, 0.35);
    color: #60a5fa;
    font-size: 0.7rem;
    font-weight: 600;
    margin: 2px;
  }

  .user-row-notes {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .note-text {
    font-size: 0.78rem;
    color: var(--ivory-muted);
  }

  .source-tag {
    display: inline-block;
    align-self: flex-start;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .source-tag.env {
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .source-tag.db {
    background: rgba(34, 197, 94, 0.2);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.4);
  }

  .source-tag.clerk {
    background: rgba(99, 102, 241, 0.2);
    color: #818cf8;
    border: 1px solid rgba(99, 102, 241, 0.4);
  }

  .user-row-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .btn-user-action {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-user-action:hover {
    background: rgba(212, 175, 55, 0.2);
    border-color: var(--gold-400);
  }

  .auth-hint {
    margin-top: 1.5rem;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1rem;
  }

  .section-card-head {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1.8rem;
  }

  .badge-num {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--navy-950);
    background: var(--gold-gradient);
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Accordion styling for Section 2 (5 Pôles) */
  .accordion-toggle-head {
    cursor: pointer;
    user-select: none;
    transition: background 0.2s ease;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-radius: 12px;
    background: rgba(14, 34, 64, 0.7);
  }

  .accordion-toggle-head:hover {
    background: rgba(20, 46, 84, 0.9);
  }

  .accordion-arrow {
    color: var(--gold-400);
    font-size: 0.9rem;
    transition: transform 0.25s ease;
    margin-left: auto;
  }

  .accordion-toggle-head.expanded .accordion-arrow {
    transform: rotate(180deg);
  }

  .accordion-body.folded {
    display: none;
  }

  .accordion-body {
    padding: 1.2rem 0 0.5rem 0;
    animation: fadeInAccordion 0.25s ease;
  }

  @keyframes fadeInAccordion {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .image-uploader-control {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .image-uploader-inputs {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .file-pick-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .file-btn-label {
    cursor: pointer;
  }

  .file-upload-status {
    font-size: 0.78rem;
    color: var(--ivory-muted);
  }

  /* Section 3: Seasonal Products Compact (150px) & 100% Full-Width Expansion */
  .seasonal-prods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .prod-admin-card {
    background: rgba(14, 32, 60, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .prod-admin-card:hover {
    border-color: var(--gold-400);
    background: rgba(20, 46, 84, 0.75);
  }

  .prod-admin-card.expanded {
    grid-column: 1 / -1;
    flex-direction: row;
    padding: 1.4rem;
    border-color: var(--gold-400);
    background: rgba(10, 26, 52, 0.95);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 175, 55, 0.2);
    cursor: default;
  }

  .prod-admin-media {
    width: 100%;
    height: 100px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid rgba(212, 175, 55, 0.3);
  }

  .prod-admin-card.expanded .prod-admin-media {
    width: 140px;
    height: 140px;
  }

  .prod-admin-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prod-admin-form {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .prod-admin-compact-preview {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .prod-compact-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .prod-compact-price {
    font-size: 0.8rem;
    color: var(--gold-300);
    font-weight: 700;
  }

  .prod-admin-card:not(.expanded) .prod-admin-full-fields {
    display: none;
  }

  .prod-row-1, .prod-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .prod-row-2 {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .prod-row-del {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.4rem;
  }

  .btn-collapse-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--ivory-muted);
    font-size: 0.76rem;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .btn-del-prod {
    background: none;
    border: none;
    color: #f87171;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.2rem 0;
  }

  .btn-del-prod:hover {
    text-decoration: underline;
  }

  /* Section 4: Pricing Packages (Desktop 3 col / Mobile 2 col & 100% Expansion) */
  .pricing-pkgs-stack {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .pricing-pkgs-stack {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .pricing-pkgs-stack {
      grid-template-columns: 1fr;
    }
  }

  .pkg-admin-card {
    background: rgba(14, 32, 60, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .pkg-admin-card:hover {
    border-color: var(--gold-400);
    background: rgba(20, 46, 84, 0.75);
  }

  .pkg-admin-card.expanded {
    grid-column: 1 / -1;
    border-color: var(--gold-400);
    background: rgba(10, 26, 52, 0.95);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 175, 55, 0.2);
    cursor: default;
  }

  .pkg-admin-card:not(.expanded) .pkg-admin-features-box,
  .pkg-admin-card:not(.expanded) .pkg-admin-bottom {
    display: none;
  }

  .pkg-admin-row-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .pkg-admin-card.expanded .pkg-admin-row-top {
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
  }

  .pkg-admin-features-box label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #cbd5e1;
    display: block;
    margin-bottom: 0.3rem;
  }

  .adm-textarea {
    width: 100%;
    resize: vertical;
  }

  .pkg-admin-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--ivory-muted);
    cursor: pointer;
  }

  /* Section 5: Boutique E-Commerce (Desktop 4 col / Mobile 2 col & Expansion) */
  .boutique-admin-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
    align-items: start;
  }

  @media (max-width: 992px) {
    .boutique-admin-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 680px) {
    .boutique-admin-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }

  .btq-admin-card {
    background: rgba(14, 32, 60, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btq-admin-card:hover {
    border-color: var(--gold-400);
    background: rgba(20, 46, 84, 0.75);
  }

  /* Expanded: half-width (span 2) on desktop, full-width on mobile */
  .btq-admin-card.expanded {
    grid-column: span 2;
    border-color: var(--gold-400);
    background: rgba(10, 26, 52, 0.95);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 175, 55, 0.2);
    cursor: default;
  }

  @media (max-width: 680px) {
    .btq-admin-card.expanded {
      grid-column: 1 / -1;
    }
  }

  .btq-admin-card:not(.expanded) .btq-admin-fields,
  .btq-admin-card:not(.expanded) .btq-admin-footer {
    display: none;
  }

  .btq-admin-top {
    display: flex;
    gap: 0.8rem;
  }

  .card-sec-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    font-family: var(--font-serif);
  }

  .card-sec-desc {
    font-size: 0.84rem;
    color: var(--ivory-muted);
    margin-top: 0.2rem;
  }

  /* Fields Grid */
  .form-fields-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  @media (max-width: 640px) {
    .form-fields-grid {
      grid-template-columns: 1fr;
    }
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .field-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-item label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  .adm-input, .adm-select, .adm-textarea {
    background: rgba(6, 14, 26, 0.85);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: #ffffff;
    padding: 0.7rem 0.95rem;
    border-radius: 10px;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .adm-input:focus, .adm-select:focus, .adm-textarea:focus {
    border-color: var(--gold-400);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
  }

  .field-hint {
    font-size: 0.72rem;
    color: var(--gold-400);
    margin-top: 0.2rem;
  }

  /* Image Picker */
  .image-picker-row {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .image-thumb-preview {
    width: 60px;
    height: 42px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.4);
    flex-shrink: 0;
  }

  .svc-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Service Editors */
  .services-admin-stack {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .service-editor-card {
    background: rgba(10, 24, 46, 0.65);
    border: 1px solid rgba(212, 175, 55, 0.22);
    border-radius: 16px;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .svc-editor-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .svc-index {
    color: var(--gold-400);
    font-weight: 800;
    font-size: 1rem;
  }

  .svc-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    flex: 1;
  }

  .svc-badge-tag {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: var(--gold-300);
  }

  .items-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .btn-add-item {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    color: #4ade80;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .btn-add-item:hover {
    background: #22c55e;
    color: #ffffff;
  }

  .svc-items-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .svc-item-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .bullet-dot {
    color: var(--gold-400);
    font-weight: 800;
    font-size: 1.1rem;
  }

  .svc-item-input {
    flex: 1;
    padding: 0.45rem 0.75rem;
    font-size: 0.85rem;
  }

  .btn-del-item {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .btn-del-item:hover {
    background: #ef4444;
    color: #ffffff;
  }

  /* Explanatory Box */
  .explanation-box {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 14px;
    padding: 1.1rem 1.4rem;
    margin-bottom: 1.8rem;
  }

  .expl-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .expl-content strong {
    color: #ffffff;
    font-size: 0.95rem;
    display: block;
    margin-bottom: 0.3rem;
  }

  .expl-content p {
    font-size: 0.84rem;
    color: var(--ivory-muted);
    line-height: 1.5;
  }

  /* Products Manager */
  .products-manager-box {
    margin-top: 2rem;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .manager-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.4rem;
  }

  .manager-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .manager-sub {
    font-size: 0.78rem;
    color: var(--ivory-muted);
  }

  /* Sticky Bottom Bar */
  .admin-sticky-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(6, 14, 26, 0.95);
    border-top: 1px solid var(--gold-500);
    backdrop-filter: blur(14px);
    padding: 1rem 0;
    z-index: 999;
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.7);
  }

  .bottom-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .bar-notice {
    font-size: 0.86rem;
    color: var(--ivory-muted);
  }

  .btn-save-big {
    padding: 0.8rem 1.8rem;
    font-size: 1rem;
  }
</style>

<script>
  function setupAdminPage() {
    const form = document.getElementById('global-admin-form') as HTMLFormElement;
    const topSaveBtn = document.getElementById('admin-page-save-btn');
    const exportBtn = document.getElementById('sidebar-export-btn');
    const importInput = document.getElementById('sidebar-import-input') as HTMLInputElement;
    const resetBtn = document.getElementById('sidebar-reset-btn');

    // Load saved data from localStorage into the form inputs
    function loadSavedAdminData() {
      const stored = localStorage.getItem('bcps_site_data');
      if (!stored) return;
      try {
        const data = JSON.parse(stored);
        if (data.name) (document.getElementById('adm-name') as HTMLInputElement).value = data.name;
        if (data.phoneFormatted) (document.getElementById('adm-phone') as HTMLInputElement).value = data.phoneFormatted;
        if (data.whatsappFormatted) (document.getElementById('adm-whatsapp') as HTMLInputElement).value = data.whatsappFormatted;
        if (data.whatsappPreFilled) (document.getElementById('adm-whatsapp-msg') as HTMLInputElement).value = data.whatsappPreFilled;
        if (data.address) (document.getElementById('adm-address') as HTMLInputElement).value = data.address;
        if (data.openingHours) (document.getElementById('adm-hours') as HTMLInputElement).value = data.openingHours;
        if (data.scheduleNote) (document.getElementById('adm-schedule-note') as HTMLInputElement).value = data.scheduleNote;
        if (data.announcementBadge) (document.getElementById('adm-ann-badge') as HTMLInputElement).value = data.announcementBadge;
        if (data.announcementText) (document.getElementById('adm-ann-text') as HTMLInputElement).value = data.announcementText;

        if (data.seasonSelect) (document.getElementById('adm-season-select') as HTMLSelectElement).value = data.seasonSelect;
        if (data.seasonTitle) (document.getElementById('adm-season-title') as HTMLInputElement).value = data.seasonTitle;
        if (data.seasonSubtitle) (document.getElementById('adm-season-sub') as HTMLInputElement).value = data.seasonSubtitle;

        if (data.wavePhone) (document.getElementById('adm-wave-phone') as HTMLInputElement).value = data.wavePhone;
        if (data.waveAmount) (document.getElementById('adm-wave-amount') as HTMLInputElement).value = data.waveAmount;
        if (data.waveBanks) (document.getElementById('adm-wave-banks') as HTMLInputElement).value = data.waveBanks;

        // Custom services background and items
        if (data.servicesCustom) {
          data.servicesCustom.forEach((customSvc: any) => {
            const card = document.querySelector(`[data-service-id="${customSvc.id}"]`);
            if (card) {
              const imgInput = card.querySelector('.svc-image-input') as HTMLInputElement;
              const titleInput = card.querySelector('.svc-title-input') as HTMLInputElement;
              const subInput = card.querySelector('.svc-subtitle-input') as HTMLInputElement;
              const thumbImg = card.querySelector('.svc-thumb-img') as HTMLImageElement;
              if (imgInput && customSvc.image) {
                imgInput.value = customSvc.image;
                if (thumbImg) thumbImg.src = customSvc.image;
              }
              if (titleInput && customSvc.title) titleInput.value = customSvc.title;
              if (subInput && customSvc.subtitle) subInput.value = customSvc.subtitle;

              // Items list
              if (customSvc.items && customSvc.items.length) {
                const container = card.querySelector('.svc-items-container');
                if (container) {
                  container.innerHTML = '';
                  customSvc.items.forEach((itemText: string) => {
                    const row = document.createElement('div');
                    row.className = 'svc-item-row';
                    row.innerHTML = `
                      <span class="bullet-dot">›</span>
                      <input type="text" class="adm-input svc-item-input" value="${itemText}" />
                      <button type="button" class="btn-del-item del-svc-item-btn" title="Supprimer cette prestation">🗑️</button>
                    `;
                    container.appendChild(row);
                  });
                }
              }
            }
          });
        }
      } catch(e) {
        console.error('Error loading saved admin data', e);
      }
    }

    loadSavedAdminData();

    // Live image URL preview
    document.querySelectorAll('.svc-image-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const card = (e.target as HTMLElement).closest('.service-editor-card');
        const thumb = card?.querySelector('.svc-thumb-img') as HTMLImageElement;
        if (thumb) thumb.src = val;
      });
    });

    // Section 2: Accordion toggle for the 5 Pillars
    document.querySelectorAll('.accordion-toggle-head').forEach(head => {
      head.addEventListener('click', () => {
        const card = head.closest('.service-editor-card');
        const body = card?.querySelector('.accordion-body') as HTMLElement | null;
        if (body) {
          const isFolded = body.classList.contains('folded');
          if (isFolded) {
            body.classList.remove('folded');
            head.classList.add('expanded');
          } else {
            body.classList.add('folded');
            head.classList.remove('expanded');
          }
        }
      });
    });

    // Section 2: Interactive Cloudinary Upload for Service Backgrounds
    document.querySelectorAll('.svc-file-upload-input').forEach(inputEl => {
      inputEl.addEventListener('change', async (e) => {
        const file = (inputEl as HTMLInputElement).files?.[0];
        if (!file) return;

        const card = inputEl.closest('.service-editor-card');
        const statusSpan = card?.querySelector('.file-upload-status') as HTMLElement | null;
        const thumbImg = card?.querySelector('.svc-thumb-img') as HTMLImageElement | null;
        const imgInput = card?.querySelector('.svc-image-input') as HTMLInputElement | null;

        if (statusSpan) {
          statusSpan.textContent = '⏳ Téléversement vers Cloudinary...';
          statusSpan.style.color = 'var(--gold-400)';
        }

        try {
          const formData = new FormData();
          formData.append('file', file);
          formData.append('serviceType', 'pôle_background');
          formData.append('customerName', 'Admin Studio Super U');

          const res = await fetch('/api/upload/photo', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();

          if (data.success && data.secureUrl) {
            if (imgInput) imgInput.value = data.secureUrl;
            if (thumbImg) thumbImg.src = data.secureUrl;
            if (statusSpan) {
              statusSpan.textContent = '✅ Image téléversée sur Cloudinary !';
              statusSpan.style.color = '#4ade80';
            }
          } else {
            if (statusSpan) {
              statusSpan.textContent = '❌ Erreur : ' + (data.error || 'Échec');
              statusSpan.style.color = '#f87171';
            }
          }
        } catch (err: any) {
          if (statusSpan) {
            statusSpan.textContent = '❌ Erreur réseau lors du transfert';
            statusSpan.style.color = '#f87171';
          }
        }
      });
    });

    // Card In-Place Expansion / Collapse for Sections 3, 4, 5
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Click on collapse button
      const collapseBtn = target.closest('.btn-collapse-card');
      if (collapseBtn) {
        e.stopPropagation();
        const card = collapseBtn.closest('.prod-admin-card, .pkg-admin-card, .btq-admin-card');
        card?.classList.remove('expanded');
        return;
      }

      // If clicked inside inputs, buttons, selects, or labels of an already expanded card, do not collapse
      if (target.closest('input, textarea, select, button, a, label')) {
        return;
      }

      // Click on a card to expand it
      const card = target.closest('.prod-admin-card, .pkg-admin-card, .btq-admin-card') as HTMLElement | null;
      if (card) {
        if (!card.classList.contains('expanded')) {
          // Collapse sibling cards in the same container
          const container = card.parentElement;
          container?.querySelectorAll('.prod-admin-card.expanded, .pkg-admin-card.expanded, .btq-admin-card.expanded').forEach(sibling => {
            sibling.classList.remove('expanded');
          });
          card.classList.add('expanded');
        }
      }
    });

    // Delete items in cards
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('del-svc-item-btn')) {
        const row = target.closest('.svc-item-row');
        row?.remove();
      }

      if (target.classList.contains('del-seasonal-prod-btn')) {
        const card = target.closest('.prod-admin-card');
        card?.remove();
      }

      if (target.classList.contains('del-pricing-pkg-btn')) {
        const card = target.closest('.pkg-admin-card');
        card?.remove();
      }

      if (target.classList.contains('del-btq-prod-btn')) {
        const card = target.closest('.btq-admin-card');
        card?.remove();
      }
    });

    // Add service item in Section 2
    document.querySelectorAll('.add-svc-item-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.service-editor-card');
        const container = card?.querySelector('.svc-items-container');
        if (container) {
          const row = document.createElement('div');
          row.className = 'svc-item-row';
          row.innerHTML = `
            <span class="bullet-dot">›</span>
            <input type="text" class="adm-input svc-item-input" value="Nouvelle prestation..." />
            <button type="button" class="btn-del-item del-svc-item-btn" title="Supprimer cette prestation">🗑️</button>
          `;
          container.appendChild(row);
        }
      });
    });

    // Add seasonal product (Section 3: Compact 150px with in-place expansion)
    document.getElementById('btn-add-seasonal-prod')?.addEventListener('click', () => {
      const list = document.getElementById('seasonal-prods-admin-list');
      if (!list) return;

      // Collapse existing expanded cards
      list.querySelectorAll('.prod-admin-card.expanded').forEach(c => c.classList.remove('expanded'));

      const id = 'prod-' + Date.now();
      const div = document.createElement('div');
      div.className = 'prod-admin-card expanded';
      div.setAttribute('data-prod-id', id);
      div.innerHTML = `
        <div class="prod-admin-media">
          <img src="/images/boutique-gifts.jpg" alt="Nouveau produit" class="prod-admin-img" />
        </div>
        <div class="prod-admin-form">
          <div class="prod-admin-compact-preview">
            <span class="prod-compact-name">Nouveau Produit Saisonnier</span>
            <span class="prod-compact-price">10 000 FCFA</span>
            <span class="field-hint" style="font-size:0.7rem; color:var(--gold-400);">👆 Cliquer pour modifier</span>
          </div>
          <div class="prod-admin-full-fields">
            <div class="prod-row-1">
              <input type="text" class="adm-input prod-name-input" value="Nouveau Produit Saisonnier" placeholder="Nom du produit" />
              <select class="adm-select prod-season-select">
                <option value="rentree">Rentrée Scolaire</option>
                <option value="noel">Fêtes & Noël</option>
                <option value="mariages">Cérémonies & Mariages</option>
                <option value="hightech">High-Tech & Gaming</option>
              </select>
            </div>
            <div class="prod-row-2">
              <input type="number" class="adm-input prod-price-input" value="10000" placeholder="Prix FCFA" />
              <input type="text" class="adm-input prod-badge-input" value="Nouveauté" placeholder="Badge promo" />
              <input type="text" class="adm-input prod-img-input" value="/images/boutique-gifts.jpg" placeholder="URL Image" />
            </div>
            <input type="text" class="adm-input prod-desc-input" value="Description courte du produit..." placeholder="Courte description" />
            <div class="prod-row-del">
              <button type="button" class="btn-collapse-card">▲ Réduire</button>
              <button type="button" class="btn-del-prod del-seasonal-prod-btn">🗑️ Supprimer ce produit</button>
            </div>
          </div>
        </div>
      `;
      list.prepend(div);

      div.querySelector('.prod-name-input')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const nameSpan = div.querySelector('.prod-compact-name');
        if (nameSpan) nameSpan.textContent = val || 'Nouveau Produit';
      });

      div.querySelector('.prod-img-input')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const img = div.querySelector('.prod-admin-img') as HTMLImageElement;
        if (img) img.src = val;
      });
    });

    // Add pricing package (Section 4: 3 cols desktop / 2 mobile with 100% expansion)
    document.getElementById('btn-add-pricing-pkg')?.addEventListener('click', () => {
      const list = document.getElementById('pricing-pkgs-admin-list');
      if (!list) return;

      list.querySelectorAll('.pkg-admin-card.expanded').forEach(c => c.classList.remove('expanded'));

      const id = 'pkg-' + Date.now();
      const div = document.createElement('div');
      div.className = 'pkg-admin-card expanded';
      div.setAttribute('data-pkg-id', id);
      div.innerHTML = `
        <div class="pkg-admin-row-top">
          <input type="text" class="adm-input pkg-title-input" value="Nouvelle Formule" placeholder="Titre de la formule" />
          <input type="text" class="adm-input pkg-cat-input" value="Prestation" placeholder="Catégorie" />
          <input type="text" class="adm-input pkg-price-input" value="10 000 FCFA" placeholder="Prix" />
          <input type="text" class="adm-input pkg-period-input" value="la séance" placeholder="Période" />
        </div>
        <div class="pkg-admin-features-box">
          <label>Caractéristiques incluses</label>
          <textarea class="adm-textarea pkg-features-input" rows="3" placeholder="Une caractéristique par ligne">Caractéristique 1\nCaractéristique 2</textarea>
        </div>
        <div class="pkg-admin-bottom">
          <label class="checkbox-label">
            <input type="checkbox" class="pkg-popular-checkbox" />
            <span>Formule la plus populaire (Mise en avant or)</span>
          </label>
          <div style="display:flex; gap:0.6rem; align-items:center;">
            <button type="button" class="btn-collapse-card">▲ Réduire</button>
            <button type="button" class="btn-del-prod del-pricing-pkg-btn">🗑️ Supprimer cette formule</button>
          </div>
        </div>
      `;
      list.prepend(div);
    });

    // Add boutique article (Section 5: 4 cols desktop / 2 mobile with in-place expansion)
    document.getElementById('btn-add-boutique-prod')?.addEventListener('click', () => {
      const list = document.getElementById('boutique-admin-list');
      if (!list) return;

      list.querySelectorAll('.btq-admin-card.expanded').forEach(c => c.classList.remove('expanded'));

      const id = 'btq-' + Date.now();
      const div = document.createElement('div');
      div.className = 'btq-admin-card expanded';
      div.setAttribute('data-btq-id', id);
      div.innerHTML = `
        <div class="btq-admin-top">
          <img src="/images/hero-store.jpg" alt="Article" class="btq-admin-thumb" />
          <div class="btq-admin-main-inputs">
            <input type="text" class="adm-input btq-name-input" value="Nouvel Article en Boutique" placeholder="Nom de l'article" />
            <div class="btq-row-price-cat">
              <input type="number" class="adm-input btq-price-input" value="15000" placeholder="Prix FCFA" />
              <select class="adm-select btq-cat-select">
                <option value="gaming">Gaming & Consoles</option>
                <option value="accessoires">High-Tech & Câbles</option>
                <option value="maroquinerie">Sacs & Cuir</option>
                <option value="montres">Montres & Bijoux</option>
                <option value="cadeaux">Cadeaux & Divers</option>
              </select>
            </div>
          </div>
        </div>
        <div class="btq-admin-fields">
          <input type="text" class="adm-input btq-badge-input" value="Disponible" placeholder="Badge" />
          <input type="text" class="adm-input btq-img-input" value="/images/hero-store.jpg" placeholder="URL Image" />
          <textarea class="adm-textarea btq-desc-input" rows="2" placeholder="Description de l'article">Description de l'article disponible au magasin...</textarea>
        </div>
        <div class="btq-admin-footer">
          <label class="checkbox-label">
            <input type="checkbox" class="btq-stock-checkbox" checked />
            <span>Article en stock au Super U</span>
          </label>
          <div style="display:flex; gap:0.6rem; align-items:center;">
            <button type="button" class="btn-collapse-card">▲ Réduire</button>
            <button type="button" class="btn-del-prod del-btq-prod-btn">🗑️ Supprimer</button>
          </div>
        </div>
      `;
      list.prepend(div);

      div.querySelector('.btq-img-input')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const img = div.querySelector('.btq-admin-thumb') as HTMLImageElement;
        if (img) img.src = val;
      });
    });

    // Save all form data
    async function saveAllAdminData() {
      const name = (document.getElementById('adm-name') as HTMLInputElement).value;
      const phoneFormatted = (document.getElementById('adm-phone') as HTMLInputElement).value;
      const whatsappFormatted = (document.getElementById('adm-whatsapp') as HTMLInputElement).value;
      const whatsappPreFilled = (document.getElementById('adm-whatsapp-msg') as HTMLInputElement).value;
      const address = (document.getElementById('adm-address') as HTMLInputElement).value;
      const openingHours = (document.getElementById('adm-hours') as HTMLInputElement).value;
      const scheduleNote = (document.getElementById('adm-schedule-note') as HTMLInputElement).value;
      const announcementBadge = (document.getElementById('adm-ann-badge') as HTMLInputElement).value;
      const announcementText = (document.getElementById('adm-ann-text') as HTMLInputElement).value;

      const seasonSelect = (document.getElementById('adm-season-select') as HTMLSelectElement).value;
      const seasonTitle = (document.getElementById('adm-season-title') as HTMLInputElement).value;
      const seasonSubtitle = (document.getElementById('adm-season-sub') as HTMLInputElement).value;

      const wavePhone = (document.getElementById('adm-wave-phone') as HTMLInputElement).value;
      const waveAmount = (document.getElementById('adm-wave-amount') as HTMLInputElement).value;
      const waveBanks = (document.getElementById('adm-wave-banks') as HTMLInputElement).value;

      // Extract 5 Services data
      const servicesCustom: any[] = [];
      document.querySelectorAll('.service-editor-card').forEach(card => {
        const id = card.getAttribute('data-service-id') || '';
        const title = (card.querySelector('.svc-title-input') as HTMLInputElement)?.value || '';
        const subtitle = (card.querySelector('.svc-subtitle-input') as HTMLInputElement)?.value || '';
        const badge = (card.querySelector('.svc-badge-input') as HTMLInputElement)?.value || '';
        const popularTag = (card.querySelector('.svc-popular-input') as HTMLInputElement)?.value || '';
        const image = (card.querySelector('.svc-image-input') as HTMLInputElement)?.value || '';

        const items: string[] = [];
        card.querySelectorAll('.svc-item-input').forEach(inp => {
          const val = (inp as HTMLInputElement).value.trim();
          if (val) items.push(val);
        });

        servicesCustom.push({
          id,
          title,
          subtitle,
          badge,
          popularTag,
          image,
          items
        });
      });

      // Extract Seasonal Products
      const seasonalProductsCustom: any[] = [];
      document.querySelectorAll('.prod-admin-card').forEach(card => {
        const id = card.getAttribute('data-prod-id') || '';
        const name = (card.querySelector('.prod-name-input') as HTMLInputElement)?.value || '';
        const seasonId = (card.querySelector('.prod-season-select') as HTMLSelectElement)?.value || 'rentree';
        const price = parseInt((card.querySelector('.prod-price-input') as HTMLInputElement)?.value || '0', 10);
        const badge = (card.querySelector('.prod-badge-input') as HTMLInputElement)?.value || '';
        const image = (card.querySelector('.prod-img-input') as HTMLInputElement)?.value || '';
        const description = (card.querySelector('.prod-desc-input') as HTMLInputElement)?.value || '';

        seasonalProductsCustom.push({
          id,
          name,
          seasonId,
          price,
          badge,
          image,
          description
        });
      });

      // Extract Pricing Packages
      const pricingPackagesCustom: any[] = [];
      document.querySelectorAll('.pkg-admin-card').forEach(card => {
        const id = card.getAttribute('data-pkg-id') || '';
        const title = (card.querySelector('.pkg-title-input') as HTMLInputElement)?.value || '';
        const category = (card.querySelector('.pkg-cat-input') as HTMLInputElement)?.value || '';
        const price = (card.querySelector('.pkg-price-input') as HTMLInputElement)?.value || '';
        const period = (card.querySelector('.pkg-period-input') as HTMLInputElement)?.value || '';
        const popular = (card.querySelector('.pkg-popular-checkbox') as HTMLInputElement)?.checked || false;
        const featuresRaw = (card.querySelector('.pkg-features-input') as HTMLTextAreaElement)?.value || '';
        const features = featuresRaw.split('\n').map(s => s.trim()).filter(Boolean);

        pricingPackagesCustom.push({
          id,
          title,
          category,
          price,
          period,
          popular,
          features
        });
      });

      // Extract Boutique Products
      const boutiqueProductsCustom: any[] = [];
      document.querySelectorAll('.btq-admin-card').forEach(card => {
        const id = card.getAttribute('data-btq-id') || '';
        const name = (card.querySelector('.btq-name-input') as HTMLInputElement)?.value || '';
        const category = (card.querySelector('.btq-cat-select') as HTMLSelectElement)?.value || 'gaming';
        const price = parseInt((card.querySelector('.btq-price-input') as HTMLInputElement)?.value || '0', 10);
        const badge = (card.querySelector('.btq-badge-input') as HTMLInputElement)?.value || '';
        const image = (card.querySelector('.btq-img-input') as HTMLInputElement)?.value || '';
        const description = (card.querySelector('.btq-desc-input') as HTMLTextAreaElement)?.value || '';
        const inStock = (card.querySelector('.btq-stock-checkbox') as HTMLInputElement)?.checked || false;

        boutiqueProductsCustom.push({
          id,
          name,
          category,
          price,
          badge,
          image,
          description,
          inStock
        });
      });

      // Extract Yango Delivery Tiers
      const yangoTiersCustom: any[] = [];
      document.querySelectorAll('.yango-tier-card').forEach(card => {
        const id = card.getAttribute('data-tier-id') || `tier-${Date.now()}`;
        const zone = (card.querySelector('.tier-zone-input') as HTMLInputElement)?.value || '';

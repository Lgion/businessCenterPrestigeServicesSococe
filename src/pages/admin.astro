---
import Layout from '../layouts/Layout.astro';
import { defaultSiteData } from '../data/siteData';
import { getAssetPath } from '../utils/assets';

const { business, services, seasonalShowcase, pricingPackages, boutiqueProducts, wavePayment, announcement } = defaultSiteData;
---

<Layout title="Administration | Business Center Prestige Services">
  <div class="admin-page-container">
    <!-- Top Global Header -->
    <header class="admin-topbar">
      <div class="container admin-topbar-inner">
        <div class="admin-brand">
          <a href={getAssetPath('/')} class="admin-logo-link" title="Retourner au site vitrine">
            <div class="admin-crest">
              <svg viewBox="0 0 44 44" fill="none" class="crest-svg" xmlns="http://www.w3.org/2000/svg">
                <rect width="44" height="44" rx="10" fill="#0E223F"/>
                <rect x="1.5" y="1.5" width="41" height="41" rx="8.5" stroke="#D4AF37" stroke-width="1.5"/>
                <text x="22" y="28" font-family="serif" font-weight="800" font-size="14" fill="#D4AF37" text-anchor="middle">BCPS</text>
              </svg>
            </div>
            <div>
              <h1 class="admin-heading">Console d'Administration Globale</h1>
              <p class="admin-tag">Business Center Prestige Services • Super U Deux Plateaux</p>
            </div>
          </a>
        </div>

        <div class="admin-topbar-actions">
          <a href="/" class="btn btn-navy-outline btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span>Voir le Site en Direct</span>
          </a>

          <button type="button" id="admin-page-save-btn" class="btn btn-gold btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span>Enregistrer les Modifications</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Admin Workspace Layout -->
    <div class="container admin-main-layout">
      <!-- Left Navigation Menu -->
      <aside class="admin-nav-sidebar">
        <div class="sidebar-sticky-box">
          <span class="sidebar-title">Sections du Site</span>
          <nav class="sidebar-menu">
            <a href="#sec-general" class="sidebar-link active">
              <span class="link-icon">🏛️</span>
              <span>1. Informations Générales</span>
            </a>
            <a href="#sec-services" class="sidebar-link">
              <span class="link-icon">🌟</span>
              <span>2. Les 5 Pôles & Fonds</span>
            </a>
            <a href="#sec-seasons" class="sidebar-link">
              <span class="link-icon">🎪</span>
              <span>3. Vitrine Événementielle</span>
            </a>
            <a href="#sec-pricing" class="sidebar-link">
              <span class="link-icon">🏷️</span>
              <span>4. Tarifs & Formules</span>
            </a>
            <a href="#sec-boutique" class="sidebar-link">
              <span class="link-icon">🛍️</span>
              <span>5. Boutique E-Commerce</span>
            </a>
            <a href="#sec-wave" class="sidebar-link">
              <span class="link-icon">💙</span>
              <span>6. Paramètres Wave</span>
            </a>
          </nav>

          <div class="sidebar-tools-box">
            <span class="sidebar-sub-title">Outils de Données</span>
            <button type="button" id="sidebar-export-btn" class="sidebar-tool-btn">
              📥 Exporter la configuration JSON
            </button>
            <label for="sidebar-import-input" class="sidebar-tool-btn import-btn">
              📤 Importer un fichier JSON
            </label>
            <input type="file" id="sidebar-import-input" accept=".json" style="display: none;" />
            <button type="button" id="sidebar-reset-btn" class="sidebar-reset-btn">
              🔄 Réinitialiser aux valeurs initiales
            </button>
          </div>
        </div>
      </aside>

      <!-- Right Form Sections Area -->
      <main class="admin-content-area">
        <form id="global-admin-form" class="global-admin-form">

          <!-- ================= SECTION 1: GENERAL INFO ================= -->
          <section id="sec-general" class="admin-card-section prestige-card">
            <div class="section-card-head">
              <div class="badge-num">01</div>
              <div>
                <h2 class="card-sec-title">Informations Générales, En-tête & Coordonnées</h2>
                <p class="card-sec-desc">Nom officiel, localisation Super U, contacts téléphoniques et bannière d'annonce.</p>
              </div>
            </div>

            <div class="form-fields-grid">
              <div class="field-item full-width">
                <label for="adm-name">Nom Officiel du Commerce</label>
                <input type="text" id="adm-name" class="adm-input" value={business.name} />
              </div>

              <div class="field-item">
                <label for="adm-phone">Téléphone Appel Direct (ex: +225 07 89 08 30 85)</label>
                <input type="text" id="adm-phone" class="adm-input" value={business.phoneFormatted} />
              </div>

              <div class="field-item">
                <label for="adm-whatsapp">Numéro WhatsApp Commercial (ex: +225 05 44 26 32 45)</label>
                <input type="text" id="adm-whatsapp" class="adm-input" value={business.whatsappFormatted} />
              </div>

              <div class="field-item full-width">
                <label for="adm-whatsapp-msg">Message WhatsApp d'accueil pré-rempli</label>
                <input type="text" id="adm-whatsapp-msg" class="adm-input" value={business.whatsappPreFilled} />
              </div>

              <div class="field-item full-width">
                <label for="adm-address">Adresse physique complète</label>
                <input type="text" id="adm-address" class="adm-input" value={business.address} />
              </div>

              <div class="field-item">
                <label for="adm-hours">Horaires d'Ouverture affichés</label>
                <input type="text" id="adm-hours" class="adm-input" value={business.openingHours} />
              </div>

              <div class="field-item">
                <label for="adm-schedule-note">Note d'ouverture complémentaire</label>
                <input type="text" id="adm-schedule-note" class="adm-input" value={business.scheduleNote} />
              </div>

              <div class="field-item">
                <label for="adm-ann-badge">Bannière Annonce - Badge</label>
                <input type="text" id="adm-ann-badge" class="adm-input" value={announcement.badge} />
              </div>

              <div class="field-item">
                <label for="adm-ann-text">Bannière Annonce - Texte</label>
                <input type="text" id="adm-ann-text" class="adm-input" value={announcement.text} />
              </div>
            </div>
          </section>

          <!-- ================= SECTION 2: 5 SERVICES & BACKGROUNDS ================= -->
          <section id="sec-services" class="admin-card-section prestige-card">
            <div class="section-card-head">
              <div class="badge-num">02</div>
              <div>
                <h2 class="card-sec-title">Les 5 Pôles d'Excellence (Fonds d'écran & Prestations)</h2>
                <p class="card-sec-desc">
                  Personnalisez pour chacun des 5 secteurs son image de fond, ses textes et sa liste de services détaillée (ajoutez, modifiez ou supprimez des points).
                </p>
              </div>
            </div>

            <div class="services-admin-stack" id="services-admin-cards">
              {services.map((svc, idx) => (
                <div class="service-editor-card" data-service-id={svc.id}>
                  <div class="svc-editor-head">
                    <span class="svc-index font-serif">Pôle {svc.number}</span>
                    <h3 class="svc-name">{svc.title}</h3>
                    <span class="svc-badge-tag">{svc.badge}</span>
                  </div>

                  <div class="form-fields-grid">
                    <div class="field-item">
                      <label>Titre du Pôle</label>
                      <input type="text" class="adm-input svc-title-input" value={svc.title} />
                    </div>

                    <div class="field-item">
                      <label>Sous-titre / Accroche</label>
                      <input type="text" class="adm-input svc-subtitle-input" value={svc.subtitle} />
                    </div>

                    <div class="field-item">
                      <label>Badge de mise en avant</label>
                      <input type="text" class="adm-input svc-badge-input" value={svc.badge} />
                    </div>

                    <div class="field-item">
                      <label>Tag de popularité</label>
                      <input type="text" class="adm-input svc-popular-input" value={svc.popularTag} />
                    </div>

                    <!-- Fond d'écran / Image de fond modifiable -->
                    <div class="field-item full-width">
                      <label>Image de Fond du Pôle (URL ou sélection)</label>
                      <div class="image-picker-row">
                        <input type="text" class="adm-input svc-image-input" value={svc.image} />
                        <div class="image-thumb-preview">
                          <img src={getAssetPath(svc.image)} alt={svc.title} class="svc-thumb-img" />
                        </div>
                      </div>
                      <span class="field-hint">Images prestige incluses : /images/service-studio-photo.jpg, /images/service-tech-repair.jpg, /images/service-gaming-tech.jpg, /images/service-boutique-cadeaux.jpg, /images/service-bureautique-transferts.jpg</span>
                    </div>

                    <!-- Prestations / Liste des services détaillée -->
                    <div class="field-item full-width">
                      <div class="items-list-head">
                        <label>Prestations incluses dans ce Pôle ({svc.items.length})</label>
                        <button type="button" class="btn-add-item add-svc-item-btn">
                          ➕ Ajouter une prestation
                        </button>
                      </div>

                      <div class="svc-items-container">
                        {svc.items.map((item) => (
                          <div class="svc-item-row">
                            <span class="bullet-dot">›</span>
                            <input type="text" class="adm-input svc-item-input" value={item} />
                            <button type="button" class="btn-del-item del-svc-item-btn" title="Supprimer cette prestation">
                              🗑️
                            </button>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- ================= SECTION 3: SEASONS & PRODUCTS ================= -->
          <section id="sec-seasons" class="admin-card-section prestige-card">
            <div class="section-card-head">
              <div class="badge-num">03</div>
              <div>
                <h2 class="card-sec-title">Vitrine Événementielle & Produits Saisonniers</h2>
                <p class="card-sec-desc">
                  Comprendre et piloter la vitrine dynamique : activez la saison souhaitée et gérez les produits en vedette (ajout, modification, suppression).
                </p>
              </div>
            </div>

            <!-- Explanatory note for the client -->
            <div class="explanation-box">
              <div class="expl-icon">💡</div>
              <div class="expl-content">
                <strong>Comment fonctionne la vitrine saisonnière ?</strong>
                <p>
                  Ce bloc permet d'adapter instantanément votre devanture digitale au moment fort de l'année (ex: Rentrée scolaire en septembre, Fêtes de fin d'année et Noël en décembre, Cérémonies de mariage, ou High-Tech Fest). Les clients voient les produits correspondants et peuvent les commander en 1 clic sur WhatsApp ou les payer par Wave.
                </p>
              </div>
            </div>

            <div class="form-fields-grid">
              <div class="field-item">
                <label for="adm-season-select">Saison affichée par défaut sur le site</label>
                <select id="adm-season-select" class="adm-select">
                  {seasonalShowcase.seasons.map((s) => (
                    <option value={s.id} selected={s.id === seasonalShowcase.activeSeasonId}>
                      {s.name} ({s.tag})
                    </option>
                  ))}
                </select>
              </div>

              <div class="field-item">
                <label for="adm-season-title">Titre principal de la vitrine</label>
                <input type="text" id="adm-season-title" class="adm-input" value={seasonalShowcase.title} />
              </div>

              <div class="field-item full-width">
                <label for="adm-season-sub">Sous-titre explicatif de la vitrine</label>
                <input type="text" id="adm-season-sub" class="adm-input" value={seasonalShowcase.subtitle} />
              </div>
            </div>

            <!-- Seasonal Products Manager -->
            <div class="products-manager-box">
              <div class="manager-head">
                <div>
                  <h3 class="manager-title">Catalogue des Produits Saisonniers</h3>
                  <span class="manager-sub">Gérez les articles associés à chaque saison</span>
                </div>
                <button type="button" id="btn-add-seasonal-prod" class="btn btn-gold btn-sm">
                  ➕ Ajouter un produit saisonnier
                </button>
              </div>

              <div class="seasonal-products-table-wrap">
                <div class="seasonal-prods-grid" id="seasonal-prods-admin-list">
                  {seasonalShowcase.products.map((prod) => (
                    <div class="prod-admin-card" data-prod-id={prod.id}>
                      <div class="prod-admin-media">
                        <img src={prod.image} alt={prod.name} class="prod-admin-img" />
                      </div>
                      <div class="prod-admin-form">
                        <div class="prod-row-1">
                          <input type="text" class="adm-input prod-name-input" value={prod.name} placeholder="Nom du produit" />
                          <select class="adm-select prod-season-select">
                            <option value="rentree" selected={prod.seasonId === 'rentree'}>Rentrée Scolaire</option>
                            <option value="noel" selected={prod.seasonId === 'noel'}>Fêtes & Noël</option>
                            <option value="mariages" selected={prod.seasonId === 'mariages'}>Cérémonies & Mariages</option>
                            <option value="hightech" selected={prod.seasonId === 'hightech'}>High-Tech & Gaming</option>
                          </select>
                        </div>
                        <div class="prod-row-2">
                          <input type="number" class="adm-input prod-price-input" value={prod.price} placeholder="Prix FCFA" />
                          <input type="text" class="adm-input prod-badge-input" value={prod.badge} placeholder="Badge promo" />
                          <input type="text" class="adm-input prod-img-input" value={prod.image} placeholder="URL Image" />
                        </div>
                        <input type="text" class="adm-input prod-desc-input" value={prod.description} placeholder="Courte description" />
                        <div class="prod-row-del">
                          <button type="button" class="btn-del-prod del-seasonal-prod-btn">
                            🗑️ Supprimer ce produit
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <!-- ================= SECTION 4: PRICING PACKAGES ================= -->
          <section id="sec-pricing" class="admin-card-section prestige-card">
            <div class="section-card-head">
              <div class="badge-num">04</div>
              <div>
                <h2 class="card-sec-title">Formules Tarifaires & Devis ('Transparence & Prix Doux')</h2>
                <p class="card-sec-desc">
                  Gérez les cartes de tarifs affichées sur le site (ajoutez de nouvelles formules, modifiez les prix et caractéristiques).
                </p>
              </div>
            </div>

            <div class="manager-head">
              <span class="manager-sub">Cartes de prix actuellement visibles par les clients</span>
              <button type="button" id="btn-add-pricing-pkg" class="btn btn-gold btn-sm">
                ➕ Ajouter une formule tarifaire
              </button>
            </div>

            <div class="pricing-pkgs-stack" id="pricing-pkgs-admin-list">
              {pricingPackages.map((pkg) => (
                <div class="pkg-admin-card" data-pkg-id={pkg.id}>
                  <div class="pkg-admin-row-top">
                    <input type="text" class="adm-input pkg-title-input" value={pkg.title} placeholder="Titre de la formule" />
                    <input type="text" class="adm-input pkg-cat-input" value={pkg.category} placeholder="Catégorie (ex: Studio Photo)" />
                    <input type="text" class="adm-input pkg-price-input" value={pkg.price} placeholder="Prix (ex: 15 000 FCFA)" />
                    <input type="text" class="adm-input pkg-period-input" value={pkg.period || ''} placeholder="Période (ex: la séance)" />
                  </div>

                  <div class="pkg-admin-features-box">
                    <label>Caractéristiques incluses dans cette formule</label>
                    <textarea class="adm-textarea pkg-features-input" rows="3" placeholder="Une caractéristique par ligne">{pkg.features.join('\n')}</textarea>
                  </div>

                  <div class="pkg-admin-bottom">
                    <label class="checkbox-label">
                      <input type="checkbox" class="pkg-popular-checkbox" checked={pkg.popular} />
                      <span>Formule la plus populaire (Mise en avant or)</span>
                    </label>

                    <button type="button" class="btn-del-prod del-pricing-pkg-btn">
                      🗑️ Supprimer cette formule
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- ================= SECTION 5: BOUTIQUE E-COMMERCE ================= -->
          <section id="sec-boutique" class="admin-card-section prestige-card">
            <div class="section-card-head">
              <div class="badge-num">05</div>
              <div>
                <h2 class="card-sec-title">Boutique E-Commerce Subtile (Articles en Vente Directe)</h2>
                <p class="card-sec-desc">
                  Gérez les articles présentés dans la fenêtre modale accessible via le bouton fixé en bas à gauche de l'écran.
                </p>
              </div>
            </div>

            <div class="manager-head">
              <div>
                <h3 class="manager-title">Catalogue des Articles en Vente Directe</h3>
                <span class="manager-sub">Manettes de jeu, câbles, chargeurs, maroquinerie, montres et cadeaux</span>
              </div>
              <button type="button" id="btn-add-boutique-prod" class="btn btn-gold btn-sm">
                ➕ Ajouter un article en boutique
              </button>
            </div>

            <div class="boutique-admin-grid" id="boutique-admin-list">
              {boutiqueProducts.map((bp) => (
                <div class="btq-admin-card" data-btq-id={bp.id}>
                  <div class="btq-admin-top">
                    <img src={bp.image} alt={bp.name} class="btq-admin-thumb" />
                    <div class="btq-admin-main-inputs">
                      <input type="text" class="adm-input btq-name-input" value={bp.name} placeholder="Nom de l'article" />
                      <div class="btq-row-price-cat">
                        <input type="number" class="adm-input btq-price-input" value={bp.price} placeholder="Prix FCFA" />
                        <select class="adm-select btq-cat-select">
                          <option value="gaming" selected={bp.category === 'gaming'}>Gaming & Consoles</option>
                          <option value="accessoires" selected={bp.category === 'accessoires'}>High-Tech & Câbles</option>
                          <option value="maroquinerie" selected={bp.category === 'maroquinerie'}>Sacs & Cuir</option>
                          <option value="montres" selected={bp.category === 'montres'}>Montres & Bijoux</option>
                          <option value="cadeaux" selected={bp.category === 'cadeaux'}>Cadeaux & Divers</option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="btq-admin-fields">
                    <input type="text" class="adm-input btq-badge-input" value={bp.badge} placeholder="Badge (ex: Top Vente)" />
                    <input type="text" class="adm-input btq-img-input" value={bp.image} placeholder="URL Image" />
                    <textarea class="adm-textarea btq-desc-input" rows="2" placeholder="Description de l'article">{bp.description}</textarea>
                  </div>

                  <div class="btq-admin-footer">
                    <label class="checkbox-label">
                      <input type="checkbox" class="btq-stock-checkbox" checked={bp.inStock} />
                      <span>Article en stock au Super U</span>
                    </label>

                    <button type="button" class="btn-del-prod del-btq-prod-btn">
                      🗑️ Supprimer
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- ================= SECTION 6: WAVE PAYMENT ================= -->
          <section id="sec-wave" class="admin-card-section prestige-card">
            <div class="section-card-head">
              <div class="badge-num">06</div>
              <div>
                <h2 class="card-sec-title">Paramètres de Paiement Wave Côte d'Ivoire</h2>
                <p class="card-sec-desc">Identifiants marchands et montants pré-configurés pour la modale Wave.</p>
              </div>
            </div>

            <div class="form-fields-grid">
              <div class="field-item">
                <label for="adm-wave-phone">Numéro Marchand Wave (ex: 0544263245)</label>
                <input type="text" id="adm-wave-phone" class="adm-input" value={wavePayment.merchantPhone} />
              </div>

              <div class="field-item">
                <label for="adm-wave-amount">Montant par défaut (FCFA)</label>
                <input type="number" id="adm-wave-amount" class="adm-input" value={wavePayment.defaultAmount} />
              </div>

              <div class="field-item full-width">
                <label for="adm-wave-banks">Banques Partenaires Agrées affichées</label>
                <input type="text" id="adm-wave-banks" class="adm-input" value={wavePayment.partnerBanks} />
              </div>
            </div>
          </section>

          <!-- Floating Bottom Save Bar -->
          <div class="admin-sticky-bottom-bar">
            <div class="container bottom-bar-inner">
              <span class="bar-notice">💡 Pensez à enregistrer vos changements pour qu'ils s'appliquent immédiatement sur le site vitrine.</span>
              <button type="submit" class="btn btn-gold btn-save-big">
                💾 Sauvegarder & Publier en Direct
              </button>
            </div>
          </div>

        </form>
      </main>
    </div>
  </div>
</Layout>

<style>
  .admin-page-container {
    background-color: #040913;
    min-height: 100vh;
    padding-bottom: 7rem;
    color: #f1f5f9;
  }

  /* Topbar */
  .admin-topbar {
    background: #08162b;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
  }

  .admin-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .admin-brand {
    display: flex;
    align-items: center;
  }

  .admin-logo-link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
  }

  .admin-crest {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .admin-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    font-family: var(--font-serif);
    line-height: 1.2;
  }

  .admin-tag {
    font-size: 0.76rem;
    color: var(--gold-400);
  }

  .admin-topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .btn-sm {
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
  }

  /* Main Layout Grid */
  .admin-main-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    margin-top: 2.5rem;
    align-items: flex-start;
  }

  /* Fixed Navigation Sidebar in its left position */
  .admin-nav-sidebar {
    width: 280px;
    min-width: 280px;
    position: relative;
    height: 100%;
  }

  .sidebar-sticky-box {
    position: fixed;
    top: 90px;
    width: 280px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    z-index: 90;
    background: rgba(10, 26, 52, 0.94);
    border: 1.5px solid rgba(212, 175, 55, 0.35);
    border-radius: var(--radius-lg);
    padding: 1.3rem;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    async function loadRolesAndUsers() {
      const tbody = document.getElementById('users-roles-tbody');
      const datalist = document.getElementById('clerk-emails-datalist');
      if (!tbody) return;

      try {
        const res = await fetch('/api/admin/roles');
        if (!res.ok) throw new Error(`Erreur HTTP ${res.status}`);
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Erreur lors du chargement des rôles');

        cachedUsers = data.users || [];
        updateRoleMetrics(cachedUsers);
        updateDatalist(cachedUsers, datalist);
        renderUsersTable();
      } catch (err: any) {
        if (tbody) {
          tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4" style="color: #f87171;">⚠️ Impossible de charger les rôles: ${err.message}</td></tr>`;
        }
      }
    }

    function updateRoleMetrics(users: any[]) {
      const counts: Record<string, number> = { admin: 0, poles: 0, vip: 0, clients: 0 };
      users.forEach(u => {
        if (counts[u.role] !== undefined) {
          counts[u.role]++;
        } else {
          counts.clients++;
        }
      });

      const elAdmin = document.getElementById('count-admins');
      const elPoles = document.getElementById('count-poles');
      const elVip = document.getElementById('count-vip');
      const elClients = document.getElementById('count-clients');

      if (elAdmin) elAdmin.textContent = counts.admin.toString();
      if (elPoles) elPoles.textContent = counts.poles.toString();
      if (elVip) elVip.textContent = counts.vip.toString();
      if (elClients) elClients.textContent = counts.clients.toString();

      const pAll = document.getElementById('pill-all-count');
      const pAdmin = document.getElementById('pill-admin-count');
      const pPoles = document.getElementById('pill-poles-count');
      const pVip = document.getElementById('pill-vip-count');
      const pClients = document.getElementById('pill-clients-count');

      if (pAll) pAll.textContent = users.length.toString();
      if (pAdmin) pAdmin.textContent = counts.admin.toString();
      if (pPoles) pPoles.textContent = counts.poles.toString();
      if (pVip) pVip.textContent = counts.vip.toString();
      if (pClients) pClients.textContent = counts.clients.toString();
    }

    function updateDatalist(users: any[], dl: HTMLElement | null) {
      if (!dl) return;
      dl.innerHTML = '';
      users.forEach(u => {
        const opt = document.createElement('option');
        opt.value = u.email;
        opt.textContent = `${u.name ? u.name + ' - ' : ''}(Rôle actuel: ${u.role})`;
        dl.appendChild(opt);
      });
    }

    function renderUsersTable() {
      const tbody = document.getElementById('users-roles-tbody');
      if (!tbody) return;

      const filtered = cachedUsers.filter(u => {
        const matchesFilter = currentRoleFilter === 'all' || u.role === currentRoleFilter;
        const q = searchQuery.toLowerCase().trim();
        const matchesSearch = !q || u.email.toLowerCase().includes(q) || (u.name && u.name.toLowerCase().includes(q));
        return matchesFilter && matchesSearch;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4" style="color: var(--ivory-muted);">Aucun utilisateur ne correspond aux filtres.</td></tr>`;
        return;
      }

      const roleBadgeStyles: Record<string, { bg: string; border: string; text: string; icon: string; label: string }> = {
        admin: { bg: 'rgba(212, 175, 55, 0.2)', border: '#d4af37', text: '#f6d365', icon: '👑', label: 'Admin' },
        poles: { bg: 'rgba(0, 150, 255, 0.2)', border: '#0096ff', text: '#60a5fa', icon: '🏢', label: 'Pôle' },
        vip: { bg: 'rgba(168, 85, 247, 0.2)', border: '#a855f7', text: '#c084fc', icon: '⭐', label: 'VIP' },
        clients: { bg: 'rgba(16, 185, 129, 0.2)', border: '#10b981', text: '#34d399', icon: '👤', label: 'Client' }
      };

      const poleLabels: Record<string, string> = {
        studio: '📸 Studio',
        reparation: '⚡ Réparation',
        boutique: '🛍️ Boutique',
        bureautique: '🖨️ Bureautique',
        'mobile-money': '📱 Mobile Money'
      };

      tbody.innerHTML = filtered.map(u => {
        const isRoot = !!u.isHardcodedAdmin;

        let polesHtml = '';
        if (u.role === 'admin') {
          polesHtml = '<span class="pole-pill-all">👑 Tous les pôles</span>';
        } else if (u.role === 'poles') {
          if (u.assignedPoles && u.assignedPoles.length > 0) {
            polesHtml = u.assignedPoles.map((p: string) => `<span class="pole-pill">${poleLabels[p] || p}</span>`).join(' ');
          } else {
            polesHtml = '<span style="color: var(--ivory-muted);">Aucun pôle spécifié</span>';
          }
        } else {
          polesHtml = '<span style="color: var(--ivory-muted);">-</span>';
        }

        const avatarHtml = u.imageUrl 
          ? `<img src="${u.imageUrl}" alt="" class="user-row-avatar" />`
          : `<span class="user-row-placeholder">${u.name ? u.name[0].toUpperCase() : u.email[0].toUpperCase()}</span>`;

        const sourceLabel = isRoot 
          ? '<span class="source-tag env">Env (Root)</span>' 
          : u.source === 'database' 
            ? '<span class="source-tag db">MongoDB</span>' 
            : '<span class="source-tag clerk">Clerk</span>';

        return `
          <tr data-user-email="${u.email}">
            <td>
              <div class="user-row-cell">
                ${avatarHtml}
                <div class="user-row-texts">
                  <strong>${u.name || u.email}</strong>
                  <span class="user-row-email">${u.email}</span>
                </div>
              </div>
            </td>
            <td>
              <div class="role-selector-wrap">
                <select class="quick-role-select" data-email="${u.email}" ${isRoot ? 'disabled title="Super-admin racine défini en .env"' : ''}>
                  <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>👑 Administrateur</option>
                  <option value="poles" ${u.role === 'poles' ? 'selected' : ''}>🏢 Responsable Pôle</option>
                  <option value="vip" ${u.role === 'vip' ? 'selected' : ''}>⭐ Client VIP</option>
                  <option value="clients" ${u.role === 'clients' ? 'selected' : ''}>👤 Client Standard</option>
                </select>
              </div>
            </td>
            <td>
              <div class="user-row-poles">
                ${polesHtml}
              </div>
            </td>
            <td>
              <div class="user-row-notes">
                <span class="note-text">${u.notes || '-'}</span>
                ${sourceLabel}
              </div>
            </td>
            <td class="text-right">
              <div class="user-row-actions">
                <button type="button" class="btn-user-action btn-edit-role" data-email="${u.email}" data-role="${u.role}" data-poles='${JSON.stringify(u.assignedPoles || [])}' data-notes="${u.notes || ''}" title="Éditer dans le formulaire">
                  ✏️
                </button>
                ${!isRoot ? `
                  <button type="button" class="btn-user-action btn-delete-role" data-email="${u.email}" title="Réinitialiser à Client Standard">
                    🗑️
                  </button>
                ` : ''}
              </div>
            </td>
          </tr>
        `;
      }).join('');

      // Bind quick change selects
      tbody.querySelectorAll('.quick-role-select').forEach(sel => {
        sel.addEventListener('change', async (e) => {
          const target = e.target as HTMLSelectElement;
          const email = target.getAttribute('data-email');
          const newRole = target.value;
          if (!email) return;

          if (confirm(`Confirmez-vous le passage de "${email}" au rôle "${newRole}" ?`)) {
            try {
              const res = await fetch('/api/admin/roles', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, role: newRole })
              });
              const d = await res.json();
              if (d.success) {
                alert(`✅ Rôle mis à jour pour ${email} : ${newRole}`);
                loadRolesAndUsers();
              } else {
                throw new Error(d.error);
              }
            } catch (err: any) {
              alert(`Erreur: ${err.message}`);
              loadRolesAndUsers();
            }
          } else {
            loadRolesAndUsers();
          }
        });
      });

      // Bind edit button
      tbody.querySelectorAll('.btn-edit-role').forEach(btn => {
        btn.addEventListener('click', () => {
          const email = btn.getAttribute('data-email');
          const role = btn.getAttribute('data-role');
          const notes = btn.getAttribute('data-notes');
          const polesStr = btn.getAttribute('data-poles');
          let poles: string[] = [];
          try { poles = JSON.parse(polesStr || '[]'); } catch(e){}

          const emailInput = document.getElementById('assign-email') as HTMLInputElement;
          const roleSel = document.getElementById('assign-role-select') as HTMLSelectElement;
          const notesInput = document.getElementById('assign-notes') as HTMLInputElement;

          if (emailInput && email) emailInput.value = email;
          if (roleSel && role) {
            roleSel.value = role;
            roleSel.dispatchEvent(new Event('change'));
          }
          if (notesInput && notes) notesInput.value = notes;

          document.querySelectorAll<HTMLInputElement>('input[name="assignedPoles"]').forEach(cb => {
            cb.checked = poles.includes(cb.value);
          });

          document.getElementById('form-assign-role')?.scrollIntoView({ behavior: 'smooth' });
        });
      });

      // Bind delete button
      tbody.querySelectorAll('.btn-delete-role').forEach(btn => {
        btn.addEventListener('click', async () => {
          const email = btn.getAttribute('data-email');
          if (!email) return;

          if (confirm(`Voulez-vous supprimer les autorisations spécifiques de "${email}" (reviendra à Client Standard) ?`)) {
            try {
              const res = await fetch(`/api/admin/roles?email=${encodeURIComponent(email)}`, {
                method: 'DELETE'
              });
              const d = await res.json();
              if (d.success) {
                alert(`✅ Permissions réinitialisées pour ${email}`);
                loadRolesAndUsers();
              } else {
                throw new Error(d.error);
              }
            } catch (err: any) {
              alert(`Erreur: ${err.message}`);
            }
          }
        });
      });
    }

    // Role form submit
    const roleForm = document.getElementById('form-assign-role') as HTMLFormElement | null;
    const feedbackMsg = document.getElementById('role-feedback-msg');

    roleForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('assign-email') as HTMLInputElement)?.value?.trim();
      const role = (document.getElementById('assign-role-select') as HTMLSelectElement)?.value;
      const notes = (document.getElementById('assign-notes') as HTMLInputElement)?.value?.trim();
      const submitBtn = document.getElementById('btn-submit-role') as HTMLButtonElement | null;

      const checkedPoles: string[] = [];
      document.querySelectorAll<HTMLInputElement>('input[name="assignedPoles"]:checked').forEach(cb => {
        checkedPoles.push(cb.value);
      });

      if (!email || !role) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enregistrement...';
      }

      try {
        const res = await fetch('/api/admin/roles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            role,
            assignedPoles: role === 'poles' ? checkedPoles : [],
            notes
          })
        });

        const d = await res.json();
        if (d.success) {
          if (feedbackMsg) {
            feedbackMsg.style.display = 'block';
            feedbackMsg.className = 'role-feedback-msg success';
            feedbackMsg.innerHTML = `✅ <strong>${d.message}</strong>`;
            setTimeout(() => { feedbackMsg.style.display = 'none'; }, 5000);
          }
          roleForm.reset();
          loadRolesAndUsers();
        } else {
          throw new Error(d.error || 'Échec de la sauvegarde');
        }
      } catch (err: any) {
        if (feedbackMsg) {
          feedbackMsg.style.display = 'block';
          feedbackMsg.className = 'role-feedback-msg error';
          feedbackMsg.textContent = `⚠️ Erreur: ${err.message}`;
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '💾 Enregistrer & Synchroniser le Rôle';
        }
      }
    });

    // Search and filter pills
    document.getElementById('users-search-input')?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      renderUsersTable();
    });

    document.querySelectorAll('#role-filter-pills .filter-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('#role-filter-pills .filter-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentRoleFilter = pill.getAttribute('data-role-filter') || 'all';
        renderUsersTable();
      });
    });

    document.getElementById('btn-refresh-roles')?.addEventListener('click', () => {
      loadRolesAndUsers();
    });

    // Load roles on startup if sec-roles is present
    if (document.getElementById('sec-roles')) {
      loadRolesAndUsers();
    }

    // Anchor & Fixed Alignment for Left Sidebar
    function alignAdminSidebar() {
      const sidebar = document.querySelector('.admin-nav-sidebar') as HTMLElement;
      const box = document.querySelector('.sidebar-sticky-box') as HTMLElement;
      if (!sidebar || !box) return;

      if (window.innerWidth > 1024) {
        const rect = sidebar.getBoundingClientRect();
        box.style.position = 'fixed';
        box.style.top = '90px';
        box.style.left = `${rect.left}px`;
        box.style.width = `${sidebar.clientWidth}px`;
      } else {
        box.style.position = '';
        box.style.top = '';
        box.style.left = '';
        box.style.width = '';
      }
    }

    alignAdminSidebar();
    window.addEventListener('resize', alignAdminSidebar);
    window.addEventListener('scroll', alignAdminSidebar, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdminPage);
  } else {
    setupAdminPage();
  }
</script>

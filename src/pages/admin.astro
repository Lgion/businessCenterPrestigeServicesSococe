    // Records Dashboard (MongoDB Atlas)
    async function loadAdminRecords() {
      try {
        const res = await fetch('/api/admin/records');
        const json = await res.json();
        if (!json.success || !json.data) return;

        const { orders, repairRequests, photoUploads, gamingCallbacks, fastpasses } = json.data;

        const statOrders = document.getElementById('stat-orders-count');
        const statRepairs = document.getElementById('stat-repairs-count');
        const statPhotos = document.getElementById('stat-photos-count');
        const statFastpass = document.getElementById('stat-fastpass-count');

        if (statOrders) statOrders.textContent = (orders?.length || 0).toString();
        if (statRepairs) statRepairs.textContent = (repairRequests?.length || 0).toString();
        if (statPhotos) statPhotos.textContent = (photoUploads?.length || 0).toString();
        if (statFastpass) statFastpass.textContent = (fastpasses?.length || 0).toString();

        // Orders List
        const ordersGrid = document.getElementById('orders-list-grid');
        const ordersEmpty = document.getElementById('orders-list-empty');
        if (ordersGrid && ordersEmpty) {
          if (!orders || orders.length === 0) {
            ordersEmpty.textContent = 'Aucune commande PayDunya pour le moment.';
            ordersEmpty.style.display = 'block';
            ordersGrid.innerHTML = '';
          } else {
            ordersEmpty.style.display = 'none';
            ordersGrid.innerHTML = orders.map((o: any) => `
              <div class="record-card">
                <div class="record-card-head">
                  <span class="record-id font-mono">${o.orderId || 'BCPS'}</span>
                  <span class="record-status ${o.status === 'paid' ? 'status-paid' : 'status-pending'}">
                    ${o.status === 'paid' ? '✅ PAYÉ' : '⏳ EN ATTENTE'}
                  </span>
                </div>
                <div class="record-card-body">
                  <strong>${o.title || 'Commande Boutique'}</strong>
                  <div class="record-meta">
                    <span>Client : <strong>${o.customerName || 'Inconnu'}</strong> (${o.customerPhone || 'N/A'})</span>
                    <span class="record-amount gold-gradient-text font-serif">${(o.amount || 0).toLocaleString('fr-FR')} FCFA</span>
                  </div>
                  <div class="record-items-mini">
                    ${(o.items || []).map((i: any) => `• ${i.name} (x${i.quantity || 1})`).join('<br/>')}
                  </div>
                  ${o.deliveryAddress ? `<div class="record-addr">📍 Adresse : ${o.deliveryAddress}</div>` : ''}
                </div>
                <div class="record-card-foot">
                  <span class="record-date">${new Date(o.createdAt).toLocaleString('fr-FR')}</span>
                  ${o.paymentToken ? `<a href="/checkout/simulate?token=${o.paymentToken}" target="_blank" class="record-link">Lien PayDunya / Test ›</a>` : ''}
                </div>
              </div>
            `).join('');
          }
        }

        // Repairs List
        const repairsGrid = document.getElementById('repairs-list-grid');
        const repairsEmpty = document.getElementById('repairs-list-empty');
        if (repairsGrid && repairsEmpty) {
          if (!repairRequests || repairRequests.length === 0) {
            repairsEmpty.style.display = 'block';
            repairsGrid.innerHTML = '';
          } else {
            repairsEmpty.style.display = 'none';
            repairsGrid.innerHTML = repairRequests.map((r: any) => `
              <div class="record-card">
                <div class="record-card-head">
                  <span class="record-id font-mono">${r.requestId || 'REP'}</span>
                  <span class="record-status status-blue">⚡ RÉPARATION</span>
                </div>
                <div class="record-card-body">
                  <strong>${r.brand || ''} ${r.model || ''}</strong>
                  <p class="record-desc-text">Panne : ${r.issueType || ''} (${r.issueDescription || ''})</p>
                  <div class="record-meta">
                    <span>Contact : ${r.customerName} (${r.customerPhone})</span>
                  </div>
                  ${r.withYangoPickup ? `
                    <div class="record-yango-badge">
                      🛵 Coursier Yango demandé : <strong>${r.pickupAddress || ''}</strong>
                      <br/>Distance : ${r.estimatedDistanceKm || 0} km • Frais : ${(r.yangoFee || 0).toLocaleString('fr-FR')} F
                    </div>
                  ` : '<div class="record-addr">Dépôt par le client au Super U</div>'}
                </div>
                <div class="record-card-foot">
                  <span class="record-date">${new Date(r.createdAt).toLocaleString('fr-FR')}</span>
                  <a href="https://wa.me/225${r.customerPhone}" target="_blank" class="record-link">Contacter Client WhatsApp ›</a>
                </div>
              </div>
            `).join('');
          }
        }

        // Photos List
        const photosGrid = document.getElementById('photos-list-grid');
        const photosEmpty = document.getElementById('photos-list-empty');
        if (photosGrid && photosEmpty) {
          if (!photoUploads || photoUploads.length === 0) {
            photosEmpty.style.display = 'block';
            photosGrid.innerHTML = '';
          } else {
            photosEmpty.style.display = 'none';
            photosGrid.innerHTML = photoUploads.map((p: any) => `
              <div class="record-card photo-rec-card">
                ${p.cloudinaryUrl ? `<img src="${p.cloudinaryUrl}" alt="Photo upload" class="rec-photo-thumb" />` : ''}
                <div class="record-card-body">
                  <strong>${p.serviceType || 'Tirage Photo'}</strong>
                  <div class="record-meta">
                    <span>Client : ${p.customerName || 'N/A'} (${p.customerPhone || 'N/A'})</span>
                  </div>
                  ${p.notes ? `<p class="record-desc-text">${p.notes}</p>` : ''}
                  <a href="${p.cloudinaryUrl || p.originalUrl}" target="_blank" class="record-link">Voir l'image Cloudinary HD ›</a>
                </div>
                <div class="record-card-foot">
                  <span class="record-date">${new Date(p.createdAt).toLocaleString('fr-FR')}</span>
                </div>
              </div>
            `).join('');
          }
        }

        // Callbacks List
        const callbacksGrid = document.getElementById('callbacks-list-grid');
        const callbacksEmpty = document.getElementById('callbacks-list-empty');
        if (callbacksGrid && callbacksEmpty) {
          if (!gamingCallbacks || gamingCallbacks.length === 0) {
            callbacksEmpty.style.display = 'block';
            callbacksGrid.innerHTML = '';
          } else {
            callbacksEmpty.style.display = 'none';
            callbacksGrid.innerHTML = gamingCallbacks.map((c: any) => `
              <div class="record-card">
                <div class="record-card-head">
                  <span class="record-id font-mono">RAPPEL</span>
                  <span class="record-status status-gold">📞 RAPPEL REQUIS</span>
                </div>
                <div class="record-card-body">
                  <strong>${c.phone}</strong>
                  <p class="record-desc-text">Article recherché : ${c.interest || 'Conseil Gaming / Accessoires'}</p>
                </div>
                <div class="record-card-foot">
                  <span class="record-date">${new Date(c.createdAt).toLocaleString('fr-FR')}</span>
                  <a href="tel:${c.phone}" class="record-link">Appeler le Client ›</a>
                </div>
              </div>
            `).join('');
          }
        }
      } catch (err) {
        console.error('Failed to load admin records:', err);
      }
    }

    // Records Tab Buttons
    document.querySelectorAll('.rec-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.rec-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.rec-tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const tabName = btn.getAttribute('data-rec-tab');
        const panel = document.getElementById(`rec-panel-${tabName}`);
        if (panel) panel.classList.add('active');
      });
    });

    document.getElementById('btn-refresh-records')?.addEventListener('click', loadAdminRecords);

    // Initial load
    loadAdminRecords();

    // Export JSON
    exportBtn?.addEventListener('click', () => {
      saveAllAdminData();
      const stored = localStorage.getItem('bcps_site_data') || '{}';
      const blob = new Blob([stored], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'bcps-site-config.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Import JSON
    importInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const content = event.target?.result as string;
          JSON.parse(content);
          localStorage.setItem('bcps_site_data', content);
          alert('Configuration importée avec succès ! La page va se recharger.');
          location.reload();
        } catch(err) {
          alert('Fichier JSON invalide.');
        }
      };
      reader.readAsText(file);
    });

    // Reset default
    resetBtn?.addEventListener('click', () => {
      if (confirm('Voulez-vous restaurer toutes les valeurs par défaut de la boutique ?')) {
        localStorage.removeItem('bcps_site_data');
        location.reload();
      }
    });

    // Save Form bindings
    topSaveBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      saveAllAdminData();
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      saveAllAdminData();
    });

    // Step-by-Step Single Section Navigation System
    const sections = document.querySelectorAll('.admin-card-section');
    const sidebarLinks = document.querySelectorAll('.sidebar-link');
    const stepperSteps = document.querySelectorAll('.stepper-step');

    function switchSection(targetId: string) {
      let found = false;
      sections.forEach(sec => {
        if (sec.id === targetId) {
          sec.classList.add('active-section');
          found = true;
        } else {
          sec.classList.remove('active-section');
        }
      });

      if (!found && sections.length > 0) {
        sections[0].classList.add('active-section');
        targetId = sections[0].id;
      }

      sidebarLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (href === `#${targetId}`) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });

      stepperSteps.forEach(step => {
        if (step.getAttribute('data-step-target') === targetId) {
          step.classList.add('active');
          step.setAttribute('aria-selected', 'true');
          step.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          step.classList.remove('active');
          step.setAttribute('aria-selected', 'false');
        }
      });

      try {
        history.replaceState(null, '', `#${targetId}`);
      } catch (e) {}

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Sidebar links click
    sidebarLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = link.getAttribute('href');
        if (href) switchSection(href.replace('#', ''));
      });
    });

    // Stepper tab buttons click
    stepperSteps.forEach(step => {
      step.addEventListener('click', () => {
        const targetId = step.getAttribute('data-step-target');
        if (targetId) switchSection(targetId);
      });
    });

    // Footer Next / Previous / Quick Save clicks
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.btn-nav-step') as HTMLElement | null;
      if (btn) {
        e.preventDefault();
        const targetId = btn.getAttribute('data-nav-target');
        if (targetId) switchSection(targetId);
      }
      if ((e.target as HTMLElement).closest('.btn-admin-quick-save')) {
        e.preventDefault();
        saveAllAdminData();
      }
    });

    // Initial Active Section on Load (support URL hash e.g. #sec-pricing)
    const initialHash = window.location.hash?.replace('#', '');
    if (initialHash && document.getElementById(initialHash)) {
      switchSection(initialHash);
    } else {
      switchSection('sec-orders');
    }

    // Admin Security PIN Unlock Modal
    const authOverlay = document.getElementById('admin-auth-overlay');
    const pinForm = document.getElementById('admin-pin-form');
    const pinInput = document.getElementById('admin-pin-input') as HTMLInputElement | null;
    const pinError = document.getElementById('pin-error-msg');

    const isUnlocked = sessionStorage.getItem('bcps_admin_unlocked') === 'true';
    if (!isUnlocked && authOverlay) {
      authOverlay.style.display = 'flex';
      setTimeout(() => pinInput?.focus(), 150);
    }

    pinForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = pinInput?.value.trim() || '';
      // Support master pin 1234, sococe, or bcps2026
      if (val === '1234' || val === 'bcps2026' || val === 'sococe') {
        sessionStorage.setItem('bcps_admin_unlocked', 'true');
        if (authOverlay) authOverlay.style.display = 'none';
      } else {
        if (pinError) pinError.style.display = 'block';
        if (pinInput) {
          pinInput.value = '';
          pinInput.focus();
        }
      }
    });

    // Anchor & Fixed Alignment for Left Sidebar
    function alignAdminSidebar() {
      const sidebar = document.querySelector('.admin-nav-sidebar') as HTMLElement;
      const box = document.querySelector('.sidebar-sticky-box') as HTMLElement;
      if (!sidebar || !box) return;

      if (window.innerWidth > 1024) {
        const rect = sidebar.getBoundingClientRect();
        box.style.position = 'fixed';
        box.style.top = '90px';
        box.style.left = `${rect.left}px`;
        box.style.width = `${sidebar.clientWidth}px`;
      } else {
        box.style.position = '';
        box.style.top = '';
        box.style.left = '';
        box.style.width = '';
      }
    }

    alignAdminSidebar();
    window.addEventListener('resize', alignAdminSidebar);
    window.addEventListener('scroll', alignAdminSidebar, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdminPage);
  } else {
    setupAdminPage();
  }
</script>

<script>
  function setupAdminPage() {
    const form = document.getElementById('global-admin-form') as HTMLFormElement;
    const topSaveBtn = document.getElementById('admin-page-save-btn');
    const exportBtn = document.getElementById('sidebar-export-btn');
    const importInput = document.getElementById('sidebar-import-input') as HTMLInputElement;
    const resetBtn = document.getElementById('sidebar-reset-btn');

    // Load saved data from localStorage into the form inputs
    function loadSavedAdminData() {
      const stored = localStorage.getItem('bcps_site_data');
      if (!stored) return;
      try {
        const data = JSON.parse(stored);
        if (data.name) (document.getElementById('adm-name') as HTMLInputElement).value = data.name;
        if (data.phoneFormatted) (document.getElementById('adm-phone') as HTMLInputElement).value = data.phoneFormatted;
        if (data.whatsappFormatted) (document.getElementById('adm-whatsapp') as HTMLInputElement).value = data.whatsappFormatted;
        if (data.whatsappPreFilled) (document.getElementById('adm-whatsapp-msg') as HTMLInputElement).value = data.whatsappPreFilled;
        if (data.address) (document.getElementById('adm-address') as HTMLInputElement).value = data.address;
        if (data.openingHours) (document.getElementById('adm-hours') as HTMLInputElement).value = data.openingHours;
        if (data.scheduleNote) (document.getElementById('adm-schedule-note') as HTMLInputElement).value = data.scheduleNote;
        if (data.announcementBadge) (document.getElementById('adm-ann-badge') as HTMLInputElement).value = data.announcementBadge;
        if (data.announcementText) (document.getElementById('adm-ann-text') as HTMLInputElement).value = data.announcementText;

        if (data.seasonSelect) (document.getElementById('adm-season-select') as HTMLSelectElement).value = data.seasonSelect;
        if (data.seasonTitle) (document.getElementById('adm-season-title') as HTMLInputElement).value = data.seasonTitle;
        if (data.seasonSubtitle) (document.getElementById('adm-season-sub') as HTMLInputElement).value = data.seasonSubtitle;

        if (data.wavePhone) (document.getElementById('adm-wave-phone') as HTMLInputElement).value = data.wavePhone;
        if (data.waveAmount) (document.getElementById('adm-wave-amount') as HTMLInputElement).value = data.waveAmount;

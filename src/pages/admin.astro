    let cachedUsers: any[] = [];
    let currentRoleFilter = 'all';
    let searchQuery = '';

    const roleSelect = document.getElementById('assign-role-select') as HTMLSelectElement | null;
    const polesSubfield = document.getElementById('assign-poles-subfield');
    const roleHint = document.getElementById('assign-role-hint');

    const roleHints: Record<string, string> = {
      admin: '👑 Accès total : gestion du site, prix, commandes, et configuration des rôles utilisateurs.',
      poles: '🏢 Accès opérationnel aux commandes, réparations, fastpass et téléversements des pôles choisis.',
      vip: '⭐ Client VIP : priorités au Super U, tarifs préférentiels (accès client standard, pas d\'accès console).',
      clients: '👤 Client Standard : accès boutique, démarches en ligne et suivi (pas d\'accès console).'
    };

    roleSelect?.addEventListener('change', () => {
      const val = roleSelect.value;
      if (polesSubfield) {
        polesSubfield.style.display = val === 'poles' ? 'block' : 'none';
      }
      if (roleHint && roleHints[val]) {
        roleHint.textContent = roleHints[val];
      }

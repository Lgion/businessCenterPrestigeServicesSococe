---
import Layout from '../../layouts/Layout.astro';
import { getDb } from '../../lib/mongodb';
import { defaultSiteData } from '../../data/siteData';

const orderId = Astro.url.searchParams.get('order_id') || '';
let order: any = null;

if (orderId) {
  try {
    const db = await getDb();
    order = await db.collection('orders').findOne({ orderId });
  } catch (e) {
    console.error('Error fetching order:', e);
  }
}

const { business } = defaultSiteData;
---

<Layout title={`Commande Confirmée #${orderId} | Business Center Prestige Services`}>
  <div class="success-page-container">
    <div class="success-card prestige-card">
      <div class="success-icon-circle">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>

      <span class="status-badge">Paiement Validé avec Succès</span>
      <h1 class="success-title font-serif">Merci pour votre commande !</h1>
      <p class="success-desc">
        Votre transaction a été enregistrée avec succès. Notre équipe au <strong>Super U Deux Plateaux</strong> prépare votre demande dès à présent.
      </p>

      <div class="receipt-box">
        <div class="receipt-header">
          <span class="receipt-tag">Reçu de Paiement Numérique</span>
          <span class="receipt-ref font-mono">Réf: {orderId}</span>
        </div>

        <div class="receipt-body">
          <div class="receipt-row">
            <span>Prestation / Article :</span>
            <strong>{order?.title || 'Commande Prestige Services'}</strong>
          </div>

          {order?.customerName && (
            <div class="receipt-row">
              <span>Client :</span>
              <span>{order.customerName}</span>
            </div>
          )}

          {order?.customerPhone && (
            <div class="receipt-row">
              <span>Téléphone :</span>
              <span>{order.customerPhone}</span>
            </div>
          )}

          <div class="receipt-row">
            <span>Mode d'enlèvement :</span>
            <span>{order?.pickupType === 'yango' ? 'Coursier Yango à domicile' : 'Retrait comptoir Super U'}</span>
          </div>

          {order?.deliveryAddress && (
            <div class="receipt-row">
              <span>Adresse de collecte/livraison :</span>
              <span>{order.deliveryAddress}</span>
            </div>
          )}

          <div class="receipt-row total">
            <span>Montant Total Réglé :</span>
            <span class="gold-gradient-text font-serif total-price">
              {(order?.amount || 0).toLocaleString('fr-FR')} FCFA
            </span>
          </div>
        </div>
      </div>

      <div class="next-steps-card">
        <h4 class="next-title">📍 Que se passe-t-il ensuite ?</h4>
        <ul class="next-list">
          <li>
            <strong>Comptoir Super U :</strong> Votre commande ou matériel est disponible à notre comptoir situé dans la galerie du Super U Deux Plateaux (Gare de Sococé), ouvert jusqu'à 20h00.
          </li>
          <li>
            <strong>Assistance WhatsApp :</strong> Pour toute question ou suivi instantané, cliquez ci-dessous pour joindre directement notre équipe sur WhatsApp avec votre référence de commande.
          </li>
        </ul>
      </div>

      <div class="success-actions">
        <a 
          href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent(`Bonjour Business Center Prestige Services, j'ai effectué le paiement de ma commande Réf: ${orderId} d'un montant de ${(order?.amount || 0).toLocaleString('fr-FR')} FCFA.`)}`}
          class="btn btn-whatsapp btn-lg w-100"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Notifier le Comptoir sur WhatsApp</span>
        </a>

        <a href="/" class="btn btn-navy-outline w-100">
          Retourner à l'Accueil
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .success-page-container {
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem;
    background: radial-gradient(circle at top, var(--navy-800) 0%, var(--navy-950) 100%);
  }

  .success-card {
    max-width: 600px;
    width: 100%;
    padding: 2.75rem;
    text-align: center;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(212, 175, 55, 0.4);
    background: rgba(10, 24, 46, 0.95);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 35px rgba(212, 175, 55, 0.18);
  }

  .success-icon-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.15);
    border: 2px solid #22c55e;
    color: #22c55e;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem auto;
  }

  .status-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .success-title {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .success-desc {
    font-size: 0.95rem;
    color: var(--ivory-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .receipt-box {
    text-align: left;
    background: rgba(6, 14, 26, 0.75);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .receipt-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1rem;
  }

  .receipt-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--gold-400);
    text-transform: uppercase;
  }

  .receipt-ref {
    font-size: 0.82rem;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .receipt-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .receipt-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: var(--ivory-muted);
  }

  .receipt-row.total {
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
    padding-top: 0.85rem;
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }

  .total-price {
    font-size: 1.55rem;
    font-weight: 800;
  }

  .next-steps-card {
    text-align: left;
    background: rgba(14, 32, 60, 0.5);
    border-left: 3px solid var(--gold-400);
    padding: 1.25rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: 2rem;
  }

  .next-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.65rem;
  }

  .next-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.86rem;
    color: var(--ivory-muted);
    line-height: 1.5;
  }

  .success-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
</style>

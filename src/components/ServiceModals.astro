<script>
  function setupAllServiceModals() {
    const photoModal = document.getElementById('modal-service-photo') as HTMLDialogElement;
    const repModal = document.getElementById('modal-service-reparation') as HTMLDialogElement;
    const gamingModal = document.getElementById('modal-service-gaming') as HTMLDialogElement;
    const bureauModal = document.getElementById('modal-service-bureautique') as HTMLDialogElement;
    const boutiqueModal = document.getElementById('boutique-modal') as HTMLDialogElement;

    // Helper to setup open and close
    function setupModal(dialog: HTMLDialogElement, openTriggerClass: string, closeTriggerClass: string) {
      if (!dialog) return;

      document.querySelectorAll(`.${openTriggerClass}`).forEach(trigger => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          dialog.showModal();
        });
      });

      document.querySelectorAll(`.${closeTriggerClass}`).forEach(closeBtn => {
        closeBtn.addEventListener('click', () => dialog.close());
      });

      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) dialog.close();
      });
    }

    // Connect the 4 new modals
    setupModal(photoModal, 'open-photo-trigger', 'close-photo-btn');
    setupModal(repModal, 'open-reparation-trigger', 'close-reparation-btn');
    setupModal(gamingModal, 'open-gaming-trigger', 'close-gaming-btn');
    setupModal(bureauModal, 'open-bureautique-trigger', 'close-bureautique-btn');

    // Connect Hero Chips and Services Cards to open the corresponding modal directly!
    const heroChips = document.querySelectorAll('.hero-service-chip');
    heroChips.forEach(chip => {
      chip.addEventListener('click', (e) => {
        e.preventDefault();
        const cat = chip.getAttribute('data-category');
        if (cat === 'studio-photo') photoModal?.showModal();
        else if (cat === 'reparation-express') repModal?.showModal();
        else if (cat === 'electronique-gaming') gamingModal?.showModal();
        else if (cat === 'boutique-cadeaux') boutiqueModal?.showModal();
        else if (cat === 'bureautique-transferts') bureauModal?.showModal();
      });
    });

    // Also connect clicking in ServicesGrid cards
    document.querySelectorAll('.service-card').forEach(card => {
      const cat = card.getAttribute('data-category');
      const actionBtn = card.querySelector('.service-action-btn');
      
      // Add a quick "Détails & Tarifs" trigger button on each card
      const topRow = card.querySelector('.service-top-row');
      if (topRow && !topRow.querySelector('.modal-trigger-chip')) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'modal-trigger-chip';
        btn.innerHTML = '📋 Voir les Formules';
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (cat === 'studio-photo') photoModal?.showModal();
          else if (cat === 'reparation-express') repModal?.showModal();
          else if (cat === 'electronique-gaming') gamingModal?.showModal();
          else if (cat === 'boutique-cadeaux') boutiqueModal?.showModal();
          else if (cat === 'bureautique-transferts') bureauModal?.showModal();
        });
        topRow.prepend(btn);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAllServiceModals);
  } else {
    setupAllServiceModals();
  }
</script>


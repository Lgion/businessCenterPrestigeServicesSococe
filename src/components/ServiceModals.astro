---
import { defaultSiteData } from '../data/siteData';
const { business } = defaultSiteData;
const isFullAdmin = Astro.url.pathname.startsWith('/admin');
---

<!-- ================= FLOATING SERVICES DOCK (BOTTOM-LEFT) ================= -->
{!isFullAdmin && (
  <div class="floating-services-dock" id="floating-services-dock" aria-label="Accès rapides aux 5 services">
    <!-- 1. Studio Photo Button -->
    <button 
      type="button" 
      class="quick-fab fab-pole open-photo-trigger" 
      title="Studio Photo Professionnel & Identité"
      aria-label="Ouvrir le Studio Photo"
    >
      <div class="fab-inner">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
          <circle cx="12" cy="13" r="4"></circle>
        </svg>
        <span class="fab-tooltip">1. Studio Photo & Identité</span>
      </div>
    </button>

    <!-- 2. Réparation Express Button -->
    <button 
      type="button" 
      class="quick-fab fab-pole open-reparation-trigger" 
      title="Réparation Express Smartphones & PC"
      aria-label="Ouvrir la Réparation Express"
    >
      <div class="fab-inner">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
          <line x1="12" y1="18" x2="12.01" y2="18"></line>
          <path d="M9 6h6"></path>
          <path d="M12 9v5"></path>
          <path d="M9.5 11.5l5 0"></path>
        </svg>
        <span class="fab-tooltip">2. Réparation Smartphones (30 min)</span>
      </div>
    </button>

    <!-- 3. Gaming & Tech Button -->
    <button 
      type="button" 
      class="quick-fab fab-pole open-gaming-trigger" 
      title="Gaming, Manettes PS4/PS5 & High-Tech"
      aria-label="Ouvrir Gaming et Tech"
    >
      <div class="fab-inner">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="6" width="20" height="12" rx="6"></rect>
          <path d="M6 12h4"></path>
          <path d="M8 10v4"></path>
          <circle cx="15" cy="13" r="1"></circle>
          <circle cx="18" cy="11" r="1"></circle>
        </svg>
        <span class="fab-tooltip">3. Manettes PS4/PS5 & Gaming</span>
      </div>
    </button>

    <!-- 4. Boutique & Maroquinerie Button -->
    <button 
      type="button" 
      class="quick-fab fab-pole open-boutique-trigger" 
      title="Boutique Cadeaux, Montres & Sacs"
      aria-label="Ouvrir la Boutique"
    >
      <div class="fab-inner">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="fab-tooltip">4. Boutique Cadeaux & Maroquinerie</span>
      </div>
    </button>

    <!-- 5. Bureautique & Mobile Money Button -->
    <button 
      type="button" 
      class="quick-fab fab-pole open-bureautique-trigger" 
      title="Bureautique, Démarches & Mobile Money"
      aria-label="Ouvrir Bureautique et Mobile Money"
    >
      <div class="fab-inner">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="fab-tooltip">5. Bureautique & Wave / Mobile Money</span>
      </div>
    </button>
  </div>
)}

<!-- ================= MODAL 1: STUDIO PHOTO & VIDÉO ================= -->
<dialog id="modal-service-photo" class="service-dialog" aria-labelledby="photo-modal-title">
  <div class="service-modal-wrap">
    <div class="service-modal-header">
      <div class="modal-brand-head">
        <span class="modal-head-icon">📸</span>
        <div>
          <h3 id="photo-modal-title" class="modal-head-title font-serif">Studio Photo & Vidéo Professionnel</h3>
          <p class="modal-head-sub">Super U Deux Plateaux • Éclairage de maître, portraits d'art & tirages certifiés</p>
        </div>
      </div>
      <button type="button" class="service-modal-close close-photo-btn" aria-label="Fermer la fenêtre">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="service-modal-body">
      <!-- Notice Banner -->
      <div class="service-banner-box">
        <span class="banner-icon">⚡</span>
        <div>
          <strong>Photos d'identité express en 5 minutes sans rendez-vous au Super U !</strong>
          <p>Pour les shootings portraits artistiques et reportages mariages, réservation conseillée sur WhatsApp pour réserver votre créneau.</p>
        </div>
      </div>

      <!-- Prestations Cards Grid -->
      <div class="service-features-grid">
        <!-- Feature 1 -->
        <div class="modal-feature-card prestige-card">
          <div class="feat-top-row">
            <span class="feat-badge-pill">Prêt en 5 min</span>
            <span class="feat-price font-serif">2 500 FCFA</span>
          </div>
          <h4 class="feat-card-title">Photos d'Identité Certifiées (Planche de 8)</h4>
          <p class="feat-card-desc">Conformes aux normes biométriques strictes : passeport ivoirien et international, visa Schengen / USA, permis de conduire, dossiers scolaires et concours administratifs.</p>
          <ul class="feat-bullets">
            <li>Prise de vue immédiate en cabine professionnelle</li>
            <li>Retouche éclat du teint et anti-brillance incluse</li>
            <li>Envoi numérique haute résolution par WhatsApp offert</li>
          </ul>
          <a href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite faire des photos d\'identité express au studio du Super U.')}`} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm w-100">
            Faire mes photos d'identité
          </a>
        </div>

        <!-- Feature 2 -->
        <div class="modal-feature-card prestige-card highlight-card">
          <div class="feat-top-row">
            <span class="feat-badge-pill gold">Formule Star</span>
            <span class="feat-price font-serif">15 000 FCFA</span>
          </div>
          <h4 class="feat-card-title">Shooting Studio Portrait d'Art (Solo / Corporate)</h4>
          <p class="feat-card-desc">Sublimez votre image personnelle ou professionnelle. Éclairage cinéma sculptant les ombres, fond de décor au choix et coaching en poses.</p>
          <ul class="feat-bullets">
            <li>5 photos retouchées de qualité magazine en HD</li>
            <li>Changement de tenue possible durant la séance</li>
            <li>1 tirage photo grand format A4 offert sur papier d'art</li>
          </ul>
          <a href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver une séance shooting studio portrait à 15 000 FCFA.')}`} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm w-100">
            Réserver mon shooting portrait
          </a>
        </div>

        <!-- Feature 3 -->
        <div class="modal-feature-card prestige-card">
          <div class="feat-top-row">
            <span class="feat-badge-pill">Famille & Couple</span>
            <span class="feat-price font-serif">25 000 FCFA</span>
          </div>
          <h4 class="feat-card-title">Shooting Famille, Grossesse & Bébé</h4>
          <p class="feat-card-desc">Immortalisez les liens précieux avec vos proches dans un espace privatisé, climatisé et confortable au sein du Super U.</p>
          <ul class="feat-bullets">
            <li>10 photos retouchées haute définition remises</li>
            <li>Photos individuelles et photos de groupe incluses</li>
            <li>Mini-album souvenir ou cadre photo offert</li>
          </ul>
          <a href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver une séance photo famille / couple au studio.')}`} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm w-100">
            Réserver la formule famille
          </a>
        </div>

        <!-- Feature 4 -->
        <div class="modal-feature-card prestige-card">
          <div class="feat-top-row">
            <span class="feat-badge-pill">Savoir-faire Rare</span>
            <span class="feat-price font-serif">Dès 5 000 FCFA</span>
          </div>
          <h4 class="feat-card-title">Restauration de Photos Anciennes & Agrandissements</h4>
          <p class="feat-card-desc">Donnez une seconde jeunesse aux souvenirs abîmés par le temps : déchirures, décoloration, humidité ou photos anciennes en noir et blanc.</p>
          <ul class="feat-bullets">
            <li>Numérisation ultra-haute résolution du document</li>
            <li>Retouche minutieuse pixel par pixel & colorisation</li>
            <li>Réimpression d'art et cadrage sur mesure en boutique</li>
          </ul>
          <a href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent('Bonjour, j\'ai une ancienne photo à faire restaurer / agrandir. Voici la photo :')}`} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm w-100">
            Envoyer ma photo à restaurer
          </a>
        </div>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="service-modal-footer">
      <button type="button" class="btn btn-wave open-wave-modal-trigger" data-amount="15000">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
        </svg>
        Régler un acompte Wave
      </button>

      <a href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite un devis personnalisé pour une prestation photo / reportage.')}`} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
        Échanger directement sur WhatsApp
      </a>
    </div>
  </div>
</dialog>

<!-- ================= MODAL 2: RÉPARATION EXPRESS SMARTPHONES ================= -->

---
import { defaultSiteData } from '../data/siteData';
const { wavePayment, business } = defaultSiteData;
---

<dialog id="wave-modal" class="wave-dialog" aria-labelledby="wave-modal-title">
  <div class="wave-modal-wrapper">
    <!-- Header Wave Blue -->
    <div class="wave-header">
      <div class="wave-brand">
        <div class="wave-penguin-icon">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="48" height="48" rx="14" fill="#0086E5"/>
            <!-- Penguin Body -->
            <ellipse cx="24" cy="26" rx="15" ry="17" fill="#111827"/>
            <!-- White Belly -->
            <ellipse cx="24" cy="28" rx="9" ry="13" fill="#FFFFFF"/>
            <!-- Eyes -->
            <circle cx="20" cy="19" r="2.2" fill="#FFFFFF"/>
            <circle cx="28" cy="19" r="2.2" fill="#FFFFFF"/>
            <circle cx="20" cy="19" r="1.1" fill="#111827"/>
            <circle cx="28" cy="19" r="1.1" fill="#111827"/>
            <!-- Beak -->
            <polygon points="21,22 27,22 24,26" fill="#F59E0B"/>
            <!-- Feet -->
            <ellipse cx="19" cy="42" rx="3.5" ry="1.5" fill="#F59E0B"/>
            <ellipse cx="29" cy="42" rx="3.5" ry="1.5" fill="#F59E0B"/>
          </svg>
        </div>
        <div class="wave-header-text">
          <h3 id="wave-modal-title" class="wave-title">Paiement Wave</h3>
          <p class="wave-subtitle">
            <span data-admin-bind="tradeName">{business.name}</span>
            <span class="dot-sep">•</span>
            <span>Deux Plateaux (Super U)</span>
          </p>
        </div>
      </div>
      <button type="button" id="close-wave-btn" class="wave-close-btn" aria-label="Fermer la fenêtre Wave">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Modal Content -->
    <div class="wave-body">
      <!-- Amount Input Block -->
      <div class="amount-field-container">
        <label for="wave-amount-input" class="amount-label">Montant à payer (FCFA)</label>
        <div class="amount-input-box">
          <input 
            type="number" 
            id="wave-amount-input" 
            class="amount-input" 
            value={wavePayment.defaultAmount} 
            min="100" 
            step="500" 
            placeholder="Ex: 10000"
          />
          <span class="currency-tag">FCFA</span>
        </div>
      </div>

      <!-- Quick Preset Pills -->
      <div class="presets-row" role="radiogroup" aria-label="Montants prédéfinis">
        {wavePayment.presetAmounts.map((amt) => (
          <button 
            type="button" 
            class={`preset-pill ${amt === wavePayment.defaultAmount ? 'active' : ''}`}
            data-amount={amt}
          >
            {amt.toLocaleString('fr-FR')} F
          </button>
        ))}
      </div>

      <!-- QR Code Wave Card -->
      <div class="wave-qr-card">
        <div class="qr-header-tag">
          Payez avec 
          <span class="wave-brand-word">wave</span>
        </div>

        <div class="qr-code-box">
          <!-- Precise high quality SVG QR code graphic with dynamic elements -->
          <svg id="wave-qr-svg" class="qr-vector" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="200" height="200" fill="#FFFFFF"/>
            <!-- Corner Finder 1 (Top Left) -->
            <rect x="14" y="14" width="46" height="46" rx="6" fill="#000000"/>
            <rect x="20" y="20" width="34" height="34" rx="4" fill="#FFFFFF"/>
            <rect x="27" y="27" width="20" height="20" rx="3" fill="#000000"/>
            <!-- Corner Finder 2 (Top Right) -->
            <rect x="140" y="14" width="46" height="46" rx="6" fill="#000000"/>
            <rect x="146" y="20" width="34" height="34" rx="4" fill="#FFFFFF"/>
            <rect x="153" y="27" width="20" height="20" rx="3" fill="#000000"/>
            <!-- Corner Finder 3 (Bottom Left) -->
            <rect x="14" y="140" width="46" height="46" rx="6" fill="#000000"/>
            <rect x="20" y="146" width="34" height="34" rx="4" fill="#FFFFFF"/>
            <rect x="27" y="153" width="20" height="20" rx="3" fill="#000000"/>
            <!-- Alignment and QR matrix elements -->
            <rect x="70" y="16" width="8" height="8" rx="1.5" fill="#000000"/>
            <rect x="86" y="16" width="16" height="8" rx="1.5" fill="#000000"/>
            <rect x="110" y="16" width="8" height="16" rx="1.5" fill="#000000"/>
            <rect x="70" y="32" width="16" height="8" rx="1.5" fill="#000000"/>
            <rect x="94" y="32" width="8" height="24" rx="1.5" fill="#000000"/>
            <rect x="118" y="24" width="14" height="14" rx="1.5" fill="#000000"/>
            
            <rect x="16" y="70" width="16" height="8" rx="1.5" fill="#000000"/>
            <rect x="40" y="70" width="8" height="16" rx="1.5" fill="#000000"/>
            <rect x="56" y="70" width="24" height="8" rx="1.5" fill="#000000"/>
            <rect x="88" y="64" width="24" height="8" rx="1.5" fill="#000000"/>
            <rect x="120" y="70" width="16" height="8" rx="1.5" fill="#000000"/>
            <rect x="144" y="70" width="24" height="16" rx="1.5" fill="#000000"/>
            <rect x="176" y="70" width="8" height="24" rx="1.5" fill="#000000"/>

            <!-- Center pattern -->
            <rect x="68" y="86" width="16" height="16" rx="2" fill="#000000"/>
            <rect x="92" y="80" width="16" height="16" rx="2" fill="#0086E5"/>
            <rect x="116" y="86" width="16" height="16" rx="2" fill="#000000"/>
            <rect x="80" y="110" width="40" height="8" rx="1.5" fill="#000000"/>
            
            <rect x="16" y="94" width="24" height="8" rx="1.5" fill="#000000"/>
            <rect x="16" y="110" width="8" height="20" rx="1.5" fill="#000000"/>
            <rect x="32" y="110" width="24" height="8" rx="1.5" fill="#000000"/>
            <rect x="136" y="94" width="32" height="8" rx="1.5" fill="#000000"/>
            <rect x="144" y="110" width="16" height="24" rx="1.5" fill="#000000"/>
            <rect x="168" y="118" width="16" height="8" rx="1.5" fill="#000000"/>

            <!-- Bottom elements -->
            <rect x="70" y="136" width="16" height="16" rx="2" fill="#000000"/>
            <rect x="94" y="126" width="8" height="26" rx="1.5" fill="#000000"/>
            <rect x="110" y="144" width="24" height="8" rx="1.5" fill="#000000"/>
            <rect x="140" y="144" width="16" height="16" rx="2" fill="#000000"/>
            <rect x="164" y="144" width="20" height="8" rx="1.5" fill="#000000"/>
            <rect x="70" y="168" width="32" height="8" rx="1.5" fill="#000000"/>
            <rect x="110" y="160" width="16" height="24" rx="1.5" fill="#000000"/>
            <rect x="134" y="168" width="24" height="8" rx="1.5" fill="#000000"/>
            <rect x="166" y="160" width="18" height="18" rx="2" fill="#000000"/>
          </svg>
        </div>

        <div class="qr-amount-pill">
          <span id="qr-live-amount">10 000 FCFA</span>
        </div>

        <div class="qr-partners-text">
          PARTENAIRES AGRÉÉS : {wavePayment.partnerBanks}
        </div>
      </div>

      <!-- Instructions List (1, 2, 3) -->
      <ol class="wave-steps">
        <li class="wave-step">
          <span class="step-num">1</span>
          <span class="step-desc">Ouvrez l'application <strong>Wave Côte d'Ivoire</strong> sur votre smartphone.</span>
        </li>
        <li class="wave-step">
          <span class="step-num">2</span>
          <span class="step-desc">Appuyez sur <strong>Scanner</strong> et visez ce QR code.</span>
        </li>
        <li class="wave-step">
          <span class="step-num">3</span>
          <span class="step-desc">Validez le règlement pour <strong>Business Center Prestige Services</strong>.</span>
        </li>
      </ol>

      <!-- Action Buttons -->
      <div class="wave-actions">
        <a 
          href={`https://wave.com/pay/?phone=${wavePayment.merchantPhone}&amount=${wavePayment.defaultAmount}`} 
          id="wave-open-mobile-btn" 
          class="btn-wave-main" 
          target="_blank" 
          rel="noopener noreferrer"
        >
          <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
          Ouvrir dans Wave (Mobile)
        </a>

        <button type="button" id="wave-copy-btn" class="btn-wave-copy">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copier lien
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Modal Base */
  .wave-dialog {
    margin: auto;
    border: none;
    border-radius: 26px;
    padding: 0;
    background: transparent;
    max-width: 440px;
    width: 92%;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(0, 134, 229, 0.25);
    overflow: hidden;
  }

  .wave-dialog::backdrop {
    background: rgba(4, 11, 22, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .wave-modal-wrapper {
    background: #ffffff;
    color: #1e293b;
    border-radius: 26px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Header Wave */
  .wave-header {
    background: #0086e5;
    padding: 1.25rem 1.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #ffffff;
  }

  .wave-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .wave-penguin-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .wave-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
  }

  .wave-subtitle {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.15rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dot-sep {
    opacity: 0.7;
  }

  .wave-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .wave-close-btn:hover {
    background: rgba(255, 255, 255, 0.35);
    transform: rotate(90deg);
  }

  /* Body */
  .wave-body {
    padding: 1.4rem 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: #fafbfc;
  }

  .amount-field-container {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .amount-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
  }

  .amount-input-box {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.45rem 1rem;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
    transition: border-color 0.2s ease;
  }

  .amount-input-box:focus-within {
    border-color: #0086e5;
    box-shadow: 0 0 0 3px rgba(0, 134, 229, 0.15);
  }

  .amount-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.4rem;
    font-weight: 800;
    color: #0f172a;
    background: transparent;
  }

  .currency-tag {
    font-size: 0.95rem;
    font-weight: 700;
    color: #64748b;
  }

  /* Preset Pills */
  .presets-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .preset-pill {
    padding: 0.55rem 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    transition: all 0.18s ease;
    text-align: center;
  }

  .preset-pill:hover {
    border-color: #0086e5;
    color: #0086e5;
  }

  .preset-pill.active {
    background: #0086e5;
    color: #ffffff;
    border-color: #0086e5;
    box-shadow: 0 4px 12px rgba(0, 134, 229, 0.3);
  }

  /* QR Card */
  .wave-qr-card {
    background: #ffffff;
    border: 1.5px solid #0086e5;
    border-radius: 18px;
    padding: 1.2rem 1rem 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 6px 18px rgba(0, 134, 229, 0.08);
  }

  .qr-header-tag {
    font-size: 0.95rem;
    color: #475569;
    font-weight: 600;
    margin-bottom: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .wave-brand-word {
    color: #0086e5;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.15rem;
  }

  .qr-code-box {
    width: 170px;
    height: 170px;
    background: #ffffff;
    padding: 6px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-vector {
    width: 100%;
    height: 100%;
  }

  .qr-amount-pill {
    margin-top: 0.75rem;
    background: #e6f4fd;
    color: #0086e5;
    border-radius: 9999px;
    padding: 0.35rem 1.2rem;
    font-weight: 800;
    font-size: 1.05rem;
    font-family: var(--font-serif);
    box-shadow: 0 2px 6px rgba(0, 134, 229, 0.12);
  }

  .qr-partners-text {
    margin-top: 0.7rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  /* Steps */
  .wave-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.2rem 0;
  }

  .wave-step {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.84rem;
    color: #475569;
    line-height: 1.4;
  }

  .step-num {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid #0086e5;
    color: #0086e5;
    font-size: 0.72rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .wave-step strong {
    color: #0f172a;
  }

  /* Actions */
  .wave-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.3rem;
  }

  .btn-wave-main {
    flex: 1.4;
    background: #0086e5;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    box-shadow: 0 4px 14px rgba(0, 134, 229, 0.35);
    transition: all 0.2s ease;
  }

  .btn-wave-main:hover {
    background: #0077cc;
    transform: translateY(-2px);
  }

  .play-icon {
    width: 18px;
    height: 18px;
  }

  .btn-wave-copy {
    flex: 1;
    background: #ffffff;
    color: #0f172a;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1.5px solid #cbd5e1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    transition: all 0.2s ease;
  }

  .btn-wave-copy:hover {
    border-color: #0086e5;
    color: #0086e5;
    background: #f8fafc;
  }
</style>

<script>
  function setupWaveModal() {
    const dialog = document.getElementById('wave-modal') as HTMLDialogElement;
    const closeBtn = document.getElementById('close-wave-btn');
    const amountInput = document.getElementById('wave-amount-input') as HTMLInputElement;
    const qrAmountText = document.getElementById('qr-live-amount');
    const mobilePayBtn = document.getElementById('wave-open-mobile-btn') as HTMLAnchorElement;
    const copyBtn = document.getElementById('wave-copy-btn');
    const presetBtns = document.querySelectorAll('.preset-pill');

    if (!dialog) return;

    // Open Wave Modal Trigger
    document.querySelectorAll('.open-wave-modal-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      });
    });

    // Close button
    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    // Backdrop click close
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        dialog.close();
      }
    });

    // Handle Amount Updates
    function updateWaveAmount(amount: number) {
      if (amountInput) amountInput.value = amount.toString();
      if (qrAmountText) {
        qrAmountText.textContent = `${amount.toLocaleString('fr-FR')} FCFA`;
      }
      if (mobilePayBtn) {
        mobilePayBtn.href = `https://wave.com/pay/?phone=0544263245&amount=${amount}`;
      }
      
      // Update preset pills active state
      presetBtns.forEach(btn => {
        const btnAmt = parseInt(btn.getAttribute('data-amount') || '0', 10);
        if (btnAmt === amount) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    amountInput?.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value || '0', 10);
      updateWaveAmount(val);
    });

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const amt = parseInt(btn.getAttribute('data-amount') || '10000', 10);
        updateWaveAmount(amt);
      });
    });

    // Copy Wave Link
    copyBtn?.addEventListener('click', async () => {
      const amt = amountInput ? amountInput.value : '10000';
      const link = `https://wave.com/pay/?phone=0544263245&amount=${amt}`;
      try {
        await navigator.clipboard.writeText(link);
        if ((window as any).showToast) {
          (window as any).showToast('Lien de paiement Wave copié dans le presse-papiers !', '💙');
        }
      } catch (err) {
        console.error('Clipboard copy failed', err);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupWaveModal);
</script>

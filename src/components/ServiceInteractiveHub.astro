<script>
  function setupInteractiveHub() {
    // 1. Responsive Grid Tab switching with dynamic themed backdrops
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.hub-tab-btn, .arc-pill');
    const panels = document.querySelectorAll<HTMLElement>('.hub-panel');
    const themeBgs = document.querySelectorAll<HTMLElement>('.hub-theme-bg');
    const panelsBox = document.getElementById('hub-panels-box');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-hub-target');
        if (!target) return;

        // Update active tab buttons
        tabBtns.forEach(b => {
          const isActive = b.getAttribute('data-hub-target') === target;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Switch active panel
        panels.forEach(pan => {
          pan.classList.toggle('active', pan.getAttribute('data-panel-name') === target);
        });

        // Switch dynamic ambient backdrop
        themeBgs.forEach(bg => {
          bg.classList.toggle('active', bg.classList.contains(`bg-${target}`));
        });

        // Set data attribute on panels box for any theme-specific styling
        if (panelsBox) {
          panelsBox.setAttribute('data-active-theme', target);
        }
      });
    });

    // 2. Studio Photo File Input Display & Yango Delivery Toggle
    const studioFileInput = document.getElementById('studio-file-input') as HTMLInputElement;
    const studioFileNameDisplay = document.getElementById('studio-file-name');
    studioFileInput?.addEventListener('change', () => {
      if (studioFileInput.files && studioFileInput.files[0]) {
        if (studioFileNameDisplay) studioFileNameDisplay.textContent = `Fichier sélectionné : ${studioFileInput.files[0].name}`;
      }
    });

    const studioYangoToggle = document.getElementById('studio-yango-toggle') as HTMLInputElement;
    const studioYangoSubfield = document.getElementById('studio-yango-subfield');
    studioYangoToggle?.addEventListener('change', () => {
      studioYangoSubfield?.classList.toggle('hidden', !studioYangoToggle.checked);
    });

    // Studio form submit (Upload to Cloudinary + MongoDB)
    const studioForm = document.getElementById('studio-upload-form') as HTMLFormElement;
    studioForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('btn-studio-submit') as HTMLButtonElement;
      const resMsg = document.getElementById('studio-result-msg');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Envoi vers Cloudinary...';
      }

      const clientName = (document.getElementById('studio-client-name') as HTMLInputElement)?.value;
      const clientPhone = (document.getElementById('studio-client-phone') as HTMLInputElement)?.value;
      const serviceType = (document.getElementById('studio-service-type') as HTMLSelectElement)?.value;
      const urlInput = (document.getElementById('studio-url-input') as HTMLInputElement)?.value;
      const file = studioFileInput?.files?.[0];
      const withDelivery = studioYangoToggle?.checked || false;
      const deliveryAddress = (document.getElementById('studio-yango-address') as HTMLInputElement)?.value || '';

      try {
        let fetchRes;
        if (file) {
          const fd = new FormData();
          fd.append('file', file);
          fd.append('customerName', clientName);
          fd.append('customerPhone', clientPhone);
          fd.append('serviceType', serviceType);
          fd.append('instructions', withDelivery ? `Livraison Yango demandée à: ${deliveryAddress}` : 'Retrait boutique Super U');
          fetchRes = await fetch('/api/upload/photo', { method: 'POST', body: fd });
        } else if (urlInput) {
          fetchRes = await fetch('/api/upload/photo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              imageUrl: urlInput,
              customerName: clientName,
              customerPhone: clientPhone,
              serviceType,
              instructions: withDelivery ? `Livraison Yango demandée à: ${deliveryAddress}` : 'Retrait boutique Super U'
            })
          });
        } else {
          alert('Veuillez sélectionner un fichier ou renseigner une URL d\'image.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Transférer & Valider au Studio';
          }
          return;
        }

        const data = await fetchRes.json();
        if (data.success) {
          if (resMsg) {
            resMsg.className = 'result-msg success';
            resMsg.innerHTML = `✅ <strong>Photo transmise avec succès au laboratoire Super U !</strong><br/>Référence Cloudinary enregistrée. ${withDelivery ? 'Option livraison Yango transmise.' : 'Retrait prévu au centre commercial.'} Nous vous contactons au ${clientPhone}.`;
          }
        } else {
          throw new Error(data.error);
        }
      } catch (err: any) {
        if (resMsg) {
          resMsg.className = 'result-msg error';
          resMsg.textContent = `Erreur: ${err.message || 'Échec de transmission'}`;
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Transférer & Valider au Studio';
        }
      }
    });

    // 3. Interactive Leaflet Map & Distance Calculation for Yango
    const SUPER_U_COORDS: [number, number] = [5.362692, -3.998493]; // Super U Deux Plateaux
    let leafletMap: any = null;
    let clientMarker: any = null;
    let selectedLat = SUPER_U_COORDS[0];
    let selectedLng = SUPER_U_COORDS[1];
    let currentDistanceKm = 1.5;
    let currentTierFee = 1500;
    let currentTierName = "Cocody Deux Plateaux / Vallon / Aghien";

    // Haversine Distance formula in km
    function computeDistanceKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
      const R = 6371; // Rayon Terre en km
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = 
        Math.sin(dLat/2) * Math.sin(dLat/2) +
        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
        Math.sin(dLon/2) * Math.sin(dLon/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return Math.round((R * c) * 10) / 10;
    }

    function determineTier(distance: number): { fee: number; name: string } {
      if (distance <= 3.0) {
        return { fee: 1500, name: "Cocody Deux Plateaux / Vallon / Aghien (0 - 3 km)" };
      } else if (distance <= 8.0) {
        return { fee: 2500, name: "Riviera 2, 3, 4, Palmeraie, Bonoumin (3 - 8 km)" };
      } else if (distance <= 15.0) {
        return { fee: 3500, name: "Plateau / Adjamé / Marcory / Zone 4 (8 - 15 km)" };
      } else {
        return { fee: 5000, name: "Yopougon / Koumassi / Port-Bouët / Bingerville (15+ km)" };
      }
    }

    function initLeafletMapIfNeeded() {
      const mapContainer = document.getElementById('yango-leaflet-map');
      if (!mapContainer || leafletMap || !(window as any).L) return;

      const L = (window as any).L;
      leafletMap = L.map('yango-leaflet-map').setView(SUPER_U_COORDS, 13);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
      }).addTo(leafletMap);

      // Marker for Super U
      const superUIcon = L.divIcon({
        className: 'super-u-map-icon',
        html: '<div style="background:#d4af37; color:#061120; font-weight:900; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; box-shadow:0 0 10px #d4af37; border:2px solid #fff;">U</div>',
        iconSize: [28, 28],
        iconAnchor: [14, 14]
      });
      L.marker(SUPER_U_COORDS, { icon: superUIcon }).addTo(leafletMap).bindPopup("<strong>Super U Deux Plateaux</strong><br/>Atelier Prestige Services").openPopup();

      // Client Location marker (draggable)
      const clientIcon = L.divIcon({
        className: 'client-map-icon',
        html: '<div style="background:#ef4444; color:#fff; font-weight:900; border-radius:50%; width:26px; height:26px; display:flex; align-items:center; justify-content:center; box-shadow:0 0 12px rgba(239,68,68,0.8); border:2px solid #fff;">📍</div>',
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const initialClientPos: [number, number] = [5.368, -4.005];
      clientMarker = L.marker(initialClientPos, { draggable: true, icon: clientIcon }).addTo(leafletMap);

      function onPositionUpdated(lat: number, lng: number) {
        selectedLat = lat;
        selectedLng = lng;
        currentDistanceKm = computeDistanceKm(SUPER_U_COORDS[0], SUPER_U_COORDS[1], lat, lng);
        const tier = determineTier(currentDistanceKm);
        currentTierFee = tier.fee;
        currentTierName = tier.name;

        const distEl = document.getElementById('calc-distance-km');
        const zoneEl = document.getElementById('calc-zone-name');
        if (distEl) distEl.textContent = `${currentDistanceKm} km`;
        if (zoneEl) zoneEl.textContent = `${currentTierName} (${currentTierFee.toLocaleString('fr-FR')} F / trajet)`;

        updateRepairEstimate();
      }

      clientMarker.on('dragend', () => {
        const pos = clientMarker.getLatLng();
        onPositionUpdated(pos.lat, pos.lng);
      });

      leafletMap.on('click', (e: any) => {
        clientMarker.setLatLng(e.latlng);
        onPositionUpdated(e.latlng.lat, e.latlng.lng);
      });

      onPositionUpdated(initialClientPos[0], initialClientPos[1]);
    }

    // Geolocation button
    document.getElementById('btn-locate-me')?.addEventListener('click', () => {
      if (navigator.geolocation && leafletMap && clientMarker) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            clientMarker.setLatLng([lat, lng]);
            leafletMap.setView([lat, lng], 14);
            selectedLat = lat;
            selectedLng = lng;
            currentDistanceKm = computeDistanceKm(SUPER_U_COORDS[0], SUPER_U_COORDS[1], lat, lng);
            const tier = determineTier(currentDistanceKm);
            currentTierFee = tier.fee;
            currentTierName = tier.name;

            const distEl = document.getElementById('calc-distance-km');
            const zoneEl = document.getElementById('calc-zone-name');
            if (distEl) distEl.textContent = `${currentDistanceKm} km`;
            if (zoneEl) zoneEl.textContent = `${currentTierName} (${currentTierFee.toLocaleString('fr-FR')} F / trajet)`;

            updateRepairEstimate();
          },
          () => alert("Impossible d'obtenir la position GPS actuelle. Vous pouvez cliquer directement sur la carte.")
        );
      }
    });

    // 4. Dual Yango Toggles in Tech Repair
    const pickupToggle = document.getElementById('repair-pickup-toggle') as HTMLInputElement;
    const returnToggle = document.getElementById('repair-return-toggle') as HTMLInputElement;
    const mapSubform = document.getElementById('repair-yango-map-subform');
    const repairIssueSelect = document.getElementById('repair-issue') as HTMLSelectElement;
    const totalDisplay = document.getElementById('repair-total-display');
    const baseDisplay = document.getElementById('repair-base-display');
    const courseDisplay = document.getElementById('repair-course-display');

    function updateRepairEstimate() {
      const issueOption = repairIssueSelect?.selectedOptions[0];
      const basePrice = parseInt(issueOption?.getAttribute('data-est') || '15000', 10);
      
      const withPickup = pickupToggle?.checked || false;
      const withReturn = returnToggle?.checked || false;
      const coursesCount = (withPickup ? 1 : 0) + (withReturn ? 1 : 0);
      const totalYangoFee = coursesCount * currentTierFee;

      if (withPickup || withReturn) {
        mapSubform?.classList.remove('hidden');
        if (leafletMap) {
          setTimeout(() => leafletMap.invalidateSize(), 150);
        } else {
          setTimeout(initLeafletMapIfNeeded, 100);
        }
      } else {
        mapSubform?.classList.add('hidden');
      }

      if (baseDisplay) baseDisplay.textContent = `Intervention : ${basePrice.toLocaleString('fr-FR')} F`;
      if (courseDisplay) {
        if (coursesCount > 0) {
          courseDisplay.classList.remove('hidden');
          courseDisplay.textContent = `+ Coursier (${coursesCount} trajet${coursesCount > 1 ? 's' : ''}) : ${totalYangoFee.toLocaleString('fr-FR')} F`;
        } else {
          courseDisplay.classList.add('hidden');
        }
      }

      const total = basePrice + totalYangoFee;
      if (totalDisplay) {
        totalDisplay.textContent = `${total.toLocaleString('fr-FR')} FCFA`;
      }
    }

    pickupToggle?.addEventListener('change', updateRepairEstimate);
    returnToggle?.addEventListener('change', updateRepairEstimate);
    repairIssueSelect?.addEventListener('change', updateRepairEstimate);

    // Tab button click for "reparation" initializes map once visible
    document.querySelectorAll('[data-hub-target="reparation"]').forEach(btn => {
      btn.addEventListener('click', () => {
        setTimeout(() => {
          if ((pickupToggle?.checked || returnToggle?.checked) && leafletMap) {
            leafletMap.invalidateSize();
          }
        }, 200);
      });
    });

    // Repair form submit (PayDunya checkout)
    const repairForm = document.getElementById('repair-order-form') as HTMLFormElement;
    repairForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payBtn = document.getElementById('btn-repair-pay') as HTMLButtonElement;
      if (payBtn) {
        payBtn.disabled = true;
        payBtn.textContent = 'Ouverture du paiement...';
      }

      const deviceType = (document.getElementById('repair-device-type') as HTMLSelectElement)?.value || 'smartphone';
      const brand = (document.getElementById('repair-brand') as HTMLSelectElement)?.value;
      const model = (document.getElementById('repair-model') as HTMLInputElement)?.value;
      const issue = repairIssueSelect?.selectedOptions[0]?.text;
      const withPickup = pickupToggle?.checked || false;
      const withReturn = returnToggle?.checked || false;
      const address = (document.getElementById('repair-pickup-address') as HTMLInputElement)?.value || '';
      const name = (document.getElementById('repair-client-name') as HTMLInputElement)?.value;
      const phone = (document.getElementById('repair-client-phone') as HTMLInputElement)?.value;

      const issuePrice = parseInt(repairIssueSelect?.selectedOptions[0]?.getAttribute('data-est') || '15000', 10);
      const coursesCount = (withPickup ? 1 : 0) + (withReturn ? 1 : 0);
      const totalYangoFee = coursesCount * currentTierFee;
      const total = issuePrice + totalYangoFee;

      try {
        // Save to MongoDB
        await fetch('/api/repair/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            brand,
            model,
            issue,
            deviceType,
            withPickup,
            withReturn,
            clientLat: selectedLat,
            clientLng: selectedLng,
            distanceKm: currentDistanceKm,
            yangoTierName: currentTierName,
            yangoFee: currentTierFee,
            pickupAddress: address,
            customerName: name,
            customerPhone: phone,
            estimatedPrice: issuePrice
          })
        });

        // Trigger PayDunya checkout tunnel
        const items = [
          { name: `Diagnostic & Réparation ${brand} ${model}`, quantity: 1, unit_price: issuePrice, total_price: issuePrice }
        ];
        if (withPickup) {
          items.push({ name: `Collecte Yango aller (${currentTierName})`, quantity: 1, unit_price: currentTierFee, total_price: currentTierFee });
        }
        if (withReturn) {
          items.push({ name: `Livraison Yango retour (${currentTierName})`, quantity: 1, unit_price: currentTierFee, total_price: currentTierFee });
        }

        const checkoutRes = await fetch('/api/checkout/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            category: 'reparation',
            title: `Réparation ${brand} ${model} ${coursesCount > 0 ? `+ Coursier (${coursesCount} trajet)` : ''}`,
            amount: total,
            customerName: name,
            customerPhone: phone,
            pickupType: coursesCount > 0 ? 'yango' : 'comptoir',
            deliveryAddress: address,
            items
          })
        });

        const chData = await checkoutRes.json();
        if (chData.success && chData.paymentUrl) {
          window.location.href = chData.paymentUrl;
        } else {
          throw new Error(chData.error || 'Erreur paiement');
        }
      } catch (err: any) {
        alert(`Erreur: ${err.message}`);
        if (payBtn) {
          payBtn.disabled = false;
          payBtn.textContent = '💳 Payer en Ligne (PayDunya)';
        }
      }
    });

    // 5. Bureautique & PAO Form with File Upload & Yango
    const printFileInput = document.getElementById('print-file-input') as HTMLInputElement;
    const printFileNameDisplay = document.getElementById('print-file-name');
    printFileInput?.addEventListener('change', () => {
      if (printFileInput.files && printFileInput.files[0]) {
        if (printFileNameDisplay) printFileNameDisplay.textContent = `Fichier prêt : ${printFileInput.files[0].name}`;
      }
    });

    const printYangoToggle = document.getElementById('print-yango-toggle') as HTMLInputElement;
    const printYangoSubfield = document.getElementById('print-yango-subfield');
    printYangoToggle?.addEventListener('change', () => {
      printYangoSubfield?.classList.toggle('hidden', !printYangoToggle.checked);
    });

    const printForm = document.getElementById('print-order-form') as HTMLFormElement;
    printForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payBtn = document.getElementById('btn-print-pay') as HTMLButtonElement;
      const resMsg = document.getElementById('print-result-msg');
      if (payBtn) {
        payBtn.disabled = true;
        payBtn.textContent = 'Envoi et préparation du paiement...';
      }

      const printSelect = document.getElementById('print-type') as HTMLSelectElement;
      const printTitle = printSelect?.selectedOptions[0]?.text;
      const printPrice = parseInt(printSelect?.selectedOptions[0]?.getAttribute('data-price') || '2500', 10);
      const instructions = (document.getElementById('print-quantity') as HTMLInputElement)?.value;
      const name = (document.getElementById('print-name') as HTMLInputElement)?.value;
      const phone = (document.getElementById('print-phone') as HTMLInputElement)?.value;
      const withDelivery = printYangoToggle?.checked || false;
      const deliveryAddress = (document.getElementById('print-yango-address') as HTMLInputElement)?.value || '';
      const file = printFileInput?.files?.[0];

      try {
        let uploadedUrl = '';
        if (file) {
          const fd = new FormData();
          fd.append('file', file);
          fd.append('customerName', name);
          fd.append('customerPhone', phone);
          fd.append('serviceType', printSelect.value);
          fd.append('instructions', instructions);
          fd.append('withDelivery', withDelivery.toString());
          fd.append('deliveryAddress', deliveryAddress);

          const upRes = await fetch('/api/upload/document', { method: 'POST', body: fd });
          const upData = await upRes.json();
          if (!upData.success) throw new Error(upData.error || 'Échec upload document');
          uploadedUrl = upData.secureUrl;
        }

        // Checkout tunnel
        const deliveryFee = withDelivery ? 1500 : 0;
        const total = printPrice + deliveryFee;

        const res = await fetch('/api/checkout/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            category: 'imprimerie',
            title: `Bureautique/PAO: ${printTitle}`,
            amount: total,
            customerName: name,
            customerPhone: phone,
            deliveryAddress: withDelivery ? deliveryAddress : '',
            items: [
              { name: `${printTitle} (${instructions})`, quantity: 1, unit_price: printPrice, total_price: printPrice },
              ...(withDelivery ? [{ name: 'Livraison Yango Document', quantity: 1, unit_price: 1500, total_price: 1500 }] : [])
            ]
          })
        });

        const data = await res.json();
        if (data.success && data.paymentUrl) {
          window.location.href = data.paymentUrl;
        } else {
          if (resMsg) {
            resMsg.className = 'result-msg success';
            resMsg.innerHTML = `✅ <strong>Document transmis au laboratoire Bureautique Super U !</strong><br/>Nous préparons vos tirages. Contact au ${phone}.`;
          }
        }
      } catch (err: any) {
        alert(`Erreur: ${err.message}`);
        if (payBtn) {
          payBtn.disabled = false;
          payBtn.textContent = 'Envoyer & Payer en Ligne';
        }
      }
    });

    // 6. Gaming Callback Form
    const cbForm = document.getElementById('gaming-callback-form') as HTMLFormElement;
    cbForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const item = (document.getElementById('cb-item-name') as HTMLInputElement)?.value;
      const phone = (document.getElementById('cb-phone') as HTMLInputElement)?.value;
      const resMsg = document.getElementById('cb-result-msg');

      try {
        const res = await fetch('/api/gaming/callback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ itemName: item, customerPhone: phone })
        });
        const data = await res.json();
        if (data.success && resMsg) {
          resMsg.className = 'result-msg success';
          resMsg.textContent = '✅ Demande enregistrée ! Notre conseiller vous appelle sous 15 minutes.';
          cbForm.reset();
        }
      } catch (e) {
        if (resMsg) {
          resMsg.className = 'result-msg error';
          resMsg.textContent = 'Erreur lors de l\'enregistrement.';
        }
      }
    });

    // 7. FastPass Form submit
    const fpForm = document.getElementById('fastpass-form') as HTMLFormElement;
    fpForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const op = (document.getElementById('fp-operation') as HTMLSelectElement)?.value;
      const oper = (document.getElementById('fp-operator') as HTMLSelectElement)?.value;
      const amount = parseInt((document.getElementById('fp-amount') as HTMLInputElement)?.value || '0', 10);
      const recipient = (document.getElementById('fp-recipient') as HTMLInputElement)?.value;
      const phone = (document.getElementById('fp-phone') as HTMLInputElement)?.value;
      const resMsg = document.getElementById('fp-result-msg');

      try {
        const res = await fetch('/api/fastpass/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            operationType: op,
            operator: oper,
            amount,
            recipientPhone: recipient,
            customerPhone: phone
          })
        });

        const data = await res.json();
        if (data.success && resMsg) {
          resMsg.className = 'result-msg success';
          resMsg.innerHTML = `🎉 <strong>Code Coupe-File VIP généré : <span style="font-size:1.2rem; color:#d4af37;">${data.fastpassCode}</span></strong><br/>Présentez ce code directement au guichet Super U Deux Plateaux pour passer prioritairement sans attente.`;
        }
      } catch (e: any) {
        if (resMsg) {
          resMsg.className = 'result-msg error';
          resMsg.textContent = 'Échec de génération du code.';
        }
      }
    });

    // 8. Open Boutique Modal triggers from hub
    document.querySelectorAll('.open-boutique-modal-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const modal = document.getElementById('boutique-modal') as HTMLDialogElement;
        const cat = btn.getAttribute('data-filter-cat');
        if (modal) {
          modal.showModal();
          if (cat) {
            const filterBtn = modal.querySelector(`[data-cat-filter="${cat}"]`) as HTMLButtonElement;
            filterBtn?.click();
          }
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupInteractiveHub);
</script>

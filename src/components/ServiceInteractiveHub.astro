---
import { defaultSiteData } from '../data/siteData';
import { getAssetPath } from '../utils/assets';

const { business, yangoDelivery, services } = defaultSiteData;
---

<section class="interactive-hub-section" id="service-hub">
  <div class="container hub-container">
    <!-- Header of the Interactive Hub -->
    <div class="hub-header text-center">
      <span class="section-tagline">Interaction Directe & Services Express</span>
      <h2 class="section-title">
        Espace Démarches & <span class="gold-gradient-text">Réservations en Ligne</span>
      </h2>
      <p class="section-subtitle">
        Sélectionnez votre univers ci-dessous pour déclencher vos démarches, planifier une collecte coursier ou transférer vos fichiers.
      </p>

      <!-- Menu Non-Défilant : Grille Responsive des 5 Pôles -->
      <div class="hub-tabs-container" role="tablist" aria-label="Sélectionnez un pôle de service">
        <div class="hub-tabs-grid" id="hub-tabs-grid">
          <button type="button" class="hub-tab-btn active" data-hub-target="studio" role="tab" aria-selected="true">
            <span class="tab-btn-icon">📸</span>
            <div class="tab-btn-texts">
              <span class="tab-btn-title">Studio Photo Pro</span>
              <span class="tab-btn-badge">Tirages & Identité</span>
            </div>
          </button>

          <button type="button" class="hub-tab-btn" data-hub-target="reparation" role="tab" aria-selected="false">
            <span class="tab-btn-icon">⚡</span>
            <div class="tab-btn-texts">
              <span class="tab-btn-title">Réparation Express</span>
              <span class="tab-btn-badge">Option Yango 30min</span>
            </div>
          </button>

          <button type="button" class="hub-tab-btn" data-hub-target="boutique" role="tab" aria-selected="false">
            <span class="tab-btn-icon">🛍️</span>
            <div class="tab-btn-texts">
              <span class="tab-btn-title">Boutique</span>
              <span class="tab-btn-badge">High-Tech & Maroquinerie</span>
            </div>
          </button>

          <button type="button" class="hub-tab-btn" data-hub-target="bureautique" role="tab" aria-selected="false">
            <span class="tab-btn-icon">🖨️</span>
            <div class="tab-btn-texts">
              <span class="tab-btn-title">Bureautique & PAO</span>
              <span class="tab-btn-badge">Impression & Flyers</span>
            </div>
          </button>

          <button type="button" class="hub-tab-btn" data-hub-target="mobile-money" role="tab" aria-selected="false">
            <span class="tab-btn-icon">📱</span>
            <div class="tab-btn-texts">
              <span class="tab-btn-title">Mobile Money</span>
              <span class="tab-btn-badge">Wave • Orange • MTN</span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <!-- The 5 Dynamic Interactive Panels with Dynamic Thematic Backgrounds -->
    <div class="hub-panels-box prestige-card" id="hub-panels-box" data-active-theme="studio">
      <!-- Background Ambient Layers (cross-fade on tab switch) -->
      <div class="hub-dynamic-backdrop-container" aria-hidden="true">
        <div class="hub-theme-bg bg-studio active"></div>
        <div class="hub-theme-bg bg-reparation"></div>
        <div class="hub-theme-bg bg-boutique"></div>
        <div class="hub-theme-bg bg-bureautique"></div>
        <div class="hub-theme-bg bg-mobilemoney"></div>
        <div class="hub-backdrop-overlay"></div>
      </div>
      
      <!-- ================= 1. PANNEAU STUDIO PHOTO ================= -->
      <div class="hub-panel active" id="panel-studio" data-panel-name="studio">
        <div class="panel-grid">
          <div class="panel-info">
            <div class="panel-badge-row">
              <span class="gold-badge">📸 Pôle 01 • Studio Photo</span>
              <span class="live-pill">Prêt en 5 min au Super U</span>
            </div>
            <h3 class="panel-title font-serif">Transférez vos photos & Commandez vos tirages</h3>
            <p class="panel-desc">
              Besoin d'un tirage haute définition, d'une photo d'identité certifiée ou d'une restauration d'image ancienne ? Téléversez votre photo ou indiquez son lien, nous la traitons directement au laboratoire.
            </p>
            <ul class="panel-perks">
              <li>✨ Tirage argentique HD résistant au temps</li>
              <li>⚡ Normes biométriques pour passeports & visas</li>
              <li>🎨 Restauration d'art & retouche lumière professionnelle</li>
            </ul>
          </div>

          <div class="panel-form-box">
            <form id="studio-upload-form" class="hub-form">
              <div class="form-group">
                <label>Prestation souhaitée</label>
                <select id="studio-service-type" class="hub-select">
                  <option value="photo_identite">Photos d'Identité Express (Planche de 8 - 2 500 F)</option>
                  <option value="tirage_hd">Tirage Photo Haute Définition A4 / A3</option>
                  <option value="restauration">Restauration Photo Ancienne / Retouche</option>
                  <option value="shooting_studio">Réservation Séance Shooting Studio (15 000 F)</option>
                </select>
              </div>

              <!-- Drag & Drop Cloudinary File Upload -->
              <div class="form-group">
                <label>Téléverser votre photo (depuis votre appareil)</label>
                <div class="dropzone-area" id="studio-dropzone">
                  <input type="file" id="studio-file-input" accept="image/*" class="dropzone-input" />
                  <div class="dropzone-content">
                    <span class="dropzone-icon">📁</span>
                    <span class="dropzone-text" id="studio-file-name">Cliquez ou glissez une image ici</span>
                    <span class="dropzone-hint">JPG, PNG, WEBP (Max 15 Mo) • Traité via Cloudinary</span>
                  </div>
                </div>
              </div>

              <!-- Or External URL -->
              <div class="form-group">
                <label>Ou URL d'image externe (Cloudinary / Web)</label>
                <input type="url" id="studio-url-input" class="hub-input" placeholder="https://res.cloudinary.com/... ou lien web" />
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label>Votre Nom</label>
                  <input type="text" id="studio-client-name" class="hub-input" placeholder="Ex: Kouamé Marc" required />
                </div>
                <div class="form-group">
                  <label>Numéro WhatsApp</label>
                  <input type="tel" id="studio-client-phone" class="hub-input" placeholder="+225 07..." required />
                </div>
              </div>

              <!-- Option Livraison Yango Tirages -->
              <div class="form-group yango-delivery-mini-box">
                <label class="custom-checkbox-row">
                  <input type="checkbox" id="studio-yango-toggle" />
                  <span class="checkbox-label-text">
                    <strong>🛵 Me faire livrer mes tirages / cadres à domicile par coursier Yango</strong>
                  </span>
                </label>
                <div id="studio-yango-subfield" class="yango-details hidden" style="margin-top: 0.5rem;">
                  <input type="text" id="studio-yango-address" class="hub-input" placeholder="Votre adresse exacte de livraison à Abidjan" />
                </div>
              </div>

              <div class="form-actions-row">
                <button type="submit" id="btn-studio-submit" class="btn btn-gold w-100">
                  <span>Transférer & Valider au Studio</span>
                </button>
              </div>

              <div id="studio-result-msg" class="result-msg hidden"></div>
            </form>
          </div>
        </div>
      </div>

      <!-- ================= 2. PANNEAU RÉPARATION TECH & YANGO ================= -->
      <div class="hub-panel" id="panel-reparation" data-panel-name="reparation">
        <div class="panel-grid">
          <div class="panel-info">
            <div class="panel-badge-row">
              <span class="gold-badge">⚡ Pôle 02 • Réparation Express</span>
              <span class="live-pill yango-pill">🛵 Option Coursier Yango Actif</span>
            </div>
            <h3 class="panel-title font-serif">Diagnostic & Prise en Charge Équipements Tech</h3>
            <p class="panel-desc">
              Écran fissuré, batterie épuisée, surchauffe ou appareil bloqué ? Évitez le déplacement : un coursier Yango peut venir récupérer votre équipement tech chez vous et vous le relivrer après intervention au Super U Deux Plateaux.
            </p>
            <div class="yango-pricing-summary">
              <span class="yango-summary-title">Estimation Distance & Paliers Yango :</span>
              <div class="yango-badges-row">
                {yangoDelivery.tiers.map(t => (
                  <span class="yango-tier-chip">
                    <strong>{t.distance} :</strong> {t.price.toLocaleString('fr-FR')} F
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="panel-form-box">
            <form id="repair-order-form" class="hub-form">
              <!-- Type d'équipement tech -->
              <div class="form-group">
                <label>Type d'équipement Tech à réparer</label>
                <select id="repair-device-type" class="hub-select">
                  <option value="smartphone">📱 Smartphone (iPhone, Samsung, Xiaomi, Tecno...)</option>
                  <option value="laptop">💻 Ordinateur Portable / Mac / PC</option>
                  <option value="tablet">📲 Tablette tactile (iPad, Galaxy Tab...)</option>
                  <option value="gaming">🎮 Console de Jeux (PS4, PS5, Nintendo Switch...)</option>
                  <option value="watch">⌚ Montre Connectée / Smartwatch</option>
                  <option value="autre">🔌 Autre équipement électronique</option>
                </select>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label>Marque</label>
                  <select id="repair-brand" class="hub-select">
                    <option value="Apple">Apple</option>
                    <option value="Samsung">Samsung</option>
                    <option value="HP / Dell / Lenovo">HP / Dell / Lenovo</option>
                    <option value="Sony PlayStation">Sony PlayStation</option>
                    <option value="Xiaomi / Redmi">Xiaomi / Redmi</option>
                    <option value="Tecno / Infinix">Tecno / Infinix</option>
                    <option value="Autre">Autre marque</option>
                  </select>
                </div>

                <div class="form-group">
                  <label>Modèle précis</label>
                  <input type="text" id="repair-model" class="hub-input" placeholder="Ex: iPhone 14 Pro, HP Envy 15, PS5..." required />
                </div>
              </div>

              <div class="form-group">
                <label>Panne ou intervention souhaitée</label>
                <select id="repair-issue" class="hub-select">
                  <option value="ecran_casse" data-est="15000">Écran / Dalle fissurée / Tactile HS (Dès 15 000 F)</option>
                  <option value="batterie_faible" data-est="10000">Batterie usée / Décharge rapide (Dès 10 000 F)</option>
                  <option value="connecteur_charge" data-est="8000">Connecteur de charge / Ne s'allume plus (Dès 8 000 F)</option>
                  <option value="camera_micro" data-est="10000">Caméra / Micro / Haut-parleurs (Dès 10 000 F)</option>
                  <option value="reinstallation_nettoyage" data-est="12000">Dépoussiérage / Pâte thermique / Système (12 000 F)</option>
                  <option value="deblocage_systeme" data-est="7000">Mot de passe oublié / Réinitialisation (7 000 F)</option>
                  <option value="autre" data-est="5000">Diagnostic complet en laboratoire</option>
                </select>
              </div>

              <!-- Double Option Yango : Collecte & Livraison Retour -->
              <div class="yango-checkbox-box">
                <span class="yango-options-header">🛵 Options Coursier Express Yango :</span>
                
                <div class="yango-dual-toggles">
                  <label class="custom-checkbox-row yango-check-item">
                    <input type="checkbox" id="repair-pickup-toggle" />
                    <span class="checkbox-label-text">
                      <strong>1. Collecte chez moi</strong>
                      <small class="d-block text-muted">Un coursier vient récupérer l'appareil à mon adresse</small>
                    </span>
                  </label>

                  <label class="custom-checkbox-row yango-check-item">
                    <input type="checkbox" id="repair-return-toggle" />
                    <span class="checkbox-label-text">
                      <strong>2. Livraison retour</strong>
                      <small class="d-block text-muted">Un coursier me ramène l'appareil réparé</small>
                    </span>
                  </label>
                </div>

                <!-- Subform avec Carte Interactive Leaflet -->
                <div id="repair-yango-map-subform" class="yango-details hidden">
                  <div class="map-helper-bar">
                    <span>📍 <strong>Positionnez votre adresse sur la carte</strong> ou cliquez pour placer le repère :</span>
                    <button type="button" id="btn-locate-me" class="btn btn-navy-outline btn-xs">
                      🎯 Me géolocaliser
                    </button>
                  </div>

                  <!-- Container Leaflet Map -->
                  <div id="yango-leaflet-map" class="yango-map-view"></div>

                  <div class="map-calculation-badge" id="map-calculation-badge">
                    <div class="calc-row">
                      <span>Distance calculée depuis Super U :</span>
                      <strong id="calc-distance-km">2.4 km</strong>
                    </div>
                    <div class="calc-row">
                      <span>Palier appliqué :</span>
                      <strong id="calc-zone-name" class="gold-text">Cocody Deux Plateaux (1 500 F / trajet)</strong>
                    </div>
                  </div>

                  <div class="form-group" style="margin-top: 0.75rem;">
                    <label>Adresse précise / Précisions d'accès (bâtiment, porte...)</label>
                    <input type="text" id="repair-pickup-address" class="hub-input" placeholder="Ex: Deux Plateaux Aghien, Villa 42 en face de..." />
                  </div>
                </div>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label>Votre Nom</label>
                  <input type="text" id="repair-client-name" class="hub-input" placeholder="Ex: Sarah B." required />
                </div>
                <div class="form-group">
                  <label>Numéro WhatsApp</label>
                  <input type="tel" id="repair-client-phone" class="hub-input" placeholder="+225..." required />
                </div>
              </div>

              <div class="repair-total-bar">
                <div class="total-breakdown">
                  <span id="repair-base-display">Intervention : 15 000 F</span>
                  <span id="repair-course-display" class="hidden">+ Coursier : 0 F</span>
                </div>
                <div class="total-main">
                  <span>Total estimé :</span>
                  <strong class="total-fig font-serif" id="repair-total-display">15 000 FCFA</strong>
                </div>
              </div>

              <div class="form-actions-row dual-actions">
                <button type="submit" id="btn-repair-pay" class="btn btn-gold">
                  <span>💳 Payer en Ligne (PayDunya)</span>
                </button>
                <button type="button" id="btn-repair-whatsapp" class="btn btn-whatsapp">
                  <span>Demander sur WhatsApp</span>
                </button>
              </div>

              <div id="repair-result-msg" class="result-msg hidden"></div>
            </form>
          </div>
        </div>
      </div>

      <!-- ================= 3. PANNEAU BOUTIQUE : HIGH-TECH & MAROQUINERIE ================= -->
      <div class="hub-panel" id="panel-boutique" data-panel-name="boutique">
        <div class="panel-grid">
          <div class="panel-info">
            <div class="panel-badge-row">
              <span class="gold-badge">🛍️ Pôle 03 • Boutique Officielle</span>
              <span class="live-pill">En Rayon au Super U</span>
            </div>
            <h3 class="panel-title font-serif">High-Tech, Gaming & Maroquinerie Fine sous le même toit</h3>
            <p class="panel-desc">
              Tous nos articles sont certifiés, neufs et disponibles immédiatement au centre commercial Super U Deux Plateaux.
            </p>
            <div class="two-pillars-box">
              <div class="pillar-col">
                <strong class="pillar-title">1. Rayon High-Tech & Gaming</strong>
                <p>Manettes PS4/PS5, câbles blindés tressés, chargeurs ultra-rapides, écouteurs sans fil, power banks LED.</p>
              </div>
              <div class="pillar-col">
                <strong class="pillar-title">2. Rayon Maroquinerie, Montres & Accessoires</strong>
                <p>Sacs à main de luxe, sacoches cuir homme, montres chronographes, changement de pile immédiat (3 min).</p>
              </div>
            </div>
          </div>

          <div class="panel-form-box">
            <div class="boutique-cta-card">
              <h4 class="b-cta-title">🛍️ Explorez le Catalogue & Commandez en 1 Clic</h4>
              <p class="b-cta-text" style="font-size: 0.88rem; color: var(--ivory-muted); margin-bottom: 1rem;">
                Parcourez nos articles High-Tech et Maroquinerie, ajoutez au panier et réglez en toute sécurité via PayDunya ou Wave.
              </p>

              <button type="button" class="btn btn-gold btn-lg w-100 open-boutique-modal-trigger">
                <span>Ouvrir la Boutique (High-Tech & Maroquinerie)</span>
                <span class="btn-arrow">➔</span>
              </button>
            </div>

            <div class="callback-request-box">
              <h5 class="cb-title">📞 Vous cherchez un accessoire précis ? Rappel Express</h5>
              <form id="gaming-callback-form" class="cb-form">
                <div class="form-row-2">
                  <input type="text" id="cb-item-name" class="hub-input" placeholder="Article cherché (ex: Manette PS5 Pro, Sac cuir...)" required />
                  <input type="tel" id="cb-phone" class="hub-input" placeholder="Votre numéro de rappel" required />
                </div>
                <button type="submit" class="btn btn-navy-outline w-100 btn-sm">
                  Être rappelé dans les 15 minutes par un conseiller
                </button>
                <div id="cb-result-msg" class="result-msg hidden"></div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- ================= 4. PANNEAU BUREAUTIQUE & PAO ================= -->
      <div class="hub-panel" id="panel-bureautique" data-panel-name="bureautique">
        <div class="panel-grid">
          <div class="panel-info">
            <div class="panel-badge-row">
              <span class="gold-badge">🖨️ Pôle 04 • Bureautique & PAO</span>
              <span class="live-pill">Atelier d'Impression Pro</span>
            </div>
            <h3 class="panel-title font-serif">Impressions Laser HD, Reliures & Conception PAO</h3>
            <p class="panel-desc">
              Confiez-nous vos documents ou vos projets de conception graphique : mémoires d'études, rapports de stage, flyers publicitaires, affiches et cartes de visite professionnelles.
            </p>
            <ul class="panel-perks">
              <li>📄 Impressions laser haute fidélité noir & blanc ou couleur</li>
              <li>🎨 PAO : Conception graphique et impression de flyers & cartes 300g</li>
              <li>📚 Reliures spirales plastiques/métalliques & plastification</li>
              <li>🏛️ Assistance démarches administratives & inscriptions aux concours</li>
            </ul>
          </div>

          <div class="panel-form-box">
            <form id="print-order-form" class="hub-form">
              <div class="form-group">
                <label>Type de prestation bureautique & PAO</label>
                <select id="print-type" class="hub-select">
                  <option value="impression_cours" data-price="2500">Impression & Reliure Dossier/Mémoire (Dès 2 500 F)</option>
                  <option value="flyers_100" data-price="18000">Pack 100 Flyers Professionnels A5 (18 000 F)</option>
                  <option value="cartes_visite" data-price="15000">Pack 100 Cartes de Visite 300g (15 000 F)</option>
                  <option value="scan_hd" data-price="1000">Numérisation HD & Scan vers Email/Clé USB (1 000 F)</option>
                  <option value="plastification" data-price="2000">Plastification de documents officiels (2 000 F)</option>
                </select>
              </div>

              <!-- Upload Document direct (PDF, Word, Images, etc.) -->
              <div class="form-group">
                <label>Déposer votre document à imprimer / maquette</label>
                <div class="dropzone-area" id="print-dropzone">
                  <input type="file" id="print-file-input" accept=".pdf,.doc,.docx,.ppt,.pptx,.jpg,.jpeg,.png,.webp" class="dropzone-input" />
                  <div class="dropzone-content">
                    <span class="dropzone-icon">📄</span>
                    <span class="dropzone-text" id="print-file-name">Cliquez ou glissez votre fichier ici (PDF, DOCX...)</span>
                    <span class="dropzone-hint">PDF, Word, Images • Traitement confidentiel immédiat</span>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <label>Instructions d'impression (pages, reliure, couleur ou N&B)</label>
                <input type="text" id="print-quantity" class="hub-input" placeholder="Ex: 1 exemplaire recto-verso couleur reliure plastique spirale..." required />
              </div>

              <!-- Option Livraison Yango pour impressions -->
              <div class="form-group yango-delivery-mini-box">
                <label class="custom-checkbox-row">
                  <input type="checkbox" id="print-yango-toggle" />
                  <span class="checkbox-label-text">
                    <strong>🛵 Me faire livrer mes impressions/documents par coursier Yango</strong>
                  </span>
                </label>
                <div id="print-yango-subfield" class="yango-details hidden" style="margin-top: 0.5rem;">
                  <input type="text" id="print-yango-address" class="hub-input" placeholder="Adresse exacte de livraison du colis" />
                </div>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label>Votre Nom</label>
                  <input type="text" id="print-name" class="hub-input" placeholder="Ex: Eric K." required />
                </div>
                <div class="form-group">
                  <label>Numéro WhatsApp</label>
                  <input type="tel" id="print-phone" class="hub-input" placeholder="+225..." required />
                </div>
              </div>

              <div class="form-actions-row dual-actions">
                <button type="submit" id="btn-print-pay" class="btn btn-gold">
                  <span>Envoyer & Payer en Ligne</span>
                </button>
                <a 
                  href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent("Bonjour, j'ai des documents PDF ou un projet PAO à imprimer au Super U.")}`}
                  class="btn btn-whatsapp"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>Envoyer PDF WhatsApp</span>
                </a>
              </div>

              <div id="print-result-msg" class="result-msg hidden"></div>
            </form>
          </div>
        </div>
      </div>

      <!-- ================= 5. PANNEAU MOBILE MONEY DISTINCT ================= -->
      <div class="hub-panel" id="panel-mobile-money" data-panel-name="mobile-money">
        <div class="panel-grid">
          <div class="panel-info">
            <div class="panel-badge-row">
              <span class="gold-badge">📱 Pôle 05 • Mobile Money Agréé</span>
              <span class="live-pill">Wave • Orange • MTN</span>
            </div>
            <h3 class="panel-title font-serif">Guichet Agréé & Coupe-File VIP Express</h3>
            <p class="panel-desc">
              Gagnez un temps précieux au centre commercial : préparez votre opération Mobile Money en ligne pour obtenir un code coupe-file prioritaire sans attente au guichet sécurisé du Super U Deux Plateaux.
            </p>
            <div class="services-duo-pills">
              <span class="duo-pill">🌊 Wave Dépôt / Retrait</span>
              <span class="duo-pill">🍊 Orange Money</span>
              <span class="duo-pill">💛 MTN MoMo</span>
              <span class="duo-pill">⚡ Push & Recharges</span>
            </div>
            <ul class="panel-perks" style="margin-top: 1rem;">
              <li>🔒 Zéro rupture de liquidité pour vos dépôts et retraits</li>
              <li>🛡️ Espace climatisé, confidentiel et sécurisé au sein du Super U</li>
              <li>🚗 Parking gratuit surveillé pour vos opérations financières</li>
            </ul>
          </div>

          <div class="panel-form-box">
            <form id="fastpass-form" class="hub-form">
              <div class="form-row-2">
                <div class="form-group">
                  <label>Opération</label>
                  <select id="fp-operation" class="hub-select">
                    <option value="depot">Dépôt d'argent</option>
                    <option value="retrait">Retrait d'argent</option>
                    <option value="transfert">Transfert vers tiers</option>
                  </select>
                </div>

                <div class="form-group">

---
import { defaultSiteData } from '../data/siteData';
import { getAssetPath } from '../utils/assets';
const { business } = defaultSiteData;
---

<section class="hero-section" id="hero">
  <div class="hero-glow-blob blob-1"></div>
  <div class="hero-glow-blob blob-2"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Top Badge -->
      <div class="gold-badge hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span data-admin-bind="tradeName">{business.name}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        L'Excellence Multiservices au Cœur de <span class="gold-gradient-text">Deux Plateaux</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-description" data-admin-bind="description">
        Votre centre d'exception situé au sein du <strong>Super U Deux Plateaux</strong> (proximité <em>Gare de Sococé</em>) vous propose 5 expertises d'excellence réunies :
      </p>

      <!-- Avant-Garde WOW Services Showcase Grid -->
      <div class="hero-services-showcase" id="hero-services-chips">
        <a href="#services" class="hero-service-chip" data-category="studio-photo">
          <div class="chip-glow"></div>
          <span class="chip-icon">📸</span>
          <div class="chip-content">
            <strong class="chip-title">Studio Photo Pro</strong>
            <span class="chip-desc">Shooting & Identité en 5 min</span>
          </div>
          <span class="chip-arrow">›</span>
        </a>

        <a href="#services" class="hero-service-chip" data-category="reparation-express">
          <div class="chip-glow"></div>
          <span class="chip-icon">⚡</span>
          <div class="chip-content">
            <strong class="chip-title">Réparation Express Smartphones</strong>
            <span class="chip-desc">Écrans & Batteries en 30 min</span>
          </div>
          <span class="chip-arrow">›</span>
        </a>

        <a href="#services" class="hero-service-chip" data-category="electronique-gaming">
          <div class="chip-glow"></div>
          <span class="chip-icon">🎮</span>
          <div class="chip-content">
            <strong class="chip-title">Accessoires Gaming & Tech</strong>
            <span class="chip-desc">Manettes PS4/PS5, Câbles, Audio</span>
          </div>
          <span class="chip-arrow">›</span>
        </a>

        <a href="#services" class="hero-service-chip" data-category="boutique-cadeaux">
          <div class="chip-glow"></div>
          <span class="chip-icon">👜</span>
          <div class="chip-content">
            <strong class="chip-title">Maroquinerie & Montres</strong>
            <span class="chip-desc">Sacs de luxe & Changement pile</span>
          </div>
          <span class="chip-arrow">›</span>
        </a>

        <a href="#services" class="hero-service-chip" data-category="bureautique-transferts">
          <div class="chip-glow"></div>
          <span class="chip-icon">📱</span>
          <div class="chip-content">
            <strong class="chip-title">Mobile Money & Bureautique</strong>
            <span class="chip-desc">Wave, Orange, MTN & Impressions</span>
          </div>
          <span class="chip-arrow">›</span>
        </a>
      </div>

      <!-- Key Location Highlight Box -->
      <div class="location-highlight-card">
        <div class="location-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div class="location-details">
          <span class="location-title">Emplacement Privilégié & Sécurisé</span>
          <span class="location-text">Galerie commerciale du Super U, Boulevard des Martyrs • Parking gratuit surveillé</span>
        </div>
        <div class="live-status-pill status-open">
          <span class="status-dot open"></span>
          <span>09h - 20h</span>
        </div>
      </div>

      <!-- CTAs -->
      <div class="hero-cta-group">
        <a 
          href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent(business.whatsappPreFilled)}`}
          class="btn btn-whatsapp hero-main-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Devis & Contact WhatsApp</span>
        </a>

        <!-- Wave Payment Button in Hero -->
        <button type="button" class="btn btn-wave open-wave-modal-trigger">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
          </svg>
          <span>Payer par Wave</span>
        </button>

        <a href="#services" class="btn btn-navy-outline">
          <span>Découvrir les 5 Services</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>

      <!-- Trust Badges Bar -->
      <div class="hero-stats-grid">
        <div class="stat-item">
          <span class="stat-number gold-gradient-text">5 Min</span>
          <span class="stat-label">Photos Identité Express</span>
        </div>
        <div class="stat-separator"></div>
        <div class="stat-item">
          <span class="stat-number gold-gradient-text">30 Min</span>
          <span class="stat-label">Réparation Smartphones</span>
        </div>
        <div class="stat-separator"></div>
        <div class="stat-item">
          <span class="stat-number gold-gradient-text">100%</span>
          <span class="stat-label">Pièces & Service Garantis</span>
        </div>
        <div class="stat-separator"></div>
        <div class="stat-item">
          <span class="stat-number gold-gradient-text">6j/7</span>
          <span class="stat-label">Non-Stop 09h - 20h</span>
        </div>
      </div>
    </div>

    <!-- Visual Showcase Column -->
    <div class="hero-visual">
      <div class="visual-card-wrapper">
        <div class="image-frame-gold">
          <img 
            src={getAssetPath("/images/hero-store.jpg")} 
            alt="Intérieur boutique Business Center Prestige Services au Super U Deux Plateaux Abidjan" 
            class="hero-store-img"
            width="800"
            height="500"
            loading="eager"
            fetchpriority="high"
          />
          <div class="image-gradient-overlay"></div>
        </div>

        <!-- Floating Badge 1: Studio Photo -->
        <div class="floating-hero-pill pill-studio">
          <div class="pill-icon-circle gold">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </div>
          <div class="pill-info">
            <span class="pill-title">Studio Photo Pro</span>
            <span class="pill-desc">Identité, shooting & retouches</span>
          </div>
        </div>

        <!-- Floating Badge 2: Super U Location -->
        <div class="floating-hero-pill pill-superu">
          <div class="pill-icon-circle blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
            </svg>
          </div>
          <div class="pill-info">
            <span class="pill-title">Paiement Wave Actif</span>
            <span class="pill-desc">QR Code & Mobile Money</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 3.5rem 0 5rem;
    overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #0d223f 0%, #061120 70%, #050d1a 100%);
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding: 5rem 0 6.5rem;
    }
  }

  /* Background Ambient Blobs */
  .hero-glow-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }

  .blob-1 {
    top: -100px;
    right: 5%;
    width: 480px;
    height: 480px;
    background: rgba(212, 175, 55, 0.08);
  }

  .blob-2 {
    bottom: -80px;
    left: -100px;
    width: 450px;
    height: 450px;
    background: rgba(0, 134, 229, 0.09);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  /* Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    z-index: 1;
  }

  .hero-badge {
    margin-bottom: 1.2rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.14;
    color: #ffffff;
    margin-bottom: 1.3rem;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--ivory-muted);
    line-height: 1.65;
    margin-bottom: 1.8rem;
    max-width: 620px;
  }

  .hero-description strong {
    color: #ffffff;
  }

  .hero-description em {
    color: var(--gold-300);
    font-style: normal;
  }

  /* Avant-Garde WOW Services Showcase */
  .hero-services-showcase {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-bottom: 2rem;
    width: 100%;
    max-width: 660px;
  }

  .hero-service-chip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.95rem;
    background: rgba(14, 34, 64, 0.55);
    border: 1px solid rgba(212, 175, 55, 0.28);
    border-radius: var(--radius-md);
    backdrop-filter: blur(14px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    overflow: hidden;
  }

  .hero-service-chip::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.12) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hero-service-chip:hover {
    transform: translateY(-3px) scale(1.02);
    border-color: rgba(212, 175, 55, 0.7);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 20px rgba(212, 175, 55, 0.2);
    background: rgba(18, 44, 82, 0.75);
  }

  .hero-service-chip:hover::before {
    opacity: 1;
  }

  .chip-glow {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 234, 159, 0.25), transparent);
    transform: skewX(-25deg);
    transition: left 0.6s ease;
  }

  .hero-service-chip:hover .chip-glow {
    left: 180%;
  }

  .chip-icon {
    font-size: 1.3rem;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(212, 175, 55, 0.14);
    border: 1px solid rgba(212, 175, 55, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .hero-service-chip:hover .chip-icon {
    transform: scale(1.1) rotate(5deg);
    background: var(--gold-gradient);
    color: var(--navy-950);
  }

  .chip-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .chip-title {
    font-size: 0.84rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
  }

  .chip-desc {
    font-size: 0.72rem;
    color: var(--gold-300);
    line-height: 1.2;
    margin-top: 0.1rem;
  }

  .chip-arrow {
    font-size: 1.1rem;
    color: var(--gold-400);
    opacity: 0.5;
    transition: all 0.2s ease;
    font-weight: 700;
  }

  .hero-service-chip:hover .chip-arrow {
    opacity: 1;
    transform: translateX(3px);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .hero-services-showcase {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }

  /* Location Card in Hero */
  .location-highlight-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(14, 34, 64, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.3);
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    backdrop-filter: blur(12px);
    margin-bottom: 2rem;
    width: 100%;
    max-width: 620px;
  }

  .location-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(212, 175, 55, 0.15);
    color: var(--gold-400);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .location-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .location-title {
    font-weight: 700;
    font-size: 0.92rem;
    color: #ffffff;
  }

  .location-text {
    font-size: 0.78rem;
    color: var(--ivory-muted);
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .location-highlight-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .location-highlight-card .live-status-pill {
      align-self: flex-start;
    }
  }

  /* CTAs */
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 2.8rem;
    width: 100%;
  }

  .hero-main-btn {
    padding: 0.95rem 1.8rem;
    font-size: 1rem;
  }

  /* Stats Grid */
  .hero-stats-grid {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(212, 175, 55, 0.15);
    width: 100%;
    max-width: 620px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--ivory-muted);
    font-weight: 600;
  }

  .stat-separator {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 640px) {
    .stat-separator {
      display: none;
    }
    .hero-stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
  }

  /* Visual Column */
  .hero-visual {
    position: relative;
    z-index: 1;
  }

  .visual-card-wrapper {
    position: relative;
  }

  .image-frame-gold {
    position: relative;
    border-radius: 28px;
    padding: 6px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.6) 0%, rgba(13, 34, 63, 0.3) 50%, rgba(0, 134, 229, 0.4) 100%);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 30px rgba(212, 175, 55, 0.15);
    overflow: hidden;
  }

  .hero-store-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/10;
    object-fit: cover;
    border-radius: 22px;
    display: block;
  }

  .image-gradient-overlay {
    position: absolute;
    inset: 6px;
    border-radius: 22px;
    background: linear-gradient(180deg, transparent 65%, rgba(6, 14, 26, 0.8) 100%);
    pointer-events: none;
  }

  /* Floating Badges on Visual */
  .floating-hero-pill {
    position: absolute;
    background: rgba(9, 23, 44, 0.88);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radius-full);
    padding: 0.6rem 1.1rem 0.6rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.2);
    animation: floatSlow 5s ease-in-out infinite;
  }

  .pill-studio {
    top: -20px;
    left: -20px;
  }

  .pill-superu {
    bottom: -20px;
    right: -15px;
    animation-delay: -2.5s;
    border-color: rgba(0, 134, 229, 0.5);
  }

  .pill-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pill-icon-circle.gold {
    background: var(--gold-gradient);
    color: var(--navy-950);
  }

  .pill-icon-circle.blue {
    background: #0086e5;
    color: #ffffff;
  }

  .pill-info {
    display: flex;
    flex-direction: column;
  }

  .pill-title {
    font-weight: 700;
    font-size: 0.84rem;
    color: #ffffff;
    line-height: 1.2;
  }

  .pill-desc {
    font-size: 0.72rem;
    color: var(--ivory-muted);
  }

  @keyframes floatSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 640px) {
    .floating-hero-pill {
      display: none;
    }
  }
</style>

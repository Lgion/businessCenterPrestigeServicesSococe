---
import { defaultSiteData } from '../data/siteData';
import { getAssetPath } from '../utils/assets';
const { business, services } = defaultSiteData;

const hubTargetMap: Record<string, string> = {
  'studio-photo': 'studio',
  'reparation-express': 'reparation',
  'boutique-produits': 'boutique',
  'bureautique-pao': 'bureautique',
  'mobile-money': 'mobile-money',
  // legacy fallbacks
  'electronique-gaming': 'boutique',
  'boutique-cadeaux': 'boutique',
  'bureautique-transferts': 'bureautique'
};
const heroSlides = [
  {
    image: '/images/hero/hero-slide-1.jpg',
    caption: 'Entrée Principale du Business Center • Galerie Super U Deux Plateaux'
  },
  {
    image: '/images/hero/hero-slide-2.jpg',
    caption: 'Accès Direct & Sécurisé • Boulevard des Martyrs Cocody'
  },
  {
    image: '/images/hero/hero-slide-3.jpg',
    caption: 'Rayons Officiels : High-Tech, Accessoires Gaming & Maroquinerie'
  },
  {
    image: '/images/hero/hero-slide-4.jpg',
    caption: 'Guichet Agréé Mobile Money : Dépôts & Retraits Wave, Orange, MTN'
  }
];
---

<section class="hero-section" id="hero">
  <div class="hero-glow-blob blob-1"></div>
  <div class="hero-glow-blob blob-2"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Top Badge -->
      <div class="gold-badge hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span data-admin-bind="tradeName">{business.name}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        L'Excellence Multiservices au Cœur de <span class="gold-gradient-text">Deux Plateaux</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-description" data-admin-bind="description">
        Votre centre d'exception situé au sein du <strong>Super U Deux Plateaux</strong> (proximité <em>Gare de Sococé</em>) réunit 5 expertises d'excellence sous un même toit :
      </p>

      <!-- Location Highlight Card -->
      <div class="location-highlight-card">
        <div class="location-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div class="location-details">
          <span class="location-title">Emplacement Privilégié & Sécurisé</span>
          <span class="location-text">Galerie commerciale du Super U, Boulevard des Martyrs • Parking gratuit surveillé</span>
        </div>
        <div class="live-status-pill status-open">
          <span class="status-dot open"></span>
          <span>09h - 20h</span>
        </div>
      </div>

      <!-- CTAs -->
      <div class="hero-cta-group">
        <a 
          href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent(business.whatsappPreFilled)}`}
          class="btn btn-whatsapp hero-main-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Devis & Contact WhatsApp</span>
        </a>

        <!-- Wave Payment Button in Hero -->
        <button type="button" class="btn btn-wave open-wave-modal-trigger">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
          </svg>
          <span>Payer par Wave</span>
        </button>

        <a href="#service-hub" class="btn btn-gold-outline hero-hub-btn">
          <span>Accéder aux Démarches</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Visual Showcase Column (Slider Photos Réelles du Super U) -->
    <div class="hero-visual">
      <div class="visual-card-wrapper">
        <div class="image-frame-gold hero-store-slider" id="hero-store-slider" role="region" aria-label="Photos réelles de la boutique">
          <div class="slider-slides-track" id="hero-slider-track">
            {heroSlides.map((slide, idx) => (
              <div class={`hero-slide-item ${idx === 0 ? 'active' : ''}`} data-slide-index={idx}>
                <img 
                  src={getAssetPath(slide.image)} 
                  alt={slide.caption} 
                  class="hero-store-img"
                  width="800"
                  height="500"
                  loading={idx === 0 ? "eager" : "lazy"}
                  fetchpriority={idx === 0 ? "high" : "auto"}
                />
                <div class="image-gradient-overlay"></div>
                <div class="slide-caption-bar">
                  <span class="caption-tag">Photos Réelles Super U</span>
                  <p class="caption-text">{slide.caption}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Slider Controls & Indicators -->
          <button type="button" class="slider-arrow prev" id="hero-slide-prev" aria-label="Photo précédente">‹</button>
          <button type="button" class="slider-arrow next" id="hero-slide-next" aria-label="Photo suivante">›</button>

          <div class="slider-indicators" id="hero-slide-indicators" aria-hidden="true">
            {heroSlides.map((_, idx) => (
              <button 
                type="button" 
                class={`indicator-dot ${idx === 0 ? 'active' : ''}`} 
                data-slide-to={idx}
                aria-label={`Aller à la photo ${idx + 1}`}
              ></button>
            ))}
          </div>
        </div>

        <!-- Floating Badge 1: Studio Photo -->
        <div class="floating-hero-pill pill-studio">
          <div class="pill-icon-circle gold">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </div>
          <div class="pill-info">
            <span class="pill-title">Studio Photo Pro</span>
            <span class="pill-desc">Identité, shooting & retouches</span>
          </div>
        </div>

        <!-- Floating Badge 2: Super U Location -->
        <div class="floating-hero-pill pill-superu">
          <div class="pill-icon-circle blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
            </svg>
          </div>
          <div class="pill-info">
            <span class="pill-title">Paiement Wave Actif</span>
            <span class="pill-desc">QR Code & Mobile Money</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 5 Service Cards Interactive Carousel (WOW Experience) -->
  <div class="container hero-carousel-container">
    <div class="hero-carousel-header">
      <div class="carousel-title-group">
        <span class="carousel-tagline">Explorer nos 5 Pôles d'Excellence</span>
        <h2 class="carousel-title">Faites défiler et lancez vos démarches immédiates</h2>
      </div>
      <div class="hero-carousel-controls">
        <button type="button" class="hero-carousel-btn prev-btn" id="hero-carousel-prev" aria-label="Pôle précédent">
          ‹
        </button>
        <button type="button" class="hero-carousel-btn next-btn" id="hero-carousel-next" aria-label="Pôle suivant">
          ›
        </button>
      </div>
    </div>

    <div class="hero-cards-carousel" id="hero-cards-carousel" tabindex="0" role="region" aria-label="Carrousel des 5 pôles de services">
      {services.map((service) => {
        const target = hubTargetMap[service.id] || 'studio';
        return (
          <article class="hero-service-card prestige-card" data-hub-target={target} tabindex="0">
            <div class="card-media-wrap">
              <img 
                src={getAssetPath(service.image)} 
                alt={service.title} 
                class="card-img" 
                loading="lazy" 
                width="400" 
                height="240" 
              />
              <div class="card-media-overlay"></div>
              <span class="card-num-badge">{service.number}</span>
              <span class="card-status-pill">{service.badge}</span>
            </div>
            <div class="card-content-wrap">
              <span class="card-popular-tag">{service.popularTag}</span>
              <h3 class="card-heading font-serif">{service.title}</h3>
              <p class="card-sub-desc">{service.subtitle}</p>
              
              <ul class="card-features-mini">
                {service.items.slice(0, 2).map((item) => (
                  <li>
                    <span class="mini-check">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <button type="button" class="card-trigger-hub-btn" data-hub-target={target}>
                <span>Accéder à ce pôle</span>
                <span class="card-btn-arrow">→</span>
              </button>
            </div>
          </article>
        );
      })}
    </div>

    <div class="hero-carousel-dots" id="hero-carousel-dots" aria-hidden="true">
      {services.map((_, i) => (
        <button type="button" class={`carousel-dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Aller au service ${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 6.5rem 0 5rem;
    overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #0d223f 0%, #061120 70%, #050d1a 100%);
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding: 7.5rem 0 6.5rem;
    }
  }

  /* Background Ambient Blobs */
  .hero-glow-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }

  .blob-1 {
    top: -100px;
    right: 5%;
    width: 480px;
    height: 480px;
    background: rgba(212, 175, 55, 0.08);
  }

  .blob-2 {
    bottom: -80px;
    left: -100px;
    width: 450px;
    height: 450px;
    background: rgba(0, 134, 229, 0.09);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  /* Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    z-index: 1;
  }

  .hero-badge {
    margin-bottom: 1.2rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.14;
    color: #ffffff;
    margin-bottom: 1.3rem;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--ivory-muted);
    line-height: 1.65;
    margin-bottom: 1.8rem;
    max-width: 620px;
  }

  .hero-description strong {
    color: #ffffff;
  }

  .hero-description em {
    color: var(--gold-300);
    font-style: normal;
  }

  /* Hero Carousel of 5 Services */
  .hero-carousel-container {
    margin-top: 3.5rem;
    position: relative;
    z-index: 1;
  }

  .hero-carousel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    gap: 1.5rem;
  }

  .carousel-tagline {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gold-400);
    display: block;
    margin-bottom: 0.35rem;
  }

  .carousel-title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    color: #ffffff;
    margin: 0;
  }

  .hero-carousel-controls {
    display: flex;
    gap: 0.6rem;
  }

  .hero-carousel-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(14, 34, 64, 0.85);
    border: 1.5px solid rgba(212, 175, 55, 0.4);
    color: var(--gold-300);
    font-size: 1.6rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
    backdrop-filter: blur(8px);
  }

  .hero-carousel-btn:hover {
    background: var(--gold-gradient);
    color: var(--navy-950);
    border-color: #ffe082;
    transform: scale(1.08);
    box-shadow: 0 0 16px rgba(212, 175, 55, 0.4);
  }

  .hero-cards-carousel {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 0.25rem 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(212, 175, 55, 0.3) transparent;
  }

  .hero-cards-carousel::-webkit-scrollbar {
    height: 6px;
  }

  .hero-cards-carousel::-webkit-scrollbar-thumb {
    background: rgba(212, 175, 55, 0.35);
    border-radius: 999px;
  }

  .hero-service-card {
    flex: 0 0 calc(33.333% - 0.85rem);
    min-width: 280px;
    max-width: 380px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border-radius: 18px;
    overflow: hidden;
    background: rgba(12, 28, 54, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.22);
    backdrop-filter: blur(14px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  @media (max-width: 1024px) {
    .hero-service-card {
      flex: 0 0 calc(50% - 0.7rem);
    }
  }

  @media (max-width: 640px) {
    .hero-service-card {
      flex: 0 0 88%;
      min-width: 260px;
    }
    .carousel-title {
      font-size: 1.25rem;
    }
  }

  .hero-service-card:hover {
    transform: translateY(-6px);
    border-color: rgba(212, 175, 55, 0.65);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5), 0 0 24px rgba(212, 175, 55, 0.2);
    background: rgba(16, 38, 72, 0.85);
  }

  .card-media-wrap {
    position: relative;
    width: 100%;
    height: 175px;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .hero-service-card:hover .card-img {
    transform: scale(1.06);
  }

  .card-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 17, 32, 0.1) 0%, rgba(6, 17, 32, 0.85) 100%);
  }

  .card-num-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: linear-gradient(135deg, #07172c 0%, #030a14 100%);
    border: 1.5px solid #f6d365;
    color: #ffe082;
    font-weight: 900;
    font-size: 0.92rem;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.7rem;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7), 0 0 12px rgba(212, 175, 55, 0.45);
    backdrop-filter: blur(10px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .card-status-pill {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #091a33;
    border: 1.5px solid #f6d365;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6), 0 0 14px rgba(212, 175, 55, 0.35);
    z-index: 2;
  }

  .card-content-wrap {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-popular-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--gold-400);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .card-heading {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.45rem;
    line-height: 1.25;
  }

  .card-sub-desc {
    font-size: 0.82rem;
    color: var(--ivory-muted);
    line-height: 1.45;
    margin-bottom: 0.9rem;
  }

  .card-features-mini {
    list-style: none;
    padding: 0;
    margin: 0 0 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card-features-mini li {
    font-size: 0.78rem;
    color: #cbd5e1;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .mini-check {
    color: var(--gold-400);
    font-weight: bold;
  }

  .card-trigger-hub-btn {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.95rem;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 10px;
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hero-service-card:hover .card-trigger-hub-btn {
    background: var(--gold-gradient);
    color: var(--navy-950);
    border-color: #ffe082;
  }

  .card-btn-arrow {
    transition: transform 0.2s ease;
  }

  .hero-service-card:hover .card-btn-arrow {
    transform: translateX(4px);
  }

  .hero-carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .carousel-dot.active {
    width: 24px;
    background: var(--gold-400);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.5);
  }

  /* Location Card in Hero */
  .location-highlight-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(14, 34, 64, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.3);
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    backdrop-filter: blur(12px);
    margin-bottom: 2rem;
    width: 100%;
    max-width: 620px;
  }

  .location-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(212, 175, 55, 0.15);
    color: var(--gold-400);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .location-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .location-title {
    font-weight: 700;
    font-size: 0.92rem;
    color: #ffffff;
  }

  .location-text {
    font-size: 0.78rem;
    color: var(--ivory-muted);
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .location-highlight-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .location-highlight-card .live-status-pill {
      align-self: flex-start;
    }
  }

  /* CTAs */
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
    width: 100%;
  }

  .hero-main-btn {
    padding: 0.95rem 1.8rem;
    font-size: 1rem;
  }

  .hero-hub-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Visual Column */
  .hero-visual {
    position: relative;
    z-index: 1;
  }

  .visual-card-wrapper {
    position: relative;
  }

  .image-frame-gold {
    position: relative;
    border-radius: 28px;
    padding: 6px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.6) 0%, rgba(13, 34, 63, 0.3) 50%, rgba(0, 134, 229, 0.4) 100%);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 30px rgba(212, 175, 55, 0.15);
    overflow: hidden;
  }

  /* Real store photos slider */
  .hero-store-slider {
    position: relative;
    overflow: hidden;
    user-select: none;
  }

  .slider-slides-track {
    position: relative;
    width: 100%;
    aspect-ratio: 16/10;
    border-radius: 22px;
    overflow: hidden;
  }

  .hero-slide-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(1.03);
    z-index: 1;
  }

  .hero-slide-item.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    z-index: 2;
  }

  .hero-store-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22px;
    display: block;
  }

  .image-gradient-overlay {
    position: absolute;
    inset: 0;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(6, 17, 32, 0.1) 0%, rgba(6, 14, 26, 0.85) 100%);
    pointer-events: none;
  }

  .slide-caption-bar {
    position: absolute;
    bottom: 12px;
    left: 14px;
    right: 14px;
    padding: 0.6rem 0.9rem;
    border-radius: 12px;
    background: rgba(6, 16, 32, 0.82);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(212, 175, 55, 0.35);
    z-index: 3;
    pointer-events: none;
  }

  .caption-tag {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--gold-400);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.15rem;
  }

  .caption-text {
    font-size: 0.78rem;
    color: #ffffff;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(6, 16, 32, 0.8);
    border: 1px solid rgba(212, 175, 55, 0.4);
    color: var(--gold-300);
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .slider-arrow:hover {
    background: var(--gold-gradient);
    color: var(--navy-950);
    border-color: #fff;
    transform: translateY(-50%) scale(1.1);
  }

  .slider-arrow.prev { left: 12px; }
  .slider-arrow.next { right: 12px; }

  .slider-indicators {
    position: absolute;
    bottom: 58px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.45rem;
    z-index: 5;
  }

  .indicator-dot {
    width: 22px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .indicator-dot.active {
    background: var(--gold-400);
    width: 36px;
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
  }

  /* Floating Badges on Visual */
  .floating-hero-pill {
    z-index:9;
    position: absolute;
    background: rgba(9, 23, 44, 0.88);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radius-full);
    padding: 0.6rem 1.1rem 0.6rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.2);
    animation: floatSlow 5s ease-in-out infinite;
  }

  .pill-studio {
    top: -20px;
    left: -20px;
  }

  .pill-superu {
    bottom: -20px;
    right: -15px;
    animation-delay: -2.5s;
    border-color: rgba(0, 134, 229, 0.5);
  }

  .pill-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pill-icon-circle.gold {
    background: var(--gold-gradient);
    color: var(--navy-950);
  }

  .pill-icon-circle.blue {
    background: #0086e5;
    color: #ffffff;
  }

  .pill-info {
    display: flex;
    flex-direction: column;
  }

  .pill-title {
    font-weight: 700;
    font-size: 0.84rem;
    color: #ffffff;
    line-height: 1.2;
  }

  .pill-desc {
    font-size: 0.72rem;
    color: var(--ivory-muted);
  }

  @keyframes floatSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 640px) {
    .floating-hero-pill {
      display: none;
    }
  }
</style>

<script>
  function setupHeroAll() {
    // 1. Real Store Photos Slider
    const slideItems = document.querySelectorAll<HTMLElement>('.hero-slide-item');
    const indicatorDots = document.querySelectorAll<HTMLButtonElement>('.indicator-dot');
    const prevSlideBtn = document.getElementById('hero-slide-prev');
    const nextSlideBtn = document.getElementById('hero-slide-next');
    let currentSlide = 0;
    let autoSlideInterval: number | null = null;

    function goToSlide(idx: number) {
      if (!slideItems.length) return;
      currentSlide = (idx + slideItems.length) % slideItems.length;
      slideItems.forEach((slide, i) => {
        slide.classList.toggle('active', i === currentSlide);
      });
      indicatorDots.forEach((dot, i) => {
        dot.classList.toggle('active', i === currentSlide);
      });
    }

    function startAutoSlide() {
      stopAutoSlide();
      autoSlideInterval = window.setInterval(() => {
        goToSlide(currentSlide + 1);
      }, 4500);
    }

    function stopAutoSlide() {
      if (autoSlideInterval) {
        clearInterval(autoSlideInterval);
        autoSlideInterval = null;
      }
    }

    prevSlideBtn?.addEventListener('click', () => {
      goToSlide(currentSlide - 1);
      startAutoSlide();
    });

    nextSlideBtn?.addEventListener('click', () => {
      goToSlide(currentSlide + 1);
      startAutoSlide();
    });

    indicatorDots.forEach(dot => {
      dot.addEventListener('click', () => {
        const to = parseInt(dot.getAttribute('data-slide-to') || '0', 10);
        goToSlide(to);
        startAutoSlide();
      });
    });

    const sliderContainer = document.getElementById('hero-store-slider');
    sliderContainer?.addEventListener('mouseenter', stopAutoSlide);
    sliderContainer?.addEventListener('mouseleave', startAutoSlide);

    startAutoSlide();

    // 2. 5 Services Carousel
    const carousel = document.getElementById('hero-cards-carousel') as HTMLElement | null;
    const prevBtn = document.getElementById('hero-carousel-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('hero-carousel-next') as HTMLButtonElement | null;
    const dots = document.querySelectorAll('#hero-carousel-dots .carousel-dot');
    const cards = document.querySelectorAll('.hero-service-card');

    if (!carousel) return;

    function getCardWidth(): number {
      const card = carousel?.querySelector('.hero-service-card') as HTMLElement | null;
      return card ? card.offsetWidth + 20 : 320;
    }

    prevBtn?.addEventListener('click', () => {
      carousel?.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      carousel?.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
    });

    // Keyboard support
    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        carousel.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
      } else if (e.key === 'ArrowRight') {
        carousel.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
      }
    });

    // Update active dot on scroll
    carousel.addEventListener('scroll', () => {
      const cardWidth = getCardWidth();
      const activeIndex = Math.min(
        dots.length - 1,
        Math.max(0, Math.round((carousel?.scrollLeft || 0) / cardWidth))
      );
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeIndex);
      });
    }, { passive: true });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0', 10);
        carousel?.scrollTo({ left: index * getCardWidth(), behavior: 'smooth' });
      });
    });

    // Card click triggers hub tab switch & smooth scroll
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const targetHub = card.getAttribute('data-hub-target');
        if (targetHub) {
          const pill = document.querySelector(`.hub-tab-btn[data-hub-target="${targetHub}"], .arc-pill[data-hub-target="${targetHub}"]`) as HTMLButtonElement | null;
          if (pill) {
            pill.click();
          }
          const hubSection = document.getElementById('service-hub');
          if (hubSection) {
            hubSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroAll);
  } else {
    setupHeroAll();
  }
</script>

---
import { defaultSiteData } from '../data/siteData';
const { business, reasonsToChoose, faqs } = defaultSiteData;
---

<section class="location-contact-section" id="super-u">
  <div class="container">
    <!-- Top Header -->
    <div class="section-head text-center">
      <span class="section-tagline">Proximité & Accessibilité</span>
      <h2 class="section-title">
        Nous Trouver au <span class="gold-gradient-text">Super U Deux Plateaux</span>
      </h2>
      <p class="section-subtitle">
        Idéalement implanté au carrefour névralgique de Cocody Deux Plateaux (Gare de Sococé). Profitez d'un cadre sécurisé, climatisé et d'un vaste parking pour vos courses et démarches.
      </p>
    </div>

    <!-- 4 Reasons Grid -->
    <!--div class="reasons-grid">
      {reasonsToChoose.map((reason) => (
        <div class="reason-card prestige-card">
          <div class="reason-icon-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="reason-title">{reason.title}</h3>
          <p class="reason-desc">{reason.description}</p>
        </div>
      ))}
    </div-->

    <!-- Main Location & Contact Interactive Split Box -->
    <div class="location-split-card prestige-card" id="contact">
      <!-- Left Info Column -->
      <div class="location-info-col">
        <div class="info-head">
          <div class="live-status-pill status-open">
            <span class="status-dot open"></span>
            <span>Ouvert aujourd'hui • 09h00 - 20h00</span>
          </div>
          <h3 class="info-main-title font-serif">Vos Contacts Directs</h3>
        </div>

        <div class="contact-details-list">
          <!-- Address -->
          <div class="contact-item">
            <div class="item-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <span class="item-label">Adresse Physique</span>
              <p class="item-value" data-admin-bind="address">{business.address}</p>
              <span class="item-hint">Repère : Intérieur du Super U Deux Plateaux, à 2 min de la Gare de Sococé</span>
            </div>
          </div>

          <!-- Schedule -->
          <div class="contact-item">
            <div class="item-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div>
              <span class="item-label">Horaires d'Ouverture</span>
              <p class="item-value" data-admin-bind="openingHours">{business.openingHours}</p>
              <span class="item-hint">Service continu • Fermé le Dimanche</span>
            </div>
          </div>

          <!-- Phone & WhatsApp -->
          <div class="contact-item">
            <div class="item-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <span class="item-label">Lignes Téléphoniques & WhatsApp</span>
              <p class="item-value">
                Appel : <strong data-admin-bind="phoneFormatted">{business.phoneFormatted}</strong><br />
                WhatsApp : <strong data-admin-bind="whatsappFormatted">{business.whatsappFormatted}</strong>
              </p>
            </div>
          </div>

          <!-- Delivery -->
          <div class="contact-item">
            <div class="item-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <div>
              <span class="item-label">Livraison Partout à Abidjan</span>
              <p class="item-value">Livraison à domicile et en entreprise (Cocody, Plateau, Marcory, Riviera, etc.) ou retrait boutique.</p>
            </div>
          </div>
        </div>

        <div class="contact-cta-buttons">
          <a 
            href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent(business.whatsappPreFilled)}`}
            class="btn btn-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            Lancer un échange WhatsApp
          </a>

          <a href={`tel:${business.phone}`} class="btn btn-navy-outline">
            Appeler le 07 89 08 30 85
          </a>
        </div>
      </div>

      <!-- Right Interactive Map Column -->
      <div class="location-map-col">
        <div class="map-card-container">
          <iframe 
            src={business.googleMapsEmbed} 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Carte d'accès Super U Deux Plateaux Abidjan"
            class="map-iframe"
          ></iframe>
          
          <div class="map-overlay-badge">
            <div class="map-badge-icon">📍</div>
            <div>
              <strong>Super U Deux Plateaux</strong>
              <span>Gare de Sococé • Boulevard des Martyrs</span>
            </div>
            <a 
              href={business.googleMapsUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="map-ext-link"
              title="Ouvrir dans Google Maps"
            >
              Itinéraire
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <!--div class="faq-container">
      <div class="faq-header text-center">
        <span class="section-tagline">Questions Fréquentes</span>
        <h3 class="faq-main-title font-serif">Tout ce que vous devez savoir</h3>
      </div>

      <div class="faq-accordion">
        {faqs.map((faq, index) => (
          <details class="faq-item prestige-card" open={index === 0}>
            <summary class="faq-question">
              <span>{faq.question}</span>
              <span class="faq-chevron">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div-->
  </div>
</section>

<style>
  .location-contact-section {
    padding: 5rem 0 6rem;
    background: linear-gradient(180deg, #060e1a 0%, #091a32 50%, #050d1a 100%);
    position: relative;
    z-index: 1;
  }

  .text-center {
    text-align: center;
  }

  .section-head {
    margin-bottom: 3.5rem;
  }

  /* 4 Reasons */
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .reason-card {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .reason-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(212, 175, 55, 0.15);
    color: var(--gold-400);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .reason-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.4rem;
  }

  .reason-desc {
    font-size: 0.84rem;
    color: var(--ivory-muted);
    line-height: 1.45;
  }

  /* Split Card */
  .location-split-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 4rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 960px) {
    .location-split-card {
      grid-template-columns: 1fr;
    }
  }

  .location-info-col {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (max-width: 640px) {
    .location-info-col {
      padding: 1.6rem;
    }
  }

  .info-head {
    margin-bottom: 1.8rem;
  }

  .info-main-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 0.8rem;
  }

  .contact-details-list {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-bottom: 2.2rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .item-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(14, 32, 60, 0.8);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: var(--gold-400);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .item-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--gold-400);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
  }

  .item-value {
    font-size: 0.95rem;
    color: #ffffff;
    font-weight: 600;
    line-height: 1.4;
    margin-top: 0.15rem;
  }

  .item-hint {
    font-size: 0.78rem;
    color: var(--ivory-muted);
    display: block;
    margin-top: 0.2rem;
  }

  .contact-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* Map Col */
  .location-map-col {
    position: relative;
    min-height: 380px;
    background: #0a1728;
  }

  .map-card-container {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .map-iframe {
    filter: brightness(0.9) contrast(1.1);
  }

  .map-overlay-badge {
    position: absolute;
    bottom: 1.2rem;
    left: 1.2rem;
    right: 1.2rem;
    background: rgba(7, 18, 35, 0.92);
    border: 1px solid var(--gold-500);
    backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
  }

  .map-badge-icon {
    font-size: 1.4rem;
  }

  .map-overlay-badge strong {
    display: block;
    font-size: 0.86rem;
    color: #ffffff;
  }

  .map-overlay-badge span {
    font-size: 0.74rem;
    color: var(--ivory-muted);
  }

  .map-ext-link {
    margin-left: auto;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--gold-400);
    background: rgba(212, 175, 55, 0.15);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(212, 175, 55, 0.35);
  }

  .map-ext-link:hover {
    background: var(--gold-500);
    color: var(--navy-950);
  }

  /* FAQ */
  .faq-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-header {
    margin-bottom: 2rem;
  }

  .faq-main-title {
    font-size: 1.7rem;
    font-weight: 700;
    color: #ffffff;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    border-radius: var(--radius-md);
    padding: 0;
    overflow: hidden;
  }

  .faq-question {
    list-style: none;
    padding: 1.25rem 1.6rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    user-select: none;
    transition: background 0.2s;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background: rgba(212, 175, 55, 0.08);
  }

  .faq-chevron {
    color: var(--gold-400);
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.6rem 1.4rem;
    font-size: 0.9rem;
    color: var(--ivory-muted);
    line-height: 1.6;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
</style>

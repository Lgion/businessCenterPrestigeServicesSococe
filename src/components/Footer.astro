---
import { defaultSiteData } from '../data/siteData';
const { business, services } = defaultSiteData;
---

<footer class="site-footer" id="super-u">
  <!-- Proximité & Accessibilité Super U Banner (Consolidated) -->
  <div class="footer-access-section" id="proximite">
    <div class="container">
      <div class="access-card prestige-card">
        <div class="access-grid">
          <div class="access-info">
            <span class="gold-badge">📍 Emplacement Privilégié</span>
            <h3 class="access-title font-serif">Nous trouver au Super U Deux Plateaux</h3>
            <p class="access-desc">
              Situé au carrefour névralgique de Cocody Deux Plateaux sur le Boulevard des Martyrs, à seulement 2 minutes de la <strong>Gare de Sococé</strong>.
            </p>
            <div class="access-perks">
              <div class="perk-item">
                <span class="perk-icon">🚗</span>
                <div>
                  <strong>Parking Gratuit & Surveillé</strong>
                  <span>Accès direct et sécurisé pour vos courses et démarches</span>
                </div>
              </div>
              <div class="perk-item">
                <span class="perk-icon">❄️</span>
                <div>
                  <strong>Cadre Moderne & Climatisé</strong>
                  <span>Boutique spacieuse au cœur de la galerie marchande</span>
                </div>
              </div>
              <div class="perk-item">
                <span class="perk-icon">🕒</span>
                <div>
                  <strong>Non-stop 09h00 - 20h00</strong>
                  <span>Du Lundi au Samedi (fermé le Dimanche)</span>
                </div>
              </div>
            </div>
            <div class="access-actions">
              <a 
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Super U Deux Plateaux Cocody Abidjan')}`} 
                class="btn btn-gold"
                target="_blank" 
                rel="noopener noreferrer"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"></path>
                  <circle cx="12" cy="9" r="2.5"></circle>
                </svg>
                <span>Ouvrir l'Itinéraire Google Maps</span>
              </a>
              <a 
                href={`tel:${business.phone}`} 
                class="btn btn-navy-outline"
              >
                <span>Appel : {business.phoneFormatted}</span>
              </a>
            </div>
          </div>

          <div class="access-map-box">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3972.395159828551!2d-3.999557!3d5.356598!2m3!1f0!2f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xfc1ebd7cb01f9bb%3A0x6b77c86720521e25!2sSuper%20U%20Deux%20Plateaux!5e0!3m2!1sfr!2sci!4v1710000000000!5m2!1sfr!2sci" 
              class="access-iframe-map" 
              loading="lazy" 
              title="Plan d'accès Super U Deux Plateaux Cocody Abidjan"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container footer-container">
    <!-- Brand Col -->
    <div class="footer-col brand-col">
      <div class="footer-brand-header">
        <div class="footer-crest">
          <svg viewBox="0 0 44 44" fill="none" class="crest-svg" xmlns="http://www.w3.org/2000/svg">
            <rect width="44" height="44" rx="12" fill="#0C1E3B"/>
            <rect x="1.5" y="1.5" width="41" height="41" rx="10.5" stroke="#D4AF37" stroke-width="1.5"/>
            <path d="M15 13L22 9L29 13L26 17H18L15 13Z" fill="#D4AF37"/>
            <text x="22" y="32" font-family="'Playfair Display', serif" font-weight="800" font-size="14" fill="#D4AF37" text-anchor="middle">BCPS</text>
          </svg>
        </div>
        <div>
          <h3 class="footer-title font-serif">{business.name}</h3>
          <span class="footer-sub">{business.shortAddress}</span>
        </div>
      </div>

      <p class="footer-desc">
        Votre centre multiservices de référence au sein du <strong>Super U Deux Plateaux</strong>. Studio Photo Professionnel, Réparation Express, Gaming, Maroquinerie & Agence Mobile Money (Wave, Orange, MTN).
      </p>

      <div class="footer-status-box">
        <div class="live-status-pill status-open">
          <span class="status-dot open"></span>
          <span>Ouvert du Lun au Sam : 09h - 20h</span>
        </div>
      </div>
    </div>

    <!-- 5 Services Links -->
    <div class="footer-col">
      <h4 class="footer-col-title">Nos 5 Pôles d'Excellence</h4>
      <ul class="footer-links">
        {services.map((s) => (
          <li>
            <a href="#service-hub" class="footer-link">
              <span class="bullet">›</span> {s.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Quick Navigation -->
    <div class="footer-col">
      <h4 class="footer-col-title">Navigation Rapide</h4>
      <ul class="footer-links">
        <li><a href="#hero" class="footer-link"><span class="bullet">›</span> Accueil</a></li>
        <li><a href="#service-hub" class="footer-link"><span class="bullet">›</span> Espace Démarches Express</a></li>
        <li><a href="#tarifs" class="footer-link"><span class="bullet">›</span> Tarifs & Simulateur Devis</a></li>
        <li><a href="#saison" class="footer-link"><span class="bullet">›</span> Vitrine Saisonnière & Promos</a></li>
        <li><a href="#super-u" class="footer-link"><span class="bullet">›</span> Accès & Parking Super U</a></li>
        <li>
          <button type="button" class="footer-link open-boutique-trigger link-btn">
            <span class="bullet">›</span> <strong>Boutique High-Tech & Sacs</strong>
          </button>
        </li>
      </ul>
    </div>

    <!-- Direct Contact & Social -->
    <div class="footer-col">
      <h4 class="footer-col-title">Service Client</h4>
      <p class="footer-contact-item">
        <strong>Téléphone :</strong><br />
        <a href={`tel:${business.phone}`} class="contact-hl">{business.phoneFormatted}</a>
      </p>
      <p class="footer-contact-item">
        <strong>WhatsApp :</strong><br />
        <a href={`https://wa.me/225${business.whatsapp}`} target="_blank" rel="noopener noreferrer" class="contact-hl">{business.whatsappFormatted}</a>
      </p>
      <p class="footer-contact-item">
        <strong>Adresse :</strong><br />
        <span>Centre Commercial Super U Deux Plateaux, Abidjan</span>
      </p>

      <div class="footer-wave-cta">
        <button type="button" class="btn btn-wave btn-sm open-wave-modal-trigger w-100">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
          </svg>
          Règlement Wave
        </button>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container bottom-content">
      <p class="copyright">
        © {new Date().getFullYear()} {business.name}. Tous droits réservés.
      </p>
      <div class="bottom-actions">
        <a href="/admin" class="admin-link">
          ⚙️ Administration & Commandes
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #040913;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    color: var(--ivory-muted);
    padding-top: 0;
    position: relative;
    z-index: 1;
  }

  /* Consolidated Proximity Section */
  .footer-access-section {
    padding: 3.5rem 0 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: radial-gradient(circle at 50% 0%, rgba(14, 34, 64, 0.4) 0%, transparent 70%);
  }

  .access-card {
    background: rgba(10, 24, 48, 0.7);
    border: 1.5px solid rgba(212, 175, 55, 0.35);
    border-radius: 20px;
    padding: 2.2rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  .access-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .access-grid {
      grid-template-columns: 1fr;
    }
  }

  .access-title {
    font-size: 1.6rem;
    color: #ffffff;
    margin: 0.8rem 0 0.6rem;
  }

  .access-desc {
    font-size: 0.92rem;
    color: var(--ivory-muted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .access-perks {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.8rem;
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .perk-icon {
    font-size: 1.3rem;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .perk-item div {
    display: flex;
    flex-direction: column;
  }

  .perk-item strong {
    font-size: 0.88rem;
    color: #ffffff;
  }

  .perk-item span {
    font-size: 0.76rem;
    color: var(--ivory-muted);
  }

  .access-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .access-map-box {
    border-radius: 16px;
    overflow: hidden;
    height: 280px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
  }

  .access-iframe-map {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.3fr 1fr 0.9fr 1fr;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 3.5rem;
  }

  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Brand Col */
  .footer-brand-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.2rem;
  }

  .footer-crest {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .footer-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .footer-sub {
    font-size: 0.74rem;
    color: var(--gold-400);
  }

  .footer-desc {
    font-size: 0.86rem;
    line-height: 1.6;
    margin-bottom: 1.4rem;
  }

  .footer-desc strong {
    color: #ffffff;
  }

  /* Links */
  .footer-col-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: #ffffff;
    margin-bottom: 1.2rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32px;
    height: 2px;
    background: var(--gold-gradient);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    font-size: 0.86rem;
    color: var(--ivory-muted);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .bullet {
    color: var(--gold-400);
    font-weight: 800;
  }

  .footer-link:hover {
    color: var(--gold-300);
    transform: translateX(3px);
  }

  .link-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }

  .link-btn strong {
    color: #38bdf8;
  }

  /* Contact */
  .footer-contact-item {
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 0.9rem;
  }

  .footer-contact-item strong {
    color: #ffffff;
  }

  .contact-hl {
    color: var(--gold-400);
    font-weight: 700;
  }

  .contact-hl:hover {
    color: #ffffff;
  }

  .footer-wave-cta {
    margin-top: 1.2rem;
  }

  .w-100 {
    width: 100%;
  }

  /* Bottom bar */
  .footer-bottom {
    background: #02060d;
    padding: 1.2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.78rem;
  }

  .bottom-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .bottom-content {
      flex-direction: column;
      text-align: center;
    }
  }

  .copyright {
    color: #64748b;
  }

  .admin-link {
    background: none;
    border: none;
    color: var(--gold-400);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    transition: color 0.2s;
  }

  .admin-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }
</style>

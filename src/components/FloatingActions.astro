---
import { defaultSiteData } from '../data/siteData';
const { business } = defaultSiteData;
---

<div class="floating-quick-actions" id="floating-actions" aria-label="Accès rapides et contact">
  <!-- Wave Quick Floating Button -->
  <button 
    type="button" 
    class="quick-fab fab-wave open-wave-modal-trigger" 
    title="Paiement Wave instantané"
    aria-label="Ouvrir le paiement Wave"
  >
    <div class="fab-inner">
      <svg class="fab-wave-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z" fill="currentColor"/>
      </svg>
      <span class="fab-tooltip">Payer par Wave</span>
    </div>
  </button>

  <!-- Direct Phone Call Button -->
  <a 
    href={`tel:${business.phone}`} 
    class="quick-fab fab-call" 
    title={`Appel téléphonique direct : ${business.phoneFormatted}`}
    aria-label={`Appeler le magasin au ${business.phoneFormatted}`}
  >
    <div class="fab-inner">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <span class="fab-tooltip">Appel direct : {business.phoneFormatted}</span>
    </div>
  </a>

  <!-- WhatsApp Direct Main Action -->
  <a 
    href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent(business.whatsappPreFilled)}`} 
    class="quick-fab fab-whatsapp" 
    target="_blank" 
    rel="noopener noreferrer"
    title="Discuter directement sur WhatsApp"
    aria-label="Contacter sur WhatsApp"
  >
    <div class="fab-inner">
      <!-- Pulsing status dot -->
      <span class="online-indicator"></span>
      <svg class="whatsapp-logo" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span class="whatsapp-badge-pill">WhatsApp</span>
      <span class="fab-tooltip">Écrire sur WhatsApp</span>
    </div>
  </a>

  <!-- Scroll to top button -->
  <button type="button" id="scroll-top-btn" class="quick-fab fab-scroll" aria-label="Remonter en haut de page">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</div>

<style>
  .floating-quick-actions {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9990;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .floating-quick-actions {
      bottom: 1rem;
      right: 1rem;
      gap: 0.6rem;
    }
  }

  .quick-fab {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .fab-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* WhatsApp Main Floating Action */
  .fab-whatsapp {
    background: #25d366;
    color: #ffffff;
    padding: 0.75rem 1.25rem 0.75rem 1.1rem;
    border-radius: var(--radius-full);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3);
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  .fab-whatsapp .fab-inner {
    gap: 0.6rem;
  }

  .whatsapp-logo {
    width: 26px;
    height: 26px;
  }

  .whatsapp-badge-pill {
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  @media (max-width: 480px) {
    .whatsapp-badge-pill {
      display: none;
    }
    .fab-whatsapp {
      width: 54px;
      height: 54px;
      padding: 0;
    }
  }

  .fab-whatsapp:hover {
    background: #20bd5a;
    transform: translateY(-4px) scale(1.04);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.6);
  }

  .online-indicator {
    position: absolute;
    top: -2px;
    left: -2px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 2px #25d366;
    animation: indicatorPulse 2s infinite;
  }

  @keyframes indicatorPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  /* Call Direct FAB */
  .fab-call {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--navy-surface-gradient);
    color: var(--gold-400);
    border: 1.5px solid var(--gold-500);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4), 0 0 15px rgba(212, 175, 55, 0.2);
    backdrop-filter: blur(12px);
  }

  .fab-call:hover {
    background: var(--gold-gradient);
    color: var(--navy-950);
    transform: translateY(-3px) scale(1.06);
    border-color: #ffffff;
    box-shadow: 0 10px 25px rgba(212, 175, 55, 0.45);
  }

  /* Wave FAB */
  .fab-wave {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #0086e5;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 6px 20px rgba(0, 134, 229, 0.45);
  }

  .fab-wave-svg {
    width: 24px;
    height: 24px;
  }

  .fab-wave:hover {
    background: #0077cc;
    transform: translateY(-3px) scale(1.06);
    box-shadow: 0 10px 25px rgba(0, 134, 229, 0.6);
  }

  /* Tooltip */
  .fab-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(10px);
    background: var(--navy-900);
    color: #ffffff;
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s ease;
  }

  .quick-fab:hover .fab-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* Scroll FAB */
  .fab-scroll {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(14, 32, 60, 0.85);
    color: var(--ivory-muted);
    border: 1px solid rgba(255, 255, 255, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8);
    transition: all 0.3s ease;
  }

  .fab-scroll.visible {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .fab-scroll:hover {
    background: var(--navy-700);
    color: var(--gold-400);
  }
</style>

<script>
  function setupFloatingActions() {
    const scrollBtn = document.getElementById('scroll-top-btn');
    if (!scrollBtn) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        scrollBtn.classList.add('visible');
      } else {
        scrollBtn.classList.remove('visible');
      }
    });

    scrollBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  document.addEventListener('DOMContentLoaded', setupFloatingActions);
</script>

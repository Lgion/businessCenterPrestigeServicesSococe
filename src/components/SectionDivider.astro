---
interface Props {
  type?: 'wave' | 'curve' | 'angle' | 'crest';
  flip?: boolean;
  color?: string;
  accentGold?: boolean;
}

const { 
  type = 'wave', 
  flip = false,
  color = '#08162b',
  accentGold = true 
} = Astro.props;
---

<div class={`section-divider ${type} ${flip ? 'flipped' : ''} ${accentGold ? 'with-gold' : ''}`} aria-hidden="true">
  {type === 'wave' && (
    <svg viewBox="0 0 1440 80" fill="none" preserveAspectRatio="none">
      <path d="M0,0 C320,60 480,20 720,50 C960,80 1120,30 1440,60 L1440,80 L0,80 Z" fill={color}/>
      {accentGold && (
        <path d="M0,0 C320,60 480,20 720,50 C960,80 1120,30 1440,60" stroke="url(#dividerGoldGrad)" stroke-width="1.8" opacity="0.6"/>
      )}
      <defs>
        <linearGradient id="dividerGoldGrad" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FFE082" stop-opacity="0.1"/>
          <stop offset="0.5" stop-color="#D4AF37" stop-opacity="0.8"/>
          <stop offset="1" stop-color="#996515" stop-opacity="0.1"/>
        </linearGradient>
      </defs>
    </svg>
  )}

  {type === 'curve' && (
    <svg viewBox="0 0 1440 70" fill="none" preserveAspectRatio="none">
      <path d="M0,35 Q720,80 1440,10 L1440,70 L0,70 Z" fill={color}/>
      {accentGold && (
        <path d="M0,35 Q720,80 1440,10" stroke="url(#curveGoldGrad)" stroke-width="1.8" opacity="0.55"/>
      )}
      <defs>
        <linearGradient id="curveGoldGrad" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FFE082" stop-opacity="0.2"/>
          <stop offset="0.5" stop-color="#D4AF37" stop-opacity="0.75"/>
          <stop offset="1" stop-color="#996515" stop-opacity="0.2"/>
        </linearGradient>
      </defs>
    </svg>
  )}

  {type === 'angle' && (
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none">
      <polygon points="0,60 1440,0 1440,60" fill={color}/>
      {accentGold && (
        <line x1="0" y1="60" x2="1440" y2="0" stroke="url(#angleGoldGrad)" stroke-width="1.5" opacity="0.6"/>
      )}
      <defs>
        <linearGradient id="angleGoldGrad" x1="0" y1="60" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FFE082" stop-opacity="0.2"/>
          <stop offset="0.5" stop-color="#D4AF37" stop-opacity="0.8"/>
          <stop offset="1" stop-color="#996515" stop-opacity="0.2"/>
        </linearGradient>
      </defs>
    </svg>
  )}

  {type === 'crest' && (
    <div class="crest-divider-container" style={`background-color: ${color}`}>
      <div class="crest-line"></div>
      <div class="crest-diamond">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <polygon points="12,2 22,12 12,22 2,12" stroke="#D4AF37" stroke-width="1.5" fill="#0c1e3b"/>
          <circle cx="12" cy="12" r="3" fill="#D4AF37"/>
        </svg>
      </div>
      <div class="crest-line"></div>
    </div>
  )}
</div>

<style>
  .section-divider {
    position: relative;
    width: 100%;
    line-height: 0;
    overflow: hidden;
    z-index: 2;
    pointer-events: none;
    margin-top: -1px;
    margin-bottom: -1px;
  }

  .section-divider svg {
    display: block;
    width: 100%;
    height: 48px;
  }

  @media (min-width: 768px) {
    .section-divider svg {
      height: 70px;
    }
  }

  .section-divider.flipped {
    transform: rotate(180deg);
  }

  /* Crest style */
  .crest-divider-container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 1.5rem;
    position: relative;
  }

  .crest-line {
    flex: 1;
    max-width: 400px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.4), transparent);
  }

  .crest-diamond {
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

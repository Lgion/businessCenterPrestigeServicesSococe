---
import { defaultSiteData } from '../data/siteData';
import { getAssetPath } from '../utils/assets';
const { boutiqueProducts, business } = defaultSiteData;
---

<!-- Subtle E-Commerce Modal Dialog -->
<dialog id="boutique-modal" class="boutique-dialog" aria-labelledby="boutique-modal-title">
  <div class="boutique-modal-wrapper">
    <!-- Header -->
    <div class="boutique-modal-header">
      <div class="boutique-head-brand">
        <div class="boutique-head-icon">🛍️</div>
        <div>
          <h3 id="boutique-modal-title" class="boutique-title font-serif">La Boutique du Super U</h3>
          <p class="boutique-sub">
            Articles neufs garantis en stock au magasin • Retrait comptoir & Paiement sécurisé PayDunya
          </p>
        </div>
      </div>

      <div class="boutique-head-actions">
        <!-- Cart Toggle Button -->
        <button type="button" id="btq-cart-toggle-btn" class="btq-cart-btn" aria-label="Ouvrir le panier">
          <span class="cart-icon">🛒</span>
          <span class="cart-label">Panier</span>
          <span class="cart-count-badge" id="cart-count-badge">0</span>
        </button>

        <!-- Close Button -->
        <button type="button" id="close-boutique-btn" class="boutique-close-btn" aria-label="Fermer la boutique">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- 2 Distinct Rayons / Sections Switcher -->
    <div class="boutique-pillars-bar" role="tablist" aria-label="Choisir le rayon">
      <button type="button" class="pillar-tab active" data-pillar="all" role="tab" aria-selected="true">
        <span class="tab-icon">🌟</span>
        <span>Tous les Articles ({boutiqueProducts.length})</span>
      </button>

      <button type="button" class="pillar-tab" data-pillar="hightech" role="tab" aria-selected="false">
        <span class="tab-icon">⚡</span>
        <div class="tab-texts">
          <span class="tab-main">Rayon 1 : High-Tech & Gaming</span>
          <span class="tab-sub">Manettes PS4/PS5, Câbles, 35W, Power Banks</span>
        </div>
      </button>

      <button type="button" class="pillar-tab" data-pillar="maroquinerie" role="tab" aria-selected="false">
        <span class="tab-icon">👜</span>
        <div class="tab-texts">
          <span class="tab-main">Rayon 2 : Maroquinerie & Montres</span>
          <span class="tab-sub">Sacs de luxe, Sacoches, Montres, Cadres</span>
        </div>
      </button>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="boutique-toolbar">
      <div class="boutique-search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="boutique-search-input" 
          class="boutique-search-input" 
          placeholder="Rechercher manette, sac, montre, chargeur..." 
        />
      </div>

      <div class="boutique-categories-bar" role="tablist">
        <button type="button" class="btq-cat-btn active" data-cat="all">Tous sous-types</button>
        <button type="button" class="btq-cat-btn" data-cat="gaming">Gaming & Consoles</button>
        <button type="button" class="btq-cat-btn" data-cat="accessoires">Connectique & Chargeurs</button>
        <button type="button" class="btq-cat-btn" data-cat="maroquinerie">Sacs & Maroquinerie</button>
        <button type="button" class="btq-cat-btn" data-cat="montres">Montres & Piles</button>
        <button type="button" class="btq-cat-btn" data-cat="cadeaux">Cadeaux & Cadres</button>
      </div>
    </div>

    <!-- Main Container: Products Grid OR Cart View -->
    <div class="boutique-body">
      <!-- Products Grid View -->
      <div class="boutique-products-grid" id="boutique-items-grid">
        {boutiqueProducts.map((prod) => (
          <article 
            class="btq-item-card prestige-card" 
            data-cat={prod.category} 
            data-pillar={prod.mainSection || 'hightech'}
            data-id={prod.id}
          >
            <div class="btq-item-media">
              <img 
                src={getAssetPath(prod.image)} 
                alt={prod.name} 
                class="btq-item-img" 
                loading="lazy"
                width="300"
                height="200"
              />
              <span class="btq-badge-tag">{prod.badge}</span>
              <span class="btq-pillar-tag">
                {prod.mainSection === 'maroquinerie' ? '👜 Maroquinerie' : '⚡ High-Tech'}
              </span>
            </div>

            <div class="btq-item-content">
              <div class="btq-meta-row">
                <span class="btq-stock-indicator">
                  <span class="stock-dot"></span> En stock Super U
                </span>
                <span class="btq-price-tag font-serif">{prod.price.toLocaleString('fr-FR')} FCFA</span>
              </div>

              <h4 class="btq-item-title">{prod.name}</h4>
              <p class="btq-item-desc">{prod.description}</p>

              <div class="btq-actions-row">
                <!-- Add to Cart (PayDunya) -->
                <button 
                  type="button" 
                  class="btn btn-gold btq-add-cart-btn"
                  data-prod-id={prod.id}
                  data-prod-name={prod.name}
                  data-prod-price={prod.price}
                  data-prod-img={getAssetPath(prod.image)}
                >
                  <span class="btn-icon">🛒</span>
                  <span>Ajouter au Panier</span>
                </button>

                <!-- WhatsApp fallback -->
                <a 
                  href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent(`Bonjour Business Center Prestige Services, je souhaite commander l'article : ${prod.name} à ${prod.price} FCFA vu dans votre boutique.`)}`}
                  class="btn btn-whatsapp-icon btq-wa-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Commander sur WhatsApp"
                >
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Slide-in Cart Drawer View (Hidden by default) -->
      <div class="boutique-cart-panel hidden" id="boutique-cart-panel">
        <div class="cart-panel-head">
          <div class="cart-head-title">
            <span class="cart-icon">🛒</span>
            <h4 class="font-serif">Mon Panier d'Achat</h4>
          </div>
          <button type="button" class="btn btn-navy-outline btn-sm" id="cart-back-to-shop-btn">
            ← Continuer mes achats
          </button>
        </div>

        <!-- Cart Items List Container -->
        <div class="cart-items-scroll" id="cart-items-container">
          <!-- Injected via JavaScript -->
        </div>

        <!-- Checkout Form & Totals -->
        <div class="cart-checkout-box prestige-card">
          <div class="cart-summary-row">
            <span class="summary-label">Sous-total :</span>
            <span class="summary-val font-serif" id="cart-subtotal-val">0 FCFA</span>
          </div>

          <div class="cart-delivery-selector">
            <label class="delivery-opt">
              <input type="radio" name="btq_delivery" value="comptoir" checked />
              <div class="delivery-opt-text">
                <strong>Retrait Gratuit au Magasin</strong>
                <span>Comptoir Super U Deux Plateaux (prêt en 15 min)</span>
              </div>
              <span class="delivery-cost">0 F</span>
            </label>

            <label class="delivery-opt">
              <input type="radio" name="btq_delivery" value="yango" />
              <div class="delivery-opt-text">
                <strong>Livraison Express Abidjan</strong>
                <span>Coursier Yango à domicile ou bureau</span>
              </div>
              <span class="delivery-cost">+2 000 F</span>
            </label>
          </div>

          <div class="cart-total-row">
            <span class="total-label">Total à Régler :</span>
            <span class="total-val gold-gradient-text font-serif" id="cart-total-val">0 FCFA</span>
          </div>

          <!-- Customer info -->
          <div class="checkout-fields-grid">
            <div class="form-group">
              <label>Votre Nom complet *</label>
              <input type="text" id="cart-cust-name" class="hub-input" placeholder="Ex: Jean Kouassi" required />
            </div>

            <div class="form-group">
              <label>Numéro de Téléphone (Wave / Orange / MTN) *</label>
              <input type="tel" id="cart-cust-phone" class="hub-input" placeholder="Ex: 0707070707" required />
            </div>

            <div class="form-group full-width delivery-address-group hidden" id="delivery-address-group">
              <label>Adresse de livraison précise à Abidjan</label>
              <input type="text" id="cart-cust-address" class="hub-input" placeholder="Commune, quartier, repère..." />
            </div>
          </div>

          <!-- Checkout actions -->
          <div class="checkout-actions-row">
            <button type="button" id="cart-pay-paydunya-btn" class="btn btn-gold w-100 checkout-btn">
              <span class="btn-lock">🔒</span>
              <span>Payer en ligne via PayDunya</span>
              <span class="payment-methods-mini">(Wave, Orange, MTN, CB)</span>
            </button>

            <button type="button" id="cart-pay-whatsapp-btn" class="btn btn-whatsapp w-100">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>Finaliser ma Commande sur WhatsApp</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Sticky Bottom Bar when Cart has items (Only shown if cart > 0) -->
    <div class="btq-sticky-cart-bar hidden" id="btq-sticky-cart-bar">
      <div class="sticky-cart-info">
        <span class="sticky-count-pill" id="sticky-cart-count">0 article</span>
        <span class="sticky-total font-serif" id="sticky-cart-total">0 FCFA</span>
      </div>
      <button type="button" class="btn btn-gold btn-sm" id="sticky-view-cart-btn">
        <span>Voir mon Panier & Payer</span>
        <span>→</span>
      </button>
    </div>

    <!-- Footer Note -->
    <div class="boutique-modal-footer">
      <div class="footer-notice">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>Possibilité d'essayer ou tester tous les articles en magasin au Super U Deux Plateaux avant achat.</span>
      </div>
      <a 
        href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent('Bonjour, je recherche un article spécifique dans votre boutique : ')}`}
        class="footer-ask-btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        Demander un article non listé
      </a>
    </div>
  </div>
</dialog>

<!-- Floating Boutique Trigger (Bottom-Left) -->
<div class="floating-boutique-container">
  <button 
    type="button" 
    class="fixed-boutique-btn open-boutique-trigger" 
    id="open-boutique-btn"
    aria-label="Ouvrir la boutique du Super U"
  >
    <div class="boutique-btn-inner">
      <div class="boutique-icon-wrap">
        <svg class="bag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="stock-pulse-dot"></span>
        <span class="floating-cart-count hidden" id="floating-cart-badge">0</span>
      </div>
      <div class="boutique-btn-texts">
        <span class="btn-main-label">Boutique Super U</span>
        <span class="btn-sub-label">High-Tech & Maroquinerie</span>
      </div>
    </div>
  </button>
</div>

<style>
  /* Fixed Floating Button in Bottom-Left */
  .floating-boutique-container {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 9990;
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .floating-boutique-container {
      bottom: 1rem;
      left: 1rem;
    }
  }

  .fixed-boutique-btn {
    background: linear-gradient(135deg, #0e223f 0%, #061120 100%);
    border: 1.5px solid var(--gold-500);
    border-radius: var(--radius-full);
    padding: 0.65rem 1.25rem 0.65rem 0.9rem;
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(212, 175, 55, 0.25);
    backdrop-filter: blur(14px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
  }

  .fixed-boutique-btn:hover {
    transform: translateY(-4px) scale(1.03);
    border-color: #ffe082;
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.6), 0 0 28px rgba(212, 175, 55, 0.4);
    background: linear-gradient(135deg, #132e54 0%, #0a1b32 100%);
  }

  .boutique-btn-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .boutique-icon-wrap {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: var(--navy-950);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .bag-icon {
    width: 20px;
    height: 20px;
  }

  .stock-pulse-dot {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 2px #0e223f;
    animation: stockPulse 2s infinite;
  }

  .floating-cart-count {
    position: absolute;
    bottom: -4px;
    right: -4px;
    background: #ef4444;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  }

  @keyframes stockPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
  }

  .boutique-btn-texts {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .btn-main-label {
    font-weight: 800;
    font-size: 0.88rem;
    color: #ffffff;
    line-height: 1.2;
  }

  .btn-sub-label {
    font-size: 0.7rem;
    color: var(--gold-400);
    line-height: 1.2;
  }

  /* Modal Dialog */
  .boutique-dialog {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 1100px;
    width: 95vw;
    margin: auto;
    border-radius: 24px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.8), 0 0 40px rgba(212, 175, 55, 0.2);
    overflow: hidden;
  }

  .boutique-dialog::backdrop {
    background: rgba(4, 10, 20, 0.82);
    backdrop-filter: blur(10px);
  }

  .boutique-modal-wrapper {
    background: linear-gradient(180deg, #0b1c36 0%, #061122 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.4);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    overflow: hidden;
  }

  /* Modal Header */
  .boutique-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.6rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    background: rgba(10, 24, 48, 0.95);
    backdrop-filter: blur(12px);
  }

  .boutique-head-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .boutique-head-icon {
    font-size: 1.7rem;
  }

  .boutique-title {
    font-size: 1.35rem;
    color: #ffffff;
    margin: 0;
  }

  .boutique-sub {
    font-size: 0.8rem;
    color: var(--ivory-muted);
    margin: 0.2rem 0 0;
  }

  .boutique-head-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btq-cart-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.4);
    color: #ffffff;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btq-cart-btn:hover {
    background: var(--gold-gradient);
    color: var(--navy-950);
    border-color: #ffe082;
  }

  .cart-count-badge {
    background: var(--gold-gradient);
    color: var(--navy-950);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .btq-cart-btn:hover .cart-count-badge {
    background: var(--navy-950);
    color: var(--gold-300);
  }

  .boutique-close-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .boutique-close-btn:hover {
    background: rgba(239, 68, 68, 0.25);
    border-color: #ef4444;
    color: #ef4444;
  }

  /* 2 Distinct Pillars Bar */
  .boutique-pillars-bar {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 0.6rem;
    padding: 0.75rem 1.6rem;
    background: rgba(8, 18, 36, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 768px) {
    .boutique-pillars-bar {
      grid-template-columns: 1fr;
    }
  }

  .pillar-tab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-radius: 12px;
    background: rgba(14, 34, 64, 0.6);
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    color: var(--ivory-muted);
    cursor: pointer;
    text-align: left;
    transition: all 0.25s ease;
  }

  .pillar-tab .tab-icon {
    font-size: 1.3rem;
  }

  .pillar-tab .tab-texts {
    display: flex;
    flex-direction: column;
  }

  .pillar-tab .tab-main {
    font-weight: 800;
    font-size: 0.88rem;
    color: #ffffff;
  }

  .pillar-tab .tab-sub {
    font-size: 0.7rem;
    color: var(--ivory-muted);
  }

  .pillar-tab:hover {
    border-color: rgba(212, 175, 55, 0.5);
    background: rgba(18, 44, 82, 0.8);

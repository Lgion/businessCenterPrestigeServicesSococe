</style>

<script>
  interface CartItem {
    id: string;
    name: string;
    price: number;
    img: string;
    quantity: number;
  }

  function setupBoutiqueModal() {
    const dialog = document.getElementById('boutique-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('close-boutique-btn');
    const searchInput = document.getElementById('boutique-search-input') as HTMLInputElement | null;
    const pillarTabs = document.querySelectorAll('.pillar-tab');
    const catBtns = document.querySelectorAll('.btq-cat-btn');
    const cards = document.querySelectorAll('.btq-item-card');

    // Cart Elements
    const cartToggleBtn = document.getElementById('btq-cart-toggle-btn');
    const cartPanel = document.getElementById('boutique-cart-panel');
    const productsGrid = document.getElementById('boutique-items-grid');
    const backToShopBtn = document.getElementById('cart-back-to-shop-btn');
    const cartItemsContainer = document.getElementById('cart-items-container');
    const cartCountBadge = document.getElementById('cart-count-badge');
    const floatingCartBadge = document.getElementById('floating-cart-badge');
    const cartSubtotalVal = document.getElementById('cart-subtotal-val');
    const cartTotalVal = document.getElementById('cart-total-val');
    const stickyCartBar = document.getElementById('btq-sticky-cart-bar');
    const stickyCartCount = document.getElementById('sticky-cart-count');
    const stickyCartTotal = document.getElementById('sticky-cart-total');
    const stickyViewCartBtn = document.getElementById('sticky-view-cart-btn');

    // Delivery & Form Elements
    const deliveryRadios = document.querySelectorAll('input[name="btq_delivery"]');
    const deliveryAddressGroup = document.getElementById('delivery-address-group');
    const custNameInput = document.getElementById('cart-cust-name') as HTMLInputElement | null;
    const custPhoneInput = document.getElementById('cart-cust-phone') as HTMLInputElement | null;
    const custAddressInput = document.getElementById('cart-cust-address') as HTMLInputElement | null;
    const payPaydunyaBtn = document.getElementById('cart-pay-paydunya-btn') as HTMLButtonElement | null;
    const payWhatsappBtn = document.getElementById('cart-pay-whatsapp-btn');

    if (!dialog) return;

    // Cart state
    let cart: CartItem[] = [];
    try {
      const saved = localStorage.getItem('bcps_boutique_cart');
      if (saved) cart = JSON.parse(saved);
    } catch (_) {}

    function saveCart() {
      try {
        localStorage.setItem('bcps_boutique_cart', JSON.stringify(cart));
        window.dispatchEvent(new CustomEvent('cart-updated'));
      } catch (_) {}
      updateCartUI();
    }

    function getSelectedDeliveryFee(): number {
      const selected = document.querySelector('input[name="btq_delivery"]:checked') as HTMLInputElement | null;
      return selected?.value === 'yango' ? 2000 : 0;
    }

    function updateCartUI() {
      const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
      const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const deliveryFee = totalCount > 0 ? getSelectedDeliveryFee() : 0;
      const total = subtotal + deliveryFee;

      // Badges
      if (cartCountBadge) cartCountBadge.textContent = totalCount.toString();
      if (floatingCartBadge) {
        floatingCartBadge.textContent = totalCount.toString();
        floatingCartBadge.classList.toggle('hidden', totalCount === 0);
      }

      // Sticky bar
      if (stickyCartBar) {
        stickyCartBar.classList.toggle('hidden', totalCount === 0 || !cartPanel?.classList.contains('hidden'));
        if (stickyCartCount) stickyCartCount.textContent = `${totalCount} article${totalCount > 1 ? 's' : ''}`;
        if (stickyCartTotal) stickyCartTotal.textContent = `${total.toLocaleString('fr-FR')} FCFA`;
      }

      // Totals
      if (cartSubtotalVal) cartSubtotalVal.textContent = `${subtotal.toLocaleString('fr-FR')} FCFA`;
      if (cartTotalVal) cartTotalVal.textContent = `${total.toLocaleString('fr-FR')} FCFA`;

      // Render cart items
      if (cartItemsContainer) {
        if (cart.length === 0) {
          cartItemsContainer.innerHTML = `
            <div class="cart-empty-message">
              <p style="font-size: 2.2rem; margin-bottom: 0.5rem;">🛍️</p>
              <p>Votre panier est vide pour le moment.</p>
              <p style="font-size: 0.8rem; opacity: 0.7;">Découvrez nos articles High-Tech et Maroquinerie et ajoutez vos coups de cœur !</p>
            </div>
          `;
        } else {
          cartItemsContainer.innerHTML = cart.map(item => `
            <div class="cart-item-row" data-id="${item.id}">
              <img src="${item.img}" alt="${item.name}" class="cart-item-img" />
              <div class="cart-item-details">
                <span class="cart-item-name">${item.name}</span>
                <span class="cart-item-price">${(item.price * item.quantity).toLocaleString('fr-FR')} FCFA (${item.price.toLocaleString('fr-FR')} F/u)</span>
              </div>
              <div class="cart-qty-ctrls">
                <button type="button" class="cart-qty-btn btn-minus" data-id="${item.id}">-</button>
                <span class="cart-qty-val">${item.quantity}</span>
                <button type="button" class="cart-qty-btn btn-plus" data-id="${item.id}">+</button>
              </div>
              <button type="button" class="cart-item-remove-btn" data-id="${item.id}" title="Supprimer">🗑️</button>
            </div>
          `).join('');

          // Bind qty buttons
          cartItemsContainer.querySelectorAll('.btn-minus').forEach(btn => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-id');
              const item = cart.find(i => i.id === id);
              if (item) {
                if (item.quantity > 1) {
                  item.quantity--;
                } else {
                  cart = cart.filter(i => i.id !== id);
                }
                saveCart();
              }
            });
          });

          cartItemsContainer.querySelectorAll('.btn-plus').forEach(btn => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-id');
              const item = cart.find(i => i.id === id);
              if (item) {
                item.quantity++;
                saveCart();
              }
            });
          });

          cartItemsContainer.querySelectorAll('.cart-item-remove-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-id');
              cart = cart.filter(i => i.id !== id);
              saveCart();
            });
          });
        }
      }
    }

    const toolbar = document.querySelector('.boutique-toolbar') as HTMLElement | null;
    const pillarsBar = document.querySelector('.boutique-pillars-bar') as HTMLElement | null;

    // Toggle Cart View vs Products View
    function showCartView() {
      productsGrid?.classList.add('hidden');
      cartPanel?.classList.remove('hidden');
      stickyCartBar?.classList.add('hidden');
      if (toolbar) toolbar.style.display = 'none';
      if (pillarsBar) pillarsBar.style.display = 'none';
      updateCartUI();
    }

    function showProductsView() {
      cartPanel?.classList.add('hidden');
      productsGrid?.classList.remove('hidden');
      if (toolbar) toolbar.style.display = '';
      if (pillarsBar) pillarsBar.style.display = '';
      updateCartUI();
    }

    cartToggleBtn?.addEventListener('click', () => {
      if (cartPanel?.classList.contains('hidden')) {
        showCartView();
      } else {
        showProductsView();
      }
    });

    backToShopBtn?.addEventListener('click', showProductsView);
    stickyViewCartBtn?.addEventListener('click', showCartView);

    window.addEventListener('render-cart-view', () => {
      showCartView();
    });

    // Delivery radio change
    deliveryRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        const isYango = (radio as HTMLInputElement).value === 'yango';
        deliveryAddressGroup?.classList.toggle('hidden', !isYango);
        updateCartUI();
      });
    });

    // Add to cart buttons
    document.querySelectorAll('.btq-add-cart-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-prod-id') || '';
        const name = btn.getAttribute('data-prod-name') || '';
        const price = parseInt(btn.getAttribute('data-prod-price') || '0', 10);
        const img = btn.getAttribute('data-prod-img') || '';

        const existing = cart.find(i => i.id === id);
        if (existing) {
          existing.quantity++;
        } else {
          cart.push({ id, name, price, img, quantity: 1 });
        }
        saveCart();

        // Feedback
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span>✅ Ajouté !</span>';
        btn.classList.add('btn-success');
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.classList.remove('btn-success');
        }, 1200);
      });
    });

    // PayDunya Checkout Button
    payPaydunyaBtn?.addEventListener('click', async () => {
      if (cart.length === 0) {
        alert('Votre panier est vide.');
        return;
      }

      const name = custNameInput?.value.trim() || '';
      const phone = custPhoneInput?.value.trim() || '';
      const deliveryMode = (document.querySelector('input[name="btq_delivery"]:checked') as HTMLInputElement)?.value || 'comptoir';
      const address = custAddressInput?.value.trim() || '';

      if (!name) {
        alert('Veuillez renseigner votre nom complet.');
        custNameInput?.focus();
        return;
      }

      if (!phone) {
        alert('Veuillez renseigner votre numéro de téléphone.');
        custPhoneInput?.focus();
        return;
      }

      if (deliveryMode === 'yango' && !address) {
        alert('Veuillez préciser votre adresse de livraison.');
        custAddressInput?.focus();
        return;
      }

      const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const deliveryFee = deliveryMode === 'yango' ? 2000 : 0;
      const total = subtotal + deliveryFee;

      const orderItems = cart.map(i => ({
        name: i.name,
        unitPrice: i.price,
        quantity: i.quantity,
        total: i.price * i.quantity
      }));

      if (deliveryFee > 0) {
        orderItems.push({
          name: 'Frais de livraison coursier Yango Abidjan',
          unitPrice: deliveryFee,
          quantity: 1,
          total: deliveryFee
        });
      }

      payPaydunyaBtn.disabled = true;
      const originalBtnText = payPaydunyaBtn.innerHTML;
      payPaydunyaBtn.innerHTML = '<span>⏳ Connexion au tunnel PayDunya...</span>';

      try {
        const response = await fetch('/api/checkout/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            category: 'boutique',
            title: `Achat Boutique (${cart.length} articles)`,
            amount: total,
            items: orderItems,
            customerName: name,
            customerPhone: phone,
            customerEmail: '',
            deliveryAddress: address,
            pickupType: deliveryMode,
            metadata: {
              articleCount: cart.length,
              source: 'boutique_modal'
            }
          })
        });

        const data = await response.json();
        if (data.success && data.paymentUrl) {
          // Clear cart on successful checkout redirect
          localStorage.removeItem('bcps_boutique_cart');
          window.location.href = data.paymentUrl;
        } else {
          alert('Erreur d\'initialisation du paiement: ' + (data.error || 'Veuillez réessayer.'));
          payPaydunyaBtn.disabled = false;
          payPaydunyaBtn.innerHTML = originalBtnText;
        }
      } catch (err: any) {
        alert('Erreur réseau : ' + err.message);
        payPaydunyaBtn.disabled = false;
        payPaydunyaBtn.innerHTML = originalBtnText;
      }
    });

    // WhatsApp Checkout Fallback
    payWhatsappBtn?.addEventListener('click', () => {
      if (cart.length === 0) {
        alert('Votre panier est vide.');
        return;
      }
      const name = custNameInput?.value.trim() || 'Client';
      const deliveryMode = (document.querySelector('input[name="btq_delivery"]:checked') as HTMLInputElement)?.value || 'comptoir';
      const address = custAddressInput?.value.trim() || 'Comptoir Super U';
      const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const deliveryFee = deliveryMode === 'yango' ? 2000 : 0;
      const total = subtotal + deliveryFee;

      let msg = `Bonjour Business Center Prestige Services,\nJe souhaite valider ma commande boutique :\n\n`;
      cart.forEach((item, idx) => {
        msg += `${idx + 1}. ${item.name} x${item.quantity} = ${(item.price * item.quantity).toLocaleString('fr-FR')} FCFA\n`;
      });
      if (deliveryFee > 0) {
        msg += `+ Livraison Coursier Yango : 2 000 FCFA\n`;
      }
      msg += `\n*TOTAL : ${total.toLocaleString('fr-FR')} FCFA*\n`;
      msg += `Nom : ${name}\nMode : ${deliveryMode === 'yango' ? 'Livraison à domicile' : 'Retrait comptoir Super U'}\n`;
      if (deliveryMode === 'yango') msg += `Adresse : ${address}\n`;

      window.open(`https://wa.me/2250707338575?text=${encodeURIComponent(msg)}`, '_blank');
    });

    // Open triggers
    document.querySelectorAll('.open-boutique-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        showProductsView();
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());

    // Backdrop click close
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) dialog.close();
    });

    // Filtering & Search
    let activePillar = 'all';
    let activeCat = 'all';
    let searchQuery = '';

    function filterItems() {
      cards.forEach(card => {
        const pillar = card.getAttribute('data-pillar') || 'hightech';
        const cat = card.getAttribute('data-cat') || '';
        const title = card.querySelector('.btq-item-title')?.textContent?.toLowerCase() || '';
        const desc = card.querySelector('.btq-item-desc')?.textContent?.toLowerCase() || '';

        const matchesPillar = (activePillar === 'all' || pillar === activePillar);
        const matchesCat = (activeCat === 'all' || cat === activeCat);
        const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);

        if (matchesPillar && matchesCat && matchesSearch) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    pillarTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        pillarTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        activePillar = tab.getAttribute('data-pillar') || 'all';
        showProductsView();
        filterItems();
      });
    });

    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCat = btn.getAttribute('data-cat') || 'all';
        showProductsView();
        filterItems();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      showProductsView();
      filterItems();
    });

    // Initial cart load
    updateCartUI();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBoutiqueModal);
  } else {
    setupBoutiqueModal();
  }
</script>

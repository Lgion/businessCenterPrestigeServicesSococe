---
import { defaultSiteData } from '../data/siteData';
const { pricingPackages, business } = defaultSiteData;
---

<section class="pricing-section" id="tarifs">
  <div class="container">
    <div class="pricing-header text-center">
      <span class="section-tagline">Transparence & Prix Doux</span>
      <h2 class="section-title">
        Nos Formules & <span class="gold-gradient-text">Tarifs Phares</span>
      </h2>
      <p class="section-subtitle">
        Des tarifs très abordables et étudiés pour les particuliers et professionnels. Devis personnalisé 100% gratuit et réponse instantanée sur WhatsApp.
      </p>
    </div>

    <!-- Pricing Carousel Controls & Header -->
    <div class="pricing-carousel-top-bar">
      <div class="pricing-carousel-hint">
        <span class="hint-icon">👉</span>
        <span>Faites défiler horizontalement pour découvrir nos 10 formules ({pricingPackages.length})</span>
      </div>
      <div class="pricing-carousel-controls">
        <button type="button" class="pricing-nav-btn prev-btn" id="pricing-carousel-prev" aria-label="Tarif précédent">
          ‹
        </button>
        <button type="button" class="pricing-nav-btn next-btn" id="pricing-carousel-next" aria-label="Tarif suivant">
          ›
        </button>
      </div>
    </div>

    <!-- Pricing Cards Carousel Track -->
    <div class="pricing-carousel-track" id="pricing-carousel-track" tabindex="0" role="region" aria-label="Carrousel des formules tarifaires">
      {pricingPackages.map((pkg) => (
        <div class={`pricing-card prestige-card ${pkg.popular ? 'popular-card' : ''}`}>
          {pkg.popular && (
            <div class="popular-ribbon">
              <span>Formule Populaire</span>
            </div>
          )}

          <div class="pkg-header">
            <span class="pkg-category">{pkg.category}</span>
            <h3 class="pkg-title font-serif">{pkg.title}</h3>
            <div class="pkg-price-wrap">
              <span class="pkg-price font-serif">{pkg.price}</span>
              {pkg.period && <span class="pkg-period">/ {pkg.period}</span>}
            </div>
          </div>

          <ul class="pkg-features">
            {pkg.features.map((feat) => (
              <li class="pkg-feat-item">
                <svg class="feat-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="pkg-footer">
            <a 
              href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent(pkg.ctaMessage)}`}
              class={`btn w-100 ${pkg.popular ? 'btn-gold' : 'btn-whatsapp'}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {pkg.ctaText}
            </a>

            <button 
              type="button" 
              class="pricing-wave-btn open-wave-modal-trigger"
              title="Payer cette formule par Wave"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
              </svg>
              <span>Régler par Wave</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Carousel Dots Indicator -->
    <div class="pricing-carousel-dots" id="pricing-carousel-dots" aria-hidden="true">
      {pricingPackages.map((_, i) => (
        <button type="button" class={`pricing-dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Tarif ${i + 1}`}></button>
      ))}
    </div>

    <!-- Interactive Instant Quote Simulator -->
    <div class="quote-simulator-box prestige-card">
      <div class="simulator-header">
        <div class="sim-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <div>
          <h3 class="sim-title font-serif">Simulateur & Demande de Devis Express</h3>
          <p class="sim-desc">Sélectionnez votre besoin pour obtenir une estimation immédiate et finaliser en 1 clic sur WhatsApp.</p>
        </div>
      </div>

      <div class="simulator-body">
        <div class="sim-form-grid">
          <div class="form-group">
            <label for="sim-service-select">Pôle de service</label>
            <select id="sim-service-select" class="sim-select">
              <option value="photo_identite">Photos d'Identité Express (Planche de 8)</option>
              <option value="shooting_portrait">Shooting Studio Solo / Famille</option>
              <option value="reparation_ecran">Réparation d'écran smartphone</option>
              <option value="reparation_batterie">Changement de batterie</option>
              <option value="achat_accessoire">Achat accessoire / Manette PS4 / PS5</option>
              <option value="impression_volume">Impression & Reliure de documents</option>
              <option value="reportage_evenement">Reportage Photo & Vidéo Mariage / Cérémonie</option>
            </select>
          </div>

          <div class="form-group">
            <label for="sim-quantity-input">Quantité / Précision</label>
            <input type="text" id="sim-quantity-input" class="sim-input" placeholder="Ex: iPhone 13, ou 50 pages couleur..." />
          </div>

          <div class="sim-estimate-card">
            <span class="estimate-label">Estimation indicative :</span>
            <span class="estimate-value font-serif" id="sim-estimate-display">2 500 FCFA</span>
            <span class="estimate-note">Devis final confirmé sans frais sur WhatsApp</span>
          </div>
        </div>

        <div class="sim-actions-row">
          <button type="button" id="sim-whatsapp-send-btn" class="btn btn-whatsapp sim-send-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Envoyer ma demande sur WhatsApp</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: 5rem 0;
    background-color: var(--navy-950);
    position: relative;
    z-index: 1;
  }

  .text-center {
    text-align: center;
  }

  .pricing-header {
    margin-bottom: 3.5rem;
  }

  /* Pricing Carousel Track */
  .pricing-carousel-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    gap: 1rem;
  }

  .pricing-carousel-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--gold-300);
    font-weight: 600;
  }

  .pricing-carousel-controls {
    display: flex;
    gap: 0.6rem;
  }

  .pricing-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(14, 34, 64, 0.85);
    border: 1.5px solid rgba(212, 175, 55, 0.4);
    color: var(--gold-300);
    font-size: 1.6rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
    backdrop-filter: blur(8px);
  }

  .pricing-nav-btn:hover {
    background: var(--gold-gradient);
    color: var(--navy-950);
    border-color: #ffe082;
    transform: scale(1.08);
    box-shadow: 0 0 16px rgba(212, 175, 55, 0.4);
  }

  .pricing-carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 0.75rem 0.25rem 1.75rem;
    margin-bottom: 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(212, 175, 55, 0.3) transparent;
  }

  .pricing-carousel-track::-webkit-scrollbar {
    height: 6px;
  }

  .pricing-carousel-track::-webkit-scrollbar-thumb {
    background: rgba(212, 175, 55, 0.35);
    border-radius: 999px;
  }

  .pricing-card {
    flex: 0 0 calc(33.333% - 1rem);
    min-width: 290px;
    max-width: 360px;
    scroll-snap-align: start;
    padding: 2.2rem 1.6rem 1.6rem;
    display: flex;
    flex-direction: column;
    position: relative;
    border-radius: 18px;
    background: rgba(12, 28, 54, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.25);
    transition: all 0.3s ease;
  }

  @media (max-width: 1024px) {
    .pricing-card {
      flex: 0 0 calc(50% - 0.75rem);
    }
  }

  @media (max-width: 640px) {
    .pricing-card {
      flex: 0 0 88%;
      min-width: 260px;
    }
    .pricing-carousel-hint span:last-child {
      font-size: 0.78rem;
    }
  }

  .pricing-carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 3.5rem;
  }

  .pricing-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .pricing-dot.active {
    width: 24px;
    background: var(--gold-400);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.5);
  }

  .popular-card {
    border-color: var(--gold-500);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(212, 175, 55, 0.2);
    transform: translateY(-4px);
  }

  .popular-ribbon {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gold-gradient);
    color: var(--navy-950);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 1rem;
    border-radius: 0 0 10px 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .pkg-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pkg-category {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--gold-400);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pkg-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0.35rem 0 0.8rem;
  }

  .pkg-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .pkg-price {
    font-size: 1.7rem;
    font-weight: 800;
    color: #ffffff;
  }

  .pkg-period {
    font-size: 0.82rem;
    color: var(--ivory-muted);
  }

  /* Features */
  .pkg-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex: 1;
  }

  .pkg-feat-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.84rem;
    color: #cbd5e1;
    line-height: 1.35;
  }

  .feat-check {
    color: var(--gold-400);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pkg-footer {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .w-100 {
    width: 100%;
  }

  .pricing-wave-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: transparent;
    color: #38bdf8;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.3rem 0;
    transition: color 0.2s;
  }

  .pricing-wave-btn:hover {
    color: #ffffff;
  }

  /* Simulator */
  .quote-simulator-box {
    padding: 2.2rem;
    border: 1px solid rgba(212, 175, 55, 0.4);
    background: linear-gradient(135deg, rgba(14, 34, 64, 0.9) 0%, rgba(8, 22, 43, 0.98) 100%);
  }

  .simulator-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.8rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .sim-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--gold-gradient);
    color: var(--navy-950);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sim-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
  }

  .sim-desc {
    font-size: 0.88rem;
    color: var(--ivory-muted);
  }

  .sim-form-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 1.2rem;
    align-items: flex-end;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .sim-form-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-group label {
    font-size: 0.84rem;
    font-weight: 700;
    color: #ffffff;
  }

  .sim-select, .sim-input {
    background: rgba(6, 14, 26, 0.75);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: #ffffff;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .sim-select:focus, .sim-input:focus {
    border-color: var(--gold-400);
  }

  .sim-estimate-card {
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 10px;
    padding: 0.7rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .estimate-label {
    font-size: 0.74rem;
    color: var(--gold-400);
    font-weight: 700;
    text-transform: uppercase;
  }

  .estimate-value {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
  }

  .estimate-note {
    font-size: 0.68rem;
    color: var(--ivory-muted);
  }

  .sim-actions-row {
    display: flex;
    justify-content: flex-end;
  }

  .sim-send-btn {
    padding: 0.85rem 1.8rem;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .sim-send-btn {
      width: 100%;
    }
  }
</style>

<script>
  function setupPricingCarousel() {
    const track = document.getElementById('pricing-carousel-track') as HTMLElement | null;
    const prevBtn = document.getElementById('pricing-carousel-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('pricing-carousel-next') as HTMLButtonElement | null;
    const dots = document.querySelectorAll('#pricing-carousel-dots .pricing-dot');

    if (!track) return;

    function getCardWidth(): number {
      const card = track?.querySelector('.pricing-card') as HTMLElement | null;
      return card ? card.offsetWidth + 24 : 320;
    }

    prevBtn?.addEventListener('click', () => {
      track?.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      track?.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
    });

    // Keyboard support
    track.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        track.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
      } else if (e.key === 'ArrowRight') {
        track.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
      }
    });

    // Scroll listener for dots
    track.addEventListener('scroll', () => {
      const cardWidth = getCardWidth();
      const activeIdx = Math.min(
        dots.length - 1,
        Math.max(0, Math.round((track?.scrollLeft || 0) / cardWidth))
      );
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeIdx);
      });
    }, { passive: true });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        track?.scrollTo({ left: idx * getCardWidth(), behavior: 'smooth' });
      });
    });
  }

  function setupQuoteSimulator() {
    const select = document.getElementById('sim-service-select') as HTMLSelectElement | null;
    const input = document.getElementById('sim-quantity-input') as HTMLInputElement | null;
    const display = document.getElementById('sim-estimate-display');
    const sendBtn = document.getElementById('sim-whatsapp-send-btn');

    const ratesMap: Record<string, { label: string; est: string }> = {
      'photo_identite': { label: "Photos d'identité express (8 photos)", est: "2 500 FCFA" },
      'shooting_portrait': { label: "Shooting studio d'art", est: "15 000 FCFA" },
      'reparation_ecran': { label: "Remplacement écran smartphone", est: "Sur devis (dès 12 000 F)" },
      'reparation_batterie': { label: "Changement de batterie neuve", est: "Sur devis (dès 8 000 F)" },
      'achat_accessoire': { label: "Accessoire tech / Manette de jeu", est: "Dès 4 500 FCFA" },
      'impression_volume': { label: "Impression & reliure de documents", est: "Dès 50 FCFA / page" },
      'reportage_evenement': { label: "Couverture événement / Mariage", est: "Sur devis (dès 100 000 F)" }
    };

    function updateEstimate() {
      if (!select) return;
      const val = select.value;
      const rate = ratesMap[val];
      if (rate && display) {
        display.textContent = rate.est;
      }
    }

    select?.addEventListener('change', updateEstimate);

    sendBtn?.addEventListener('click', () => {
      if (!select) return;
      const val = select.value;
      const serviceInfo = ratesMap[val] || { label: select.options[select.selectedIndex]?.text, est: '' };
      const detail = input?.value.trim() || 'Non précisé';
      const msg = `Bonjour Business Center Prestige Services, je souhaite obtenir un devis pour : ${serviceInfo.label}. Précision : ${detail}. Merci de me recontacter !`;
      
      const whatsappUrl = `https://wa.me/2250707338575?text=${encodeURIComponent(msg)}`;
      window.open(whatsappUrl, '_blank');
    });
  }

  function initPricing() {
    setupPricingCarousel();
    setupQuoteSimulator();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPricing);
  } else {
    initPricing();
  }
</script>

---
import { defaultSiteData } from '../data/siteData';
import { getAssetPath } from '../utils/assets';
const { seasonalShowcase, business } = defaultSiteData;
---

<section class="seasonal-section" id="saison">
  <div class="container">
    <!-- Header -->
    <div class="seasonal-header text-center">
      <div class="gold-badge">
        <span>✨ Vitrine Événementielle Dynamique</span>
      </div>
      <h2 class="section-title" data-admin-bind="seasonTitle">
        {seasonalShowcase.title}
      </h2>
      <p class="section-subtitle" data-admin-bind="seasonSubtitle">
        {seasonalShowcase.subtitle}
      </p>

      <!-- Season Tabs -->
      <div class="season-tabs-row" role="tablist">
        {seasonalShowcase.seasons.map((season, index) => (
          <button 
            type="button" 
            class={`season-tab-btn ${season.id === seasonalShowcase.activeSeasonId ? 'active' : ''}`}
            data-season-target={season.id}
            role="tab"
          >
            <span class="tab-label">{season.name}</span>
            <span class="tab-badge">{season.tag}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Active Promo Highlight Banner -->
    <div class="seasonal-promo-banner" id="active-season-banner">
      <div class="promo-tag-col">
        <span class="promo-fire-icon">🔥</span>
        <div>
          <span class="promo-title" id="banner-season-promo">Offre Spéciale Rentrée Scolaire</span>
          <p class="promo-desc" id="banner-season-desc">Bénéficiez de tarifs préférentiels sur nos sacs ergonomiques et nos forfaits photos d'identité express !</p>
        </div>
      </div>
      <a 
        href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite profiter de la promotion saisonnière en cours.')}`}
        class="btn btn-gold btn-sm"
        target="_blank"
        rel="noopener noreferrer"
      >
        Profiter de l'Offre sur WhatsApp
      </a>
    </div>

    <!-- Products Showcase Cards -->
    <div class="seasonal-products-grid" id="seasonal-products-container">
      {seasonalShowcase.products.map((product) => (
        <div class="product-card prestige-card" data-season={product.seasonId}>
          <div class="product-media">
            <img 
              src={getAssetPath(product.image)} 
              alt={product.name} 
              class="product-img" 
              loading="lazy"
              width="400"
              height="280"
            />
            <div class="product-badge-overlay">{product.badge}</div>
          </div>

          <div class="product-details">
            <div class="product-price-row">
              <span class="product-price font-serif">{product.price.toLocaleString('fr-FR')} FCFA</span>
              <button 
                type="button" 
                class="prod-wave-trigger open-wave-modal-trigger"
                title="Payer directement ce produit par Wave"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
                </svg>
                Wave
              </button>
            </div>

            <h3 class="product-name">{product.name}</h3>
            <p class="product-desc">{product.description}</p>

            <div class="product-actions">
              <a 
                href={`https://wa.me/225${business.whatsapp}?text=${encodeURIComponent(`Bonjour, je souhaite commander l'article : ${product.name} à ${product.price} FCFA.`)}`}
                class="btn btn-whatsapp product-buy-btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                <span>Commander sur WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .seasonal-section {
    padding: 5rem 0;
    background: linear-gradient(180deg, #08162b 0%, #0c1e3b 50%, #08162b 100%);
    position: relative;
    z-index: 1;
  }

  .text-center {
    text-align: center;
  }

  .seasonal-header {
    margin-bottom: 2.5rem;
  }

  .seasonal-header .gold-badge {
    margin-bottom: 0.9rem;
  }

  /* Season Tabs */
  .season-tabs-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .season-tab-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-md);
    background: rgba(14, 32, 60, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.25);
    color: var(--ivory-muted);
    transition: all 0.25s ease;
  }

  .season-tab-btn:hover {
    border-color: var(--gold-400);
    color: #ffffff;
    background: rgba(212, 175, 55, 0.1);
  }

  .season-tab-btn.active {
    background: var(--navy-800);
    border-color: var(--gold-500);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 20px rgba(212, 175, 55, 0.25);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .tab-label {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .tab-badge {
    font-size: 0.72rem;
    color: var(--gold-400);
    font-weight: 600;
  }

  /* Promo Banner */
  .seasonal-promo-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.18) 0%, rgba(14, 34, 64, 0.85) 100%);
    border: 1px solid rgba(212, 175, 55, 0.45);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.8rem;
    margin-bottom: 2.8rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .promo-tag-col {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .promo-fire-icon {
    font-size: 2rem;
  }

  .promo-title {
    font-weight: 800;
    font-size: 1.05rem;
    color: #ffffff;
    display: block;
  }

  .promo-desc {
    font-size: 0.85rem;
    color: var(--ivory-muted);
    margin-top: 0.15rem;
  }

  .btn-sm {
    padding: 0.65rem 1.2rem;
    font-size: 0.88rem;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .seasonal-promo-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  /* Products Grid */
  .seasonal-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.8rem;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .product-card.hidden {
    display: none;
  }

  .product-media {
    position: relative;
    height: 190px;
    overflow: hidden;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.05);
  }

  .product-badge-overlay {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    background: rgba(5, 13, 26, 0.8);
    border: 1px solid var(--gold-500);
    color: var(--gold-300);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
  }

  .product-details {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .product-price {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--gold-400);
  }

  .prod-wave-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(0, 134, 229, 0.15);
    border: 1px solid rgba(0, 134, 229, 0.4);
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    transition: all 0.2s;
  }

  .prod-wave-trigger:hover {
    background: #0086e5;
    color: #ffffff;
  }

  .product-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .product-desc {
    font-size: 0.82rem;
    color: var(--ivory-muted);
    line-height: 1.45;
    margin-bottom: 1.2rem;
    flex: 1;
  }

  .product-buy-btn {
    width: 100%;
    padding: 0.65rem 1rem;
    font-size: 0.86rem;
  }
</style>

<script>
  function setupSeasonTabs() {
    const tabs = document.querySelectorAll('.season-tab-btn');
    const products = document.querySelectorAll('.product-card');
    const promoTitle = document.getElementById('banner-season-promo');
    const promoDesc = document.getElementById('banner-season-desc');

    const seasonDataMap: Record<string, { promo: string; desc: string }> = {
      'rentree': {
        promo: '🎒 Spécial Rentrée Scolaire & Bureautique',
        desc: 'Packs de fournitures de qualité, sacs à dos confortables et photos d\'identité express remises en 5 minutes !'
      },
      'noel': {
        promo: '🎄 Féerie des Fêtes & Coffrets Cadeaux',
        desc: 'Peluches géantes toutes douces, montres de collection et cadres photos personnalisés pour gâter vos proches.'
      },
      'mariages': {
        promo: '💍 Formules Spéciales Cérémonies & Mariages',
        desc: 'Reportages photo & vidéo complets, retouches professionnelles et album livre prestige offert avec nos forfaits.'
      },
      'hightech': {
        promo: '⚡ Gaming & Accessoires High-Tech Days',
        desc: 'Manettes officielles testées en boutique, câbles blindés et chargeurs ultra-rapides au meilleur tarif d\'Abidjan.'
      }
    };

    function filterSeason(seasonId: string) {
      tabs.forEach(t => {
        if (t.getAttribute('data-season-target') === seasonId) {
          t.classList.add('active');
        } else {
          t.classList.remove('active');
        }
      });

      products.forEach(p => {
        const pSeason = p.getAttribute('data-season');
        if (pSeason === seasonId) {
          p.classList.remove('hidden');
        } else {
          p.classList.add('hidden');
        }
      });

      if (seasonDataMap[seasonId]) {
        if (promoTitle) promoTitle.textContent = seasonDataMap[seasonId].promo;
        if (promoDesc) promoDesc.textContent = seasonDataMap[seasonId].desc;
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-season-target');
        if (target) filterSeason(target);
      });
    });

    // Initial filter on default active season
    filterSeason('rentree');
  }

  document.addEventListener('DOMContentLoaded', setupSeasonTabs);
</script>

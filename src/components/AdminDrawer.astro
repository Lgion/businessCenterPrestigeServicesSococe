---
import { defaultSiteData } from '../data/siteData';
const { business, announcement, seasonalShowcase, wavePayment } = defaultSiteData;
---

<dialog id="admin-drawer" class="admin-dialog" aria-labelledby="admin-title">
  <div class="admin-panel">
    <!-- Header -->
    <div class="admin-header">
      <div class="admin-title-box">
        <div class="admin-icon">⚙️</div>
        <div>
          <h3 id="admin-title" class="admin-main-title">Espace Administration & Paramétrage</h3>
          <p class="admin-subtitle">Personnalisez les informations de votre site en temps réel</p>
        </div>
      </div>
      <button type="button" id="close-admin-btn" class="admin-close-btn" aria-label="Fermer le panneau admin">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Admin Form Body -->
    <form id="admin-form" class="admin-body">
      <!-- Section 1: Business Info -->
      <div class="admin-section">
        <h4 class="section-badge">1. Identité & Coordonnées</h4>
        <div class="admin-form-group">
          <label for="cfg-business-name">Nom officiel du commerce</label>
          <input type="text" id="cfg-business-name" class="admin-input" value={business.name} />
        </div>

        <div class="admin-grid-2">
          <div class="admin-form-group">
            <label for="cfg-phone">Téléphone Appel direct</label>
            <input type="text" id="cfg-phone" class="admin-input" value={business.phoneFormatted} />
          </div>
          <div class="admin-form-group">
            <label for="cfg-whatsapp">Numéro WhatsApp</label>
            <input type="text" id="cfg-whatsapp" class="admin-input" value={business.whatsappFormatted} />
          </div>
        </div>

        <div class="admin-form-group">
          <label for="cfg-address">Adresse physique au Super U</label>
          <input type="text" id="cfg-address" class="admin-input" value={business.address} />
        </div>

        <div class="admin-form-group">
          <label for="cfg-hours">Horaires d'ouverture</label>
          <input type="text" id="cfg-hours" class="admin-input" value={business.openingHours} />
        </div>
      </div>

      <!-- Section 2: Announcement Bar -->
      <div class="admin-section">
        <h4 class="section-badge">2. Bannière d'Annonce Supérieure</h4>
        <div class="admin-grid-2">
          <div class="admin-form-group">
            <label for="cfg-announcement-badge">Badge de l'annonce</label>
            <input type="text" id="cfg-announcement-badge" class="admin-input" value={announcement.badge} />
          </div>
          <div class="admin-form-group">
            <label for="cfg-announcement-text">Texte de l'annonce</label>
            <input type="text" id="cfg-announcement-text" class="admin-input" value={announcement.text} />
          </div>
        </div>
      </div>

      <!-- Section 3: Seasonal Campaign -->
      <div class="admin-section">
        <h4 class="section-badge">3. Vitrine Saisonnière Active</h4>
        <div class="admin-form-group">
          <label for="cfg-season-select">Saison / Thème à mettre en avant</label>
          <select id="cfg-season-select" class="admin-select">
            {seasonalShowcase.seasons.map((s) => (
              <option value={s.id} selected={s.id === seasonalShowcase.activeSeasonId}>
                {s.name} ({s.tag})
              </option>
            ))}
          </select>
        </div>

        <div class="admin-form-group">
          <label for="cfg-season-title">Titre de la section événementielle</label>
          <input type="text" id="cfg-season-title" class="admin-input" value={seasonalShowcase.title} />
        </div>

        <div class="admin-form-group">
          <label for="cfg-season-desc">Sous-titre explicatif</label>
          <input type="text" id="cfg-season-desc" class="admin-input" value={seasonalShowcase.subtitle} />
        </div>
      </div>

      <!-- Section 4: Wave Payment -->
      <div class="admin-section">
        <h4 class="section-badge">4. Paramètres Wave Mobile</h4>
        <div class="admin-grid-2">
          <div class="admin-form-group">
            <label for="cfg-wave-number">Numéro Marchand Wave</label>
            <input type="text" id="cfg-wave-number" class="admin-input" value={wavePayment.merchantPhone} />
          </div>
          <div class="admin-form-group">
            <label for="cfg-wave-amount">Montant par défaut (FCFA)</label>
            <input type="number" id="cfg-wave-amount" class="admin-input" value={wavePayment.defaultAmount} />
          </div>
        </div>
      </div>

      <!-- Actions Toolbar -->
      <div class="admin-actions-bar">
        <button type="submit" class="btn btn-gold admin-save-btn">
          💾 Enregistrer & Appliquer en direct
        </button>

        <div class="admin-secondary-actions">
          <button type="button" id="admin-export-json-btn" class="btn btn-navy-outline btn-sm">
            📥 Exporter JSON
          </button>
          
          <label for="admin-import-file" class="btn btn-navy-outline btn-sm import-label">
            📤 Importer JSON
          </label>
          <input type="file" id="admin-import-file" accept=".json" style="display: none;" />

          <button type="button" id="admin-reset-btn" class="btn-reset">
            🔄 Réinitialiser par défaut
          </button>
        </div>
      </div>
    </form>
  </div>
</dialog>

<style>
  .admin-dialog {
    margin: auto;
    border: none;
    border-radius: 20px;
    padding: 0;
    background: transparent;
    max-width: 680px;
    width: 95%;
    max-height: 90vh;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(212, 175, 55, 0.25);
    overflow: hidden;
  }

  .admin-dialog::backdrop {
    background: rgba(4, 11, 22, 0.82);
    backdrop-filter: blur(10px);
  }

  .admin-panel {
    background: #0b1a30;
    color: #e2e8f0;
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 20px;
    overflow: hidden;
  }

  /* Header */
  .admin-header {
    background: linear-gradient(90deg, #061120 0%, #0d223f 100%);
    padding: 1.2rem 1.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
  }

  .admin-title-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .admin-icon {
    font-size: 1.6rem;
  }

  .admin-main-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    font-family: var(--font-serif);
  }

  .admin-subtitle {
    font-size: 0.78rem;
    color: var(--gold-400);
  }

  .admin-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .admin-close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
  }

  /* Body */
  .admin-body {
    padding: 1.6rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .admin-section {
    background: rgba(14, 32, 60, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .section-badge {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--gold-400);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }

  .admin-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .admin-grid-2 {
      grid-template-columns: 1fr;
    }
  }

  .admin-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .admin-form-group label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  .admin-input, .admin-select {
    background: rgba(6, 14, 26, 0.85);
    border: 1px solid rgba(212, 175, 55, 0.25);
    color: #ffffff;
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .admin-input:focus, .admin-select:focus {
    border-color: var(--gold-400);
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.2);
  }

  /* Actions Bar */
  .admin-actions-bar {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .admin-save-btn {
    width: 100%;
    padding: 0.85rem 1.4rem;
    font-size: 1rem;
  }

  .admin-secondary-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .import-label {
    cursor: pointer;
    margin: 0;
  }

  .btn-reset {
    background: none;
    border: none;
    color: #f87171;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.4rem;
  }

  .btn-reset:hover {
    text-decoration: underline;
  }
</style>

<script>
  function setupAdminDrawer() {
    const dialog = document.getElementById('admin-drawer') as HTMLDialogElement;
    const closeBtn = document.getElementById('close-admin-btn');
    const form = document.getElementById('admin-form') as HTMLFormElement;
    const resetBtn = document.getElementById('admin-reset-btn');
    const exportBtn = document.getElementById('admin-export-json-btn');
    const importInput = document.getElementById('admin-import-file') as HTMLInputElement;

    if (!dialog) return;

    // Open triggers
    document.querySelectorAll('.open-admin-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      });
    });

    // Close button
    closeBtn?.addEventListener('click', () => dialog.close());

    // Backdrop click close
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) dialog.close();
    });

    // Keyboard shortcut Ctrl + Shift + A
    window.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.shiftKey && (e.key === 'A' || e.key === 'a')) {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else dialog.showModal();
      }
    });

    // Load initial values from localStorage if available
    function populateForm() {
      const stored = localStorage.getItem('bcps_site_data');
      if (!stored) return;
      try {
        const data = JSON.parse(stored);
        if (data.name) (document.getElementById('cfg-business-name') as HTMLInputElement).value = data.name;
        if (data.phoneFormatted) (document.getElementById('cfg-phone') as HTMLInputElement).value = data.phoneFormatted;
        if (data.whatsappFormatted) (document.getElementById('cfg-whatsapp') as HTMLInputElement).value = data.whatsappFormatted;
        if (data.address) (document.getElementById('cfg-address') as HTMLInputElement).value = data.address;
        if (data.openingHours) (document.getElementById('cfg-hours') as HTMLInputElement).value = data.openingHours;
        if (data.announcementText) (document.getElementById('cfg-announcement-text') as HTMLInputElement).value = data.announcementText;
        if (data.seasonTitle) (document.getElementById('cfg-season-title') as HTMLInputElement).value = data.seasonTitle;
      } catch(e) {
        console.error(e);
      }
    }

    populateForm();

    // Form submit -> Save to localStorage and live update DOM
    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('cfg-business-name') as HTMLInputElement).value;
      const phoneFormatted = (document.getElementById('cfg-phone') as HTMLInputElement).value;
      const whatsappFormatted = (document.getElementById('cfg-whatsapp') as HTMLInputElement).value;
      const address = (document.getElementById('cfg-address') as HTMLInputElement).value;
      const openingHours = (document.getElementById('cfg-hours') as HTMLInputElement).value;
      const announcementText = (document.getElementById('cfg-announcement-text') as HTMLInputElement).value;
      const seasonTitle = (document.getElementById('cfg-season-title') as HTMLInputElement).value;
      const seasonSelect = (document.getElementById('cfg-season-select') as HTMLSelectElement).value;

      const updated = {
        name,
        phoneFormatted,
        whatsappFormatted,
        address,
        openingHours,
        announcementText,
        seasonTitle,
        seasonSelect
      };

      localStorage.setItem('bcps_site_data', JSON.stringify(updated));

      // Live update DOM
      document.querySelectorAll('[data-admin-bind]').forEach(el => {
        const bindKey = el.getAttribute('data-admin-bind');
        if (bindKey && (updated as any)[bindKey]) {
          el.textContent = (updated as any)[bindKey];
        }
      });

      // Update Season Tab if changed
      const seasonBtn = document.querySelector(`[data-season-target="${seasonSelect}"]`) as HTMLButtonElement;
      seasonBtn?.click();

      dialog.close();

      if ((window as any).showToast) {
        (window as any).showToast('Paramètres sauvegardés et appliqués en direct !', '✅');
      }
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      if (confirm('Voulez-vous réinitialiser toutes les données aux valeurs par défaut du magasin ?')) {
        localStorage.removeItem('bcps_site_data');
        location.reload();
      }
    });

    // Export JSON
    exportBtn?.addEventListener('click', () => {
      const stored = localStorage.getItem('bcps_site_data') || '{}';
      const blob = new Blob([stored], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'bcps-site-config.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Import JSON
    importInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const content = event.target?.result as string;
          JSON.parse(content); // validate JSON
          localStorage.setItem('bcps_site_data', content);
          location.reload();
        } catch(err) {
          alert('Fichier JSON invalide.');
        }
      };
      reader.readAsText(file);
    });
  }

  document.addEventListener('DOMContentLoaded', setupAdminDrawer);
</script>
